---
import { MarketingButton } from "../../../client/components/untitled/MarketingButton";
/**
 * Homepage Hero — light bg with subtle isometric 3D tiles.
 * Inspired by Aramco "Shoot for the Future" aesthetic.
 * Static Astro component (CSS-only animations, no JS shipped).
 */
---

<section class="hero-section relative bg-[#f5f5f3] text-gray-950">
  <!-- Scattered individual isometric tiles -->
  <div class="hero-tile hero-tile--1" aria-hidden="true">
    <div class="hero-tile__face"></div>
  </div>
  <div class="hero-tile hero-tile--2" aria-hidden="true">
    <div class="hero-tile__face hero-tile__face--accent"></div>
  </div>
  <div class="hero-tile hero-tile--3" aria-hidden="true">
    <div class="hero-tile__face"></div>
  </div>
  <div class="hero-tile hero-tile--4" aria-hidden="true">
    <div class="hero-tile__face hero-tile__face--accent"></div>
  </div>
  <div class="hero-tile hero-tile--5" aria-hidden="true">
    <div class="hero-tile__face"></div>
  </div>

  <!-- Content -->
  <div class="hero-content relative mx-auto max-w-[1440px] px-6 lg:px-12 pt-32 pb-32 md:pt-40 md:pb-40 lg:pt-48 lg:pb-48">
    <div class="max-w-5xl mx-auto text-center home-reveal home-reveal-1">
      <p
        class="marketing-eyebrow text-xs sm:text-sm font-medium tracking-[0.25em] text-gray-500 mb-6 uppercase font-body"
      >
        Web Design & Performance
      </p>

      <h1
        class="hero-heading font-heading font-bold leading-none mb-8 tracking-tight uppercase text-gray-950"
      >
        Always Be<br />Better.
      </h1>

      <p
        class="text-base md:text-lg text-gray-500 leading-relaxed mb-12 max-w-xl mx-auto font-body"
      >
        Websites that rank higher, load faster and turn visitors into customers.
        Whether we build it from scratch or fix what you've got.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <MarketingButton action="contact" />

        <MarketingButton action="speed" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* ── Heading — massive ──────────────────────────────────── */
  .hero-heading {
    font-size: clamp(2.5rem, 14vw, 11rem);
  }

  /* ── Individual scattered tiles ─────────────────────────── */
  .hero-tile {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    transform: rotateX(60deg) rotateZ(-45deg);
    transform-style: preserve-3d;
  }

  .hero-tile__face {
    border-radius: 10px;
    background: #eaeae8;
    position: relative;
    transform-style: preserve-3d;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.08);
    animation: tile-float 8s ease-in-out infinite both;
  }

  .hero-tile__face::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 50%);
  }

  .hero-tile__face--accent {
    background: rgba(6, 182, 212, 0.45);
    animation-name: tile-float-accent;
  }

  /* ── Tile 1 — top-right, large ─────────────────────────── */
  .hero-tile--1 {
    top: 8%;
    right: 6%;
  }
  .hero-tile--1 .hero-tile__face {
    width: 200px;
    height: 200px;
    animation-delay: 0s;
  }

  /* ── Tile 2 — bottom-left, medium, accent ──────────────── */
  .hero-tile--2 {
    bottom: 12%;
    left: 4%;
  }
  .hero-tile--2 .hero-tile__face {
    width: 180px;
    height: 180px;
    animation-delay: -2s;
  }

  /* ── Tile 3 — top-left, small ──────────────────────────── */
  .hero-tile--3 {
    top: 18%;
    left: 10%;
  }
  .hero-tile--3 .hero-tile__face {
    width: 120px;
    height: 120px;
    animation-delay: -4s;
  }

  /* ── Tile 4 — bottom-right, small, accent ──────────────── */
  .hero-tile--4 {
    bottom: 18%;
    right: 12%;
  }
  .hero-tile--4 .hero-tile__face {
    width: 140px;
    height: 140px;
    animation-delay: -3s;
  }

  /* ── Tile 5 — center-left, medium ──────────────────────── */
  .hero-tile--5 {
    top: 55%;
    left: 2%;
  }
  .hero-tile--5 .hero-tile__face {
    width: 160px;
    height: 160px;
    animation-delay: -5s;
  }

  /* ── Float animations ──────────────────────────────────── */
  @keyframes tile-float {
    0%, 100% {
      transform: translateZ(0);
    }
    50% {
      transform: translateZ(16px);
    }
  }

  @keyframes tile-float-accent {
    0%, 100% {
      transform: translateZ(6px);
    }
    50% {
      transform: translateZ(28px);
    }
  }

  /* ── Content z-index ────────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 2;
  }

  /* ── Reduced motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-tile__face {
      animation: none;
    }
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-tile--1 .hero-tile__face { width: 150px; height: 150px; }
    .hero-tile--2 .hero-tile__face { width: 130px; height: 130px; }
    .hero-tile--3 .hero-tile__face { width: 90px; height: 90px; }
    .hero-tile--4 .hero-tile__face { width: 100px; height: 100px; }
    .hero-tile--5 .hero-tile__face { width: 120px; height: 120px; }
  }

  @media (max-width: 640px) {
    .hero-tile--1,
    .hero-tile--2,
    .hero-tile--3,
    .hero-tile--4,
    .hero-tile--5 {
      display: none;
    }

    .hero-tile--1 .hero-tile__face { width: 110px; height: 110px; }
    .hero-tile--2 .hero-tile__face { width: 100px; height: 100px; }
    .hero-tile--4 .hero-tile__face { width: 80px; height: 80px; }
  }
</style>
