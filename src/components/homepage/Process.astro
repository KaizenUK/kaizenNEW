---
import { Button } from "../../../client/components/untitled/base/buttons/button";
const steps = [
  { title: "Start with a free chat.", body: "Tell us what your site gets wrong and what you need it to do." },
  { title: "Agree the work and price.", body: "We put the plan in writing. Work starts after you pay a non-refundable deposit." },
  { title: "Look through your new pages.", body: "You see the site before it goes live. We work through your feedback with you." },
  { title: "Launch and keep it up to date.", body: "We show you how to edit your pages and blog. You can also ask us to make changes." },
];
---

<section class="marketing-section bg-slate-50" aria-labelledby="home-process-heading">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="mb-8 max-w-3xl md:mb-12">
      <p class="marketing-eyebrow mb-5">From the first conversation</p>
      <h2 id="home-process-heading" class="text-balance font-heading text-4xl font-bold text-slate-950 md:text-5xl lg:text-6xl">Know the next step at every stage.</h2>
    </div>
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class="border-t border-slate-300 pt-6">
          <span aria-hidden="true" class="mb-5 flex size-11 items-center justify-center rounded-full border border-uui-brand-200 bg-white font-body text-sm font-semibold text-uui-brand-800">0{index + 1}</span>
          <h3 class="font-heading text-2xl font-bold text-slate-950">{step.title}</h3>
          <p class="mt-3 font-body text-base leading-relaxed text-slate-600">{step.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-8"><Button href="/about/" color="link-color">More about working with Kaizen</Button></div>
  </div>
</section>
