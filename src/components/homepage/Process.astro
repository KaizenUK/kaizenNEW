---
/**
 * How We Work — dark section with a touch of colour.
 * Framed as "we" not "it". Confident, concrete, no fluff.
 * SUCCESS: Simple (3 beats), Concrete (show don't tell),
 * Emotional (removes anxiety), Credible (testable claim at end).
 */
const steps = [
  {
    label: "Listen",
    heading: "We start by shutting up and listening.",
    body: "No pitch deck. No assumptions. We dig into your business, your customers, and what's actually going wrong. You talk, we take notes.",
  },
  {
    label: "Build",
    heading: "We fix what matters first.",
    body: "No six-month roadmaps. We find the things costing you the most customers and fix those first — so you see results while we're still working.",
  },
  {
    label: "Improve",
    heading: "We never call it finished.",
    body: "Kaizen means continuous improvement. We measure, learn, and iterate. Your site gets better every month — not just on launch day.",
  },
];
---

<section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
  <!-- Subtle accent glow -->
  <div
    class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="mb-20 md:mb-28 max-w-2xl">
      <p
        class="text-xs font-medium tracking-[0.25em] text-kaizen-cyan uppercase mb-5 font-body"
      >
        How We Work
      </p>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight"
      >
        No jargon.<br />No surprises.
      </h2>
    </div>

    <!-- Steps -->
    <div class="space-y-0">
      {
        steps.map((step, i) => (
          <div
            class:list={[
              "grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
              i < steps.length - 1 && "border-b border-white/10",
            ]}
          >
            {/* Label */}
            <div class="md:col-span-3 flex items-baseline gap-4">
              <span class="text-sm font-body text-kaizen-cyan tracking-wide">
                0{i + 1}
              </span>
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                {step.label}
              </h3>
            </div>

            {/* Content */}
            <div class="md:col-span-9">
              <p class="text-xl md:text-2xl font-body font-medium text-white leading-snug mb-4">
                {step.heading}
              </p>
              <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                {step.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
