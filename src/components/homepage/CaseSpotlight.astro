---
import { CaseStudyCard, MetricsBlock } from "../../../client/components/untitled/proof";
---

<section class="marketing-section bg-[#f5f5f3]" aria-labelledby="featured-work-heading">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="mb-8 md:mb-12">
      <p class="marketing-eyebrow mb-5">Featured work</p>
      <h2
        id="featured-work-heading"
        class="max-w-3xl text-balance font-heading text-4xl font-bold leading-tight text-gray-950 md:text-5xl lg:text-6xl"
      >
        A slow site now brings in enquiries.
      </h2>
    </div>
    <CaseStudyCard layout="wide" />
    <MetricsBlock className="mt-8 md:mt-12" showSourceLink={false} />
  </div>
</section>
