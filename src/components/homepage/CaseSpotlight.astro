---
/**
 * Featured Project — Midland Oil Group.
 * Ties directly into the "8 seconds" story above it.
 * Shows the real-world transformation: their old site WAS the slow one.
 * SUCCESS: Stories (real client), Concrete (specific outcomes), Credible (measurable).
 */
const problems = [
  "8+ second load times — the exact problem you just watched",
  "Built on bloated WordPress with 30+ plugins",
  "Customers had to already know the product to find it",
  "Every enquiry required a phone call — no self-service",
];

const outcomes = [
  { metric: "1.2s", label: "load time — down from 8+" },
  { metric: "0", label: "plugins — custom-built from scratch" },
  { metric: "AI", label: "oil finder — customers self-serve in seconds" },
  { metric: "3x", label: "more enquiries in the first month" },
];
---

<section class="py-28 md:py-36 bg-[#f5f5f3]">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <!-- Header -->
    <div class="mb-12 md:mb-16">
      <p
        class="text-xs font-medium tracking-[0.25em] text-gray-400 uppercase mb-5 font-body"
      >
        Featured project
      </p>
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div class="max-w-2xl">
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight"
          >
            Midland Oil Group
          </h2>
          <p class="mt-6 text-lg md:text-xl text-gray-500 font-body leading-relaxed">
            Their old site was exactly what you just watched. 8-second loads, visitors leaving before the page finished rendering. Here's what we did about it.
          </p>
        </div>
        <a
          href="/case-studies/midland-oil-group/"
          class="inline-flex items-center gap-3 font-heading font-bold text-lg text-gray-950 transition-all duration-200 hover:gap-5 shrink-0"
        >
          Full case study
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform duration-200"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Screenshot -->
    <div class="mb-16 md:mb-20 spotlight-img-wrap">
      <img
        src="/images/case-studies/midland-oil-group-hero.webp"
        alt="Midland Oil Group homepage — custom-built platform featuring sector-first navigation and AI-powered oil finder for UK lubricant specialists"
        width="2196"
        height="1147"
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl"
      />
    </div>

    <!-- Two-column: Problems → Outcomes -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- The problem -->
      <div>
        <p class="text-[11px] font-body font-semibold uppercase tracking-[0.2em] text-gray-300 mb-8">
          What they had
        </p>
        <ul class="space-y-6">
          {problems.map((item, i) => (
            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gray-200 text-[11px] font-bold font-body text-gray-500">
                {i + 1}
              </span>
              <span class:list={[
                "text-base md:text-lg font-body leading-relaxed",
                i === 0 ? "text-gray-950 font-medium" : "text-gray-400",
              ]}>
                {item}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- The outcomes -->
      <div>
        <p class="text-[11px] font-body font-semibold uppercase tracking-[0.2em] text-gray-950 mb-8">
          What we delivered
        </p>
        <div class="space-y-8">
          {outcomes.map((item) => (
            <div class="flex items-baseline gap-4">
              <span class="text-3xl md:text-4xl font-heading font-bold text-gray-950 shrink-0 min-w-[4ch]">
                {item.metric}
              </span>
              <span class="text-base md:text-lg font-body text-gray-500 leading-relaxed">
                {item.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .spotlight-img-wrap {
    position: relative;
  }

  .spotlight-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    pointer-events: none;
  }
</style>
