---
import { MarketingButton } from "../../../client/components/untitled/MarketingButton";
/**
 * Featured Project — Midland Oil Group.
 * Ties directly into the "8 seconds" story above it.
 * Shows the real-world transformation: their old site WAS the slow one.
 * SUCCESS: Stories (real client), Concrete (specific outcomes), Credible (measurable).
 */
const problems = [
  "Pages took more than 8 seconds to load",
  "A heavy WordPress site with more than 30 plugins",
  "Customers had to already know the product to find it",
  "Every question meant a phone call",
];

const outcomes = [
  { metric: "1.2s", label: "to load a page, down from more than 8" },
  { metric: "0", label: "plugins. Built from scratch" },
  { metric: "AI", label: "oil finder. Customers find the right oil themselves" },
  { metric: "3x", label: "more enquiries in the first month" },
];
---

<section class="py-28 md:py-36 bg-[#f5f5f3]">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <!-- Header -->
    <div class="mb-12 md:mb-16">
      <p
        class="marketing-eyebrow text-xs font-medium tracking-[0.25em] text-gray-400 uppercase mb-5 font-body"
      >
        Featured project
      </p>
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div class="max-w-2xl">
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight"
          >
            Midland Oil Group
          </h2>
          <p class="mt-6 text-lg md:text-xl text-gray-500 font-body leading-relaxed">
            Their old site was the slow one you just watched. Here is what we changed, and what happened next.
          </p>
        </div>
        <MarketingButton action="caseStudy" href="/case-studies/midland-oil-group/" variant="link" className="shrink-0" />
      </div>
    </div>

    <!-- Screenshot -->
    <div class="mb-16 md:mb-20 spotlight-img-wrap">
      <img
        src="/images/case-studies/midland-oil-group-hero.webp"
        alt="Midland Oil Group homepage after the rebuild, with products sorted by industry and an AI oil finder"
        width="2196"
        height="1147"
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl"
      />
    </div>

    <!-- Two-column: Problems → Outcomes -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- The problem -->
      <div>
        <p class="marketing-eyebrow text-xs font-body font-semibold uppercase tracking-[0.2em] text-gray-300 mb-8">
          What they had
        </p>
        <ul class="space-y-6">
          {problems.map((item, i) => (
            <li class="flex items-start gap-4">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gray-200 text-[11px] font-bold font-body text-gray-500">
                {i + 1}
              </span>
              <span class:list={[
                "text-base md:text-lg font-body leading-relaxed",
                i === 0 ? "text-gray-950 font-medium" : "text-gray-400",
              ]}>
                {item}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- The outcomes -->
      <div>
        <p class="marketing-eyebrow text-xs font-body font-semibold uppercase tracking-[0.2em] text-gray-950 mb-8">
          What we delivered
        </p>
        <div class="space-y-8">
          {outcomes.map((item) => (
            <div class="flex items-baseline gap-4">
              <span class="text-3xl md:text-4xl font-heading font-bold text-gray-950 shrink-0 min-w-[4ch]">
                {item.metric}
              </span>
              <span class="text-base md:text-lg font-body text-gray-500 leading-relaxed">
                {item.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .spotlight-img-wrap {
    position: relative;
  }

  .spotlight-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    pointer-events: none;
  }
</style>
