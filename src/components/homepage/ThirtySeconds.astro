---
import { Button } from "../../../client/components/untitled/base/buttons/button";
import { MarketingButton } from "../../../client/components/untitled/MarketingButton";
---

<section class="marketing-section bg-slate-950 text-white" id="thirty-seconds" aria-labelledby="home-speed-heading" data-speed-comparison>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="mb-8 max-w-3xl md:mb-12">
      <p class="marketing-eyebrow marketing-eyebrow--dark mb-5">Midland Oil, before and after</p>
      <h2 id="home-speed-heading" class="text-balance font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">See how much sooner the page is ready.</h2>
      <p class="mt-6 font-body text-lg leading-relaxed text-slate-300">The old site took more than 8 seconds to load. The new one takes 1.2 seconds.</p>
      <p id="speed-explanation" class="mt-3 font-body text-sm leading-6 text-slate-300">Screenshots replay the recorded wait. This is not a live speed test.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 md:gap-6">
      <figure class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-white/20 bg-white">
          <div class="flex flex-col items-start gap-1 border-b border-slate-200 px-3 py-3 font-body text-xs sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:px-4 sm:text-sm">
            <span class="font-semibold text-slate-900">Before</span>
            <span class="text-slate-600">More than 8 seconds</span>
          </div>
          <div class="relative aspect-[2550/1312]">
            <img src="/images/case-studies/midland-oil-group/mog-old-homepage.webp" alt="Midland Oil's old homepage before the rebuild" width="2544" height="1313" loading="lazy" decoding="async" class="block h-full w-full object-cover object-top" />
            <div hidden data-loading="before" class="loading-cover absolute inset-0 place-content-center bg-slate-100 p-2 text-center font-body text-xs leading-4 text-slate-800 sm:p-5 sm:text-base sm:leading-6">
              <div aria-hidden="true" class="loading-dot mx-auto mb-1 size-2 rounded-full bg-slate-400 sm:mb-4 sm:size-3"></div>
              <p>Waiting for the old page.</p>
            </div>
          </div>
        </div>
        <figcaption class="mt-4 font-body text-xs leading-6 text-slate-300 sm:text-sm">The old homepage before our work.</figcaption>
      </figure>
      <figure class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-uui-brand-300 bg-white">
          <div class="flex flex-col items-start gap-1 border-b border-slate-200 px-3 py-3 font-body text-xs sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:px-4 sm:text-sm">
            <span class="font-semibold text-slate-900">After the rebuild</span>
            <span class="text-uui-brand-800">1.2 seconds</span>
          </div>
          <div class="relative aspect-[2550/1312]">
            <img src="/images/case-studies/midland-oil-group/mog-new-homepage.webp" alt="Midland Oil's rebuilt homepage with clear product choices" width="2550" height="1312" loading="lazy" decoding="async" class="block h-full w-full object-cover object-top" />
            <div hidden data-loading="after" class="loading-cover absolute inset-0 place-content-center bg-slate-100 p-2 text-center font-body text-xs leading-4 text-slate-800 sm:p-5 sm:text-base sm:leading-6">
              <div aria-hidden="true" class="loading-dot mx-auto mb-1 size-2 rounded-full bg-uui-brand-600 sm:mb-4 sm:size-3"></div>
              <p>Waiting for the new page.</p>
            </div>
          </div>
        </div>
        <figcaption class="mt-4 font-body text-xs leading-6 text-slate-300 sm:text-sm">A clearer way to find the right oil.</figcaption>
      </figure>
    </div>
    <div data-comparison-controls hidden class="mt-6">
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap">
        <Button id="speed-play" color="secondary" size="lg" aria-describedby="speed-explanation">Play the loading comparison</Button>
        <Button id="speed-show" color="link-color" size="lg" className="text-uui-brand-200 hover:text-white">Show both pages</Button>
      </div>
      <p data-comparison-status role="status" class="mt-3 min-h-12 font-body text-sm leading-6 text-slate-300">Both pages are shown.</p>
    </div>
    <div class="mt-6 flex flex-col gap-5 border-t border-white/15 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl font-body text-lg leading-relaxed text-white">Since the rebuild, Midland gets several genuine enquiries a day.</p>
      <MarketingButton action="caseStudy" variant="link" onDark />
    </div>
  </div>
</section>

<style>
  [data-speed-comparison] [hidden] { display: none !important; }
  .loading-cover { display: grid; }
  .loading-dot { animation: loading-pulse 1s ease-in-out infinite alternate; }
  @keyframes loading-pulse { to { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) {
    .loading-dot { animation: none; }
  }
</style>

<script>
  function setupComparison() {
    const root = document.querySelector<HTMLElement>("[data-speed-comparison]");
    const controls = root?.querySelector<HTMLElement>("[data-comparison-controls]");
    const status = root?.querySelector<HTMLElement>("[data-comparison-status]");
    const before = root?.querySelector<HTMLElement>('[data-loading="before"]');
    const after = root?.querySelector<HTMLElement>('[data-loading="after"]');
    const play = root?.querySelector<HTMLButtonElement>("#speed-play");
    const show = root?.querySelector<HTMLButtonElement>("#speed-show");
    if (!root || !controls || !status || !before || !after || !play || !show) return;

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let timers: ReturnType<typeof setTimeout>[] = [];
    let generation = 0;
    controls.hidden = false;

    function clearTimers() {
      generation++;
      timers.forEach(clearTimeout);
      timers = [];
    }

    function showBoth() {
      clearTimers();
      before!.hidden = true;
      after!.hidden = true;
      play!.disabled = false;
      root!.dataset.state = "shown";
      status!.textContent = "Both pages are shown.";
    }

    show.addEventListener("click", showBoth);
    play.addEventListener("click", async () => {
      clearTimers();
      const current = generation;
      if (motion.matches) {
        showBoth();
        status.textContent = "Both pages are shown. The new page took 1.2 seconds; the old one took more than 8.";
        return;
      }
      play.disabled = true;
      status.textContent = "Preparing the screenshots.";
      try {
        await Promise.all([...root.querySelectorAll<HTMLImageElement>("img")].map(async (image) => {
          image.loading = "eager";
          await image.decode();
        }));
      } catch {
        if (generation === current) {
          showBoth();
          status.textContent = "The screenshots could not load. You can still read the case study.";
        }
        return;
      }
      if (generation !== current) return;
      play.disabled = false;
      before.hidden = false;
      after.hidden = false;
      root.dataset.state = "playing";
      status.textContent = "Loading both pages.";
      timers.push(setTimeout(() => {
        after.hidden = true;
        status.textContent = "The new page is ready. The old page is still loading.";
      }, 1200));
      timers.push(setTimeout(() => {
        root.dataset.state = "finished";
        status.textContent = "The old page is still loading after 8 seconds.";
      }, 8000));
    });
    motion.addEventListener("change", showBoth);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) showBoth();
    });
  }
  setupComparison();
</script>
