---
/**
 * Three core services — card grid, Sumsub-style.
 * Static Astro component.
 */
const services = [
  {
    eyebrow: "Web Design",
    title: "Beautiful sites that actually convert",
    description:
      "We design and build clean, modern websites that load fast, rank well on Google, and turn visitors into customers. No bloat, no fluff — just results.",
    points: [
      "Custom design tailored to your brand",
      "Blazing-fast load times out of the box",
      "Built to meet Google's quality standards",
    ],
    href: "/contact",
    cta: "Start a project",
    accent: "cyan",
  },
  {
    eyebrow: "Performance Auditing",
    title: "Find out what's holding your site back",
    description:
      "A full health check of your website — speed, Google scores, accessibility, and the invisible problems costing you customers. Clear report, plain English.",
    points: [
      "Page speed and load time analysis",
      "Google ranking factor review",
      "Prioritised fix list you can act on",
    ],
    href: "/performance-scanner",
    cta: "Run a free audit",
    accent: "lime",
  },
  {
    eyebrow: "Product Owner for Hire",
    title: "Expert project leadership, on demand",
    description:
      "Your web project needs someone who knows what good looks like. We step in as your product owner — managing priorities, talking to developers, and making sure things ship on time.",
    points: [
      "Hands-on guidance from day one",
      "No long-term contracts required",
      "Experienced with teams of all sizes",
    ],
    href: "/contract-product-owner",
    cta: "Learn more",
    accent: "cyan",
  },
];
---

<section class="py-20 md:py-28 bg-white relative">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="text-center mb-16">
      <p
        class="text-sm font-medium tracking-wide text-kaizen-cyan uppercase mb-4"
      >
        What We Do
      </p>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-gray-950"
      >
        Three ways we help
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        services.map((s) => (
          <div class="group relative rounded-2xl border border-gray-200 bg-white p-8 md:p-10 flex flex-col transition-all duration-300 hover:border-gray-300 hover:shadow-xl">
            <p
              class:list={[
                "text-xs font-semibold tracking-wide uppercase mb-3",
                s.accent === "lime"
                  ? "text-kaizen-lime"
                  : "text-kaizen-cyan",
              ]}
            >
              {s.eyebrow}
            </p>

            <h3 class="text-xl md:text-2xl font-heading font-bold text-gray-950 mb-4 leading-snug">
              {s.title}
            </h3>

            <p class="text-gray-600 leading-relaxed mb-6">{s.description}</p>

            <ul class="space-y-3 text-gray-700 mb-8">
              {s.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={[
                      "mt-1.5 h-2 w-2 rounded-full flex-shrink-0",
                      s.accent === "lime"
                        ? "bg-kaizen-lime"
                        : "bg-kaizen-cyan",
                    ]}
                  />
                  {point}
                </li>
              ))}
            </ul>

            <div class="mt-auto">
              <a
                href={s.href}
                class:list={[
                  "inline-flex items-center gap-2 font-heading font-semibold transition-colors",
                  s.accent === "lime"
                    ? "text-kaizen-lime hover:text-green-600"
                    : "text-kaizen-cyan hover:text-cyan-700",
                ]}
              >
                {s.cta}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
