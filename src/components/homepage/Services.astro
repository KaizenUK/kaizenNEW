---
/**
 * Services section — spacious, bright, easy to scan.
 * Each service gets one core memorable idea (SUCCESS principle #1).
 */
const services = [
  {
    number: "01",
    title: "Web Design",
    hook: "You have 3 seconds before a visitor decides to stay or leave.",
    description:
      "We design and build sites that pass that test. Fast, clean, and built around one goal — turning visitors into customers.",
    cta: "Start a project",
    href: "/contact",
  },
  {
    number: "02",
    title: "Performance",
    hook: "Every extra second your site takes to load costs you 7% of conversions.",
    description:
      "We find exactly what's slowing you down and fix it. You get a plain-English report, a prioritised action plan, and measurable results.",
    cta: "Run a free audit",
    href: "/performance-scanner",
  },
  {
    number: "03",
    title: "Product Owner for Hire",
    hook: "Most web projects don't fail because of bad code. They fail because nobody's in charge.",
    description:
      "We step in as your product owner — managing priorities, translating between you and your developers, and making sure things actually ship.",
    cta: "Learn more",
    href: "/contract-product-owner",
  },
];
---

<section class="py-28 md:py-36 bg-white">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <!-- Section header -->
    <div class="mb-20 md:mb-28 max-w-2xl">
      <p
        class="text-xs font-medium tracking-[0.25em] text-gray-400 uppercase mb-5 font-body"
      >
        What We Do
      </p>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight"
      >
        What we actually do
      </h2>
    </div>

    <!-- Service rows -->
    <div class="space-y-0">
      {
        services.map((s, i) => (
          <div
            class:list={[
              "group grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
              i < services.length - 1 && "border-b border-gray-200",
            ]}
          >
            {/* Number + title */}
            <div class="md:col-span-4 flex flex-col">
              <span class="text-sm font-body text-gray-300 mb-4 block">
                {s.number}
              </span>
              <h3 class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight">
                {s.title}
              </h3>
            </div>

            {/* Hook + description */}
            <div class="md:col-span-5 flex flex-col justify-center">
              <p class="text-xl md:text-2xl font-body font-medium text-gray-950 leading-snug mb-4">
                {s.hook}
              </p>
              <p class="text-base md:text-lg font-body text-gray-500 leading-relaxed">
                {s.description}
              </p>
            </div>

            {/* CTA */}
            <div class="md:col-span-3 flex items-center md:justify-end">
              <a
                href={s.href}
                class="inline-flex items-center gap-3 font-heading font-bold text-lg text-gray-950 transition-all duration-200 group-hover:gap-5"
              >
                {s.cta}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-1"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
