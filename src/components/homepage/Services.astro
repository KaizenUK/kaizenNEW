---
import { Button } from "../../../client/components/untitled/base/buttons/button";
/**
 * Services section — spacious, bright, easy to scan.
 * Each service gets one core memorable idea (SUCCESS principle #1).
 */
const services = [
  {
    number: "01",
    title: "Web Design",
    hook: "People judge your business by your website before they ever call you.",
    description:
      "We design and build sites that load fast, look right on a phone and make it easy to get in touch.",
    cta: "Talk to us about your site",
    href: "/contact",
  },
  {
    number: "02",
    title: "Performance",
    hook: "A slow site loses people before they see what you do.",
    description:
      "We find what is slowing your site down and fix it. You get a plain-English report and a list of fixes, most important first.",
    cta: "Check your website speed",
    href: "/performance-scanner",
  },
  {
    number: "03",
    title: "Product Owner for Hire",
    hook: "Most web projects don't fail because of bad code. They fail because nobody's in charge.",
    description:
      "We step in as your product owner. We set the priorities, talk to your developers for you and make sure the work gets finished.",
    cta: "How product ownership works",
    href: "/contract-product-owner",
  },
];
---

<section class="py-28 md:py-36 bg-white">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <!-- Section header -->
    <div class="mb-20 md:mb-28 max-w-2xl">
      <p
        class="marketing-eyebrow text-xs font-medium tracking-[0.25em] text-gray-400 uppercase mb-5 font-body"
      >
        What We Do
      </p>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight"
      >
        What we actually do
      </h2>
    </div>

    <!-- Service rows -->
    <div class="space-y-0">
      {
        services.map((s, i) => (
          <div
            class:list={[
              "group grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
              i < services.length - 1 && "border-b border-gray-200",
            ]}
          >
            {/* Number + title */}
            <div class="md:col-span-4 flex flex-col">
              <span class="text-sm font-body text-gray-300 mb-4 block">
                {s.number}
              </span>
              <h3 class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight">
                {s.title}
              </h3>
            </div>

            {/* Hook + description */}
            <div class="md:col-span-5 flex flex-col justify-center">
              <p class="text-xl md:text-2xl font-body font-medium text-gray-950 leading-snug mb-4">
                {s.hook}
              </p>
              <p class="text-base md:text-lg font-body text-gray-500 leading-relaxed">
                {s.description}
              </p>
            </div>

            {/* CTA */}
            <div class="md:col-span-3 flex items-center md:justify-end">
              <Button href={s.href} color="link-color" size="lg" className="text-left whitespace-normal">{s.cta}</Button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
