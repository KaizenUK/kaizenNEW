---
/**
 * Why Us section — replaces old CredibilitySection.
 * Positions as solutions provider, less local-SEO focused.
 * Static Astro component.
 */
const reasons = [
  {
    title: "Senior-level from the start",
    description:
      "Your project is handled by experienced professionals, not handed off to juniors. One dedicated lead owns your build from start to finish.",
  },
  {
    title: "We fix, not just build",
    description:
      "Most agencies want to start from scratch. We specialise in making your existing site faster, cleaner, and better at bringing in business.",
  },
  {
    title: "Plain English, always",
    description:
      "No jargon, no technical waffle. You'll understand every recommendation we make and why it matters for your bottom line.",
  },
  {
    title: "Performance is the product",
    description:
      "Speed isn't an afterthought — it's baked into everything we do. Your site will pass Google's quality checks, not just look pretty.",
  },
  {
    title: "Transparent pricing",
    description:
      "You'll know what it costs before we start. No surprise invoices, no scope creep, no hidden extras. What we quote is what you pay.",
  },
  {
    title: "No lock-in contracts",
    description:
      "We earn your business every month. Support and maintenance are month-to-month — stay because you want to, not because you have to.",
  },
];
---

<section class="py-20 md:py-28 bg-gray-950 text-white relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_10%_0,rgba(56,189,248,0.15),transparent_50%),radial-gradient(circle_at_100%_90%,rgba(34,197,94,0.10),transparent_55%)]"
  >
  </div>

  <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
    <div class="max-w-2xl mb-16">
      <p
        class="text-sm font-medium tracking-wide text-kaizen-cyan uppercase mb-4"
      >
        Why Kaizen
      </p>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight"
      >
        Built different. On purpose.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        reasons.map((reason) => (
          <div class="rounded-2xl bg-white/5 border border-white/10 p-8 transition-all duration-300 hover:bg-white/[0.08] hover:border-white/20">
            <h3 class="text-lg font-heading font-bold text-white mb-3">
              {reason.title}
            </h3>
            <p class="text-white/65 leading-relaxed">{reason.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
