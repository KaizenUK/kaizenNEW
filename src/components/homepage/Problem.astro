---
import { MarketingButton } from "../../../client/components/untitled/MarketingButton";
/**
 * The Problem section — story-driven with scroll spotlight.
 * Uses scroll position to highlight the line closest to a
 * trigger point (40% from top of viewport).
 */
---

<section class="marketing-section marketing-section--joined bg-white" id="problem-section">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="max-w-3xl mx-auto">
      <p
        class="marketing-eyebrow text-xs font-medium tracking-[0.25em] text-gray-400 uppercase mb-8 md:mb-12 font-body"
      >
        Sound familiar?
      </p>

      <div class="story-stack">
        <p class="story-line story-line--active" data-story="0">
          Someone searches for exactly what you sell.
        </p>

        <p class="story-line" data-story="1">
          Your site shows up. They click through.
        </p>

        <p class="story-line" data-story="2">
          The page takes a few seconds to load. Something looks off on their phone. The text is hard to read.
        </p>

        <p class="story-line" data-story="3">
          They tap the back button — and pick your competitor instead.
        </p>

        <p class="story-line story-line--closing" data-story="4">
          This happens hundreds of times a month. Not because your business isn't good enough — because your website isn't pulling its weight.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 pt-8 md:pt-12">
        <MarketingButton action="speed" />
        <span class="text-sm font-body text-gray-400">Free test. Your score comes first.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .story-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .story-stack {
      gap: 3rem;
    }
  }

  .story-line {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.3;
    color: rgb(220 220 220);
    transition: color 0.4s ease;
  }

  .story-line--active {
    color: rgb(3 7 18);
  }

  /* Closing line has a softer peak */
  .story-line--closing {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.6;
    max-width: 40rem;
  }

  .story-line--closing.story-line--active {
    color: rgb(120 120 120);
  }
</style>

<script>
  const section = document.getElementById('problem-section');
  const lines = document.querySelectorAll<HTMLElement>('.story-line');

  if (!section || !lines.length) throw new Error('Problem section not found');

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion) {
    lines.forEach((l) => l.classList.add('story-line--active'));
  } else {
    let ticking = false;

    function updateSpotlight() {
      // Trigger point: 40% down from the top of the viewport
      const trigger = window.innerHeight * 0.4;
      let bestIdx = 0;
      let bestDist = Infinity;

      lines.forEach((line, i) => {
        const rect = line.getBoundingClientRect();
        const lineCenter = rect.top + rect.height / 2;
        const dist = Math.abs(lineCenter - trigger);

        if (dist < bestDist) {
          bestDist = dist;
          bestIdx = i;
        }
      });

      lines.forEach((l, i) => {
        l.classList.toggle('story-line--active', i === bestIdx);
      });

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateSpotlight);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load
    updateSpotlight();
  }
</script>
