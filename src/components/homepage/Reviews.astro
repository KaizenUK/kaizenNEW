---
import { Testimonials } from "../../../client/components/untitled/proof";
import { buildOrganizationSchema } from "../../../client/lib/seo";

// Organisation markup only. Google's rules do not allow a business to mark up
// reviews of itself for star ratings, so the reviews stay out of the schema.
const schemaJson = JSON.stringify(
  buildOrganizationSchema(
    "Kaizen is a UK web consultancy focused on high-performance websites, technical SEO foundations, WordPress rebuilds, and hands-on product leadership.",
  ),
);
---

<section class="marketing-section bg-white" aria-labelledby="customer-reviews-heading">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
    <div class="mb-8 md:mb-12">
      <p class="marketing-eyebrow mb-5">Customer reviews</p>
      <h2
        id="customer-reviews-heading"
        class="max-w-3xl text-balance font-heading text-4xl font-bold leading-tight text-gray-950 md:text-5xl lg:text-6xl"
      >
        Clients share what changed for them.
      </h2>
    </div>
    <Testimonials />
  </div>
  <script type="application/ld+json" set:html={schemaJson} />
</section>
