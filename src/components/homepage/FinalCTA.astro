---
/**
 * Final CTA block — full-width conversion section before footer.
 * Sumsub-style: bold, simple, one action.
 * Static Astro component.
 */
---

<section class="py-20 md:py-28 bg-[#020617] text-white relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(6,182,212,0.10),transparent_60%)]"
  >
  </div>

  <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6 leading-tight"
      >
        Ready to make your website work harder?
      </h2>

      <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-10 max-w-2xl mx-auto">
        Whether you need a new site, a performance overhaul, or someone to
        manage your project properly — we're here to help.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="px-8 py-4 rounded-lg bg-white text-gray-950 font-heading font-bold text-lg inline-flex items-center justify-center gap-2 transition-all duration-200 hover:scale-[1.03] hover:shadow-[0_0_24px_rgba(255,255,255,0.4)] active:scale-[0.97]"
        >
          Get in touch
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="/performance-scanner"
          class="px-8 py-4 rounded-lg border-2 border-white/25 text-white font-heading font-bold text-lg inline-flex items-center justify-center gap-2 transition-all duration-200 hover:scale-[1.03] hover:border-kaizen-cyan hover:text-kaizen-cyan active:scale-[0.97]"
        >
          Try the free audit first
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
