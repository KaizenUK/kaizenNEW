---
import { MarketingButton, contactResponse } from "../../../client/components/untitled/MarketingButton";
---

<section class="marketing-section bg-slate-950 text-white" aria-labelledby="home-contact-heading">
  <div class="mx-auto grid max-w-[1440px] items-center gap-8 px-6 lg:grid-cols-[1fr_0.85fr] lg:gap-20 lg:px-12">
    <div>
      <p class="marketing-eyebrow marketing-eyebrow--dark mb-5">Your next step</p>
      <h2 id="home-contact-heading" class="max-w-2xl text-balance font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">Tell us what your site should do better.</h2>
      <p class="mt-6 max-w-xl font-body text-lg leading-relaxed text-slate-300">The first chat is free. We will look at what you need and explain where we can help.</p>
    </div>
    <div class="rounded-2xl border border-white/15 bg-white/5 p-6 sm:p-8">
      <MarketingButton action="contact" className="max-w-full whitespace-normal text-left" />
      <p class="mt-4 font-body text-sm leading-6 text-slate-300">{contactResponse}</p>
    </div>
  </div>
</section>
