---
/**
 * Final CTA block - full-width conversion section before footer.
 * Bold, simple, one clear action.
 * Static Astro component.
 */
import { BUSINESS_PHONE, BUSINESS_PHONE_HREF } from "../../../client/lib/seo";
---

<section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
  >
  </div>

  <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
    <div class="max-w-3xl">
      <p
        class="text-xs font-medium tracking-[0.25em] text-white/40 uppercase mb-8 font-body"
      >
        Next step
      </p>

      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-8 leading-tight text-white"
      >
        Your competitors won't wait.<br />Why should you?
      </h2>

      <p class="text-lg md:text-xl text-white/50 leading-relaxed mb-14 max-w-2xl font-body">
        Every day your site underperforms is a day someone else gets the click, the call, the sale. A conversation costs nothing. Ignoring it costs everything.
      </p>

      <div class="flex flex-col sm:flex-row items-start gap-6">
        <a
          href="/contact"
          class="inline-flex items-center gap-3 px-10 py-5 rounded-lg bg-white text-gray-950 font-heading font-bold text-xl transition-all duration-200 hover:scale-[1.03] hover:shadow-[0_0_30px_rgba(255,255,255,0.25)] active:scale-[0.97]"
        >
          Start a conversation
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="/performance-scanner"
          class="inline-flex items-center gap-3 px-10 py-5 rounded-lg border border-white/20 text-white font-heading font-bold text-xl transition-all duration-200 hover:scale-[1.03] hover:border-white/50 active:scale-[0.97]"
        >
          Free site audit
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-white/55 font-body sm:text-base">
        Prefer to talk it through? Call us on
        <a href={BUSINESS_PHONE_HREF} class="font-semibold text-white transition hover:text-kaizen-cyan">{BUSINESS_PHONE}</a>.
      </p>
    </div>
  </div>
</section>
