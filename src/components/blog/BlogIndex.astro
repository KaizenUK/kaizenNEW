---
import FeatureCardMotion from "./FeatureCardMotion";
import { urlFor, type SanityPost, type SanityImageSource } from "../../lib/sanity/client";

interface Props {
  posts: SanityPost[];
}

const { posts } = Astro.props;
const [featuredPost, ...otherPosts] = posts ?? [];

const formatPublishedDate = (dateString?: string) => {
  if (!dateString) return "Draft";
  return new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(dateString));
};

const imageFor = (
  source: SanityImageSource | undefined,
  width: number,
  height: number,
) => {
  if (!source) return null;

  try {
    return urlFor(source).width(width).height(height).fit("crop").auto("format").url();
  } catch {
    return null;
  }
};
---

<section class="linear-container py-14 sm:py-20">
  <header class="mb-10 sm:mb-14">
    <p class="linear-meta mb-3 uppercase text-gray-500">Insights</p>
    <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-6xl">
      Engineering Notes
    </h1>
    <p class="mt-4 max-w-2xl text-base text-gray-400 sm:text-lg">
      Performance-first thinking, design systems, and build decisions that move
      real business metrics.
    </p>
  </header>

  {
    featuredPost ? (
      <div class="grid auto-rows-fr gap-4 md:grid-cols-3">
        <FeatureCardMotion
          href={`/blog/${featuredPost.slug}`}
          className="linear-card group relative flex min-h-[22rem] flex-col overflow-hidden md:col-span-2 md:row-span-2"
          client:idle
        >
          <div class="absolute inset-0 bg-gradient-to-br from-white/[0.04] to-transparent" />
          <div class="relative flex h-full flex-col gap-5 p-6 sm:p-8">
            <div class="linear-meta flex items-center justify-between">
              <span>{formatPublishedDate(featuredPost.publishedAt)}</span>
              <span>{featuredPost.readTime} min read</span>
            </div>

            <h2 class="max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              {featuredPost.title}
            </h2>
            <p class="max-w-2xl text-base text-gray-300 sm:text-lg">
              {featuredPost.excerpt}
            </p>

            <div class="mt-auto flex items-center justify-between">
              <div class="flex items-center gap-3">
                {
                  imageFor(featuredPost.author?.image, 64, 64) ? (
                    <img
                      src={imageFor(featuredPost.author?.image, 64, 64)!}
                      alt={featuredPost.author?.name || "Author"}
                      width="32"
                      height="32"
                      loading="lazy"
                      class="size-8 rounded-full border border-white/10 object-cover"
                    />
                  ) : (
                    <span class="inline-grid size-8 place-items-center rounded-full border border-white/10 bg-white/5 text-[10px] font-semibold uppercase text-white">
                      {featuredPost.author?.name?.slice(0, 2) ?? "KW"}
                    </span>
                  )
                }
                <span class="linear-meta">{featuredPost.author?.name ?? "Kaizen Team"}</span>
              </div>
              <span class="linear-meta text-sky-300 transition-colors group-hover:text-sky-200">
                Read article
              </span>
            </div>

            {
              imageFor(featuredPost.mainImage ?? featuredPost.coverImage, 1440, 720) ? (
                <img
                  src={imageFor(featuredPost.mainImage ?? featuredPost.coverImage, 1440, 720)!}
                  alt={featuredPost.title}
                  loading="lazy"
                  decoding="async"
                  class="mt-3 h-44 w-full rounded-xl border border-white/10 object-cover sm:h-56"
                />
              ) : null
            }
          </div>
        </FeatureCardMotion>

        {
          otherPosts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="linear-card group relative flex flex-col gap-4 p-5 sm:p-6"
            >
              {
                imageFor(post.mainImage ?? post.coverImage, 900, 520) ? (
                  <img
                    src={imageFor(post.mainImage ?? post.coverImage, 900, 520)!}
                    alt={post.title}
                    loading="lazy"
                    decoding="async"
                    class="h-36 w-full rounded-lg border border-white/10 object-cover"
                  />
                ) : (
                  <div class="h-36 w-full rounded-lg border border-white/10 bg-white/[0.03]" />
                )
              }
              <div class="linear-meta flex items-center justify-between">
                <span>{formatPublishedDate(post.publishedAt)}</span>
                <span>{post.readTime} min</span>
              </div>
              <h3 class="text-xl font-semibold tracking-tight text-white">
                {post.title}
              </h3>
              <p class="line-clamp-3 text-sm text-gray-400">{post.excerpt}</p>
              <div class="mt-auto flex items-center gap-3 pt-2">
                {
                  imageFor(post.author?.image, 48, 48) ? (
                    <img
                      src={imageFor(post.author?.image, 48, 48)!}
                      alt={post.author?.name || "Author"}
                      width="24"
                      height="24"
                      loading="lazy"
                      class="size-6 rounded-full border border-white/10 object-cover"
                    />
                  ) : (
                    <span class="inline-grid size-6 place-items-center rounded-full border border-white/10 bg-white/5 text-[9px] font-semibold uppercase text-white">
                      {post.author?.name?.slice(0, 2) ?? "KW"}
                    </span>
                  )
                }
                <span class="linear-meta text-[11px]">{post.author?.name ?? "Kaizen Team"}</span>
              </div>
            </a>
          ))
        }
      </div>
    ) : (
      <div class="linear-card p-6 text-sm text-gray-400">
        No posts found yet. Add your first post in <code>/studio</code>.
      </div>
    )
  }
</section>
