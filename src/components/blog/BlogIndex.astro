---
import { GuideCard } from "../../../client/components/untitled/blog/GuideCard";
import { urlFor, type SanityPost } from "../../lib/sanity/client";
import { formatBlogDate } from "../../lib/blog";

interface Props { posts: SanityPost[]; }
const { posts = [] } = Astro.props;
const imageFor = (post: SanityPost) => {
  const image = post.mainImage ?? post.coverImage;
  if (!image) return null;
  try {
    return {
      src: urlFor(image).width(720).height(420).fit("crop").quality(72).format("webp").url(),
      alt: image.alt || post.title,
    };
  } catch { return null; }
};
---

<section class="marketing-section marketing-section--compact bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="marketing-eyebrow mb-4 uppercase tracking-widest">Website guides</p>
      <h1 class="font-heading text-4xl font-bold text-kaizen-dark sm:text-5xl lg:text-6xl">Website guides for business owners</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">Plain-English advice on making your website faster, easier to find and better at bringing in work.</p>
      <a href="/authors/sean-mcdonnell/" class="mt-5 inline-flex min-h-11 items-center rounded-md text-sm font-semibold text-uui-brand-800 underline underline-offset-4 outline-uui-brand hover:text-uui-brand-700 focus-visible:outline-2 focus-visible:outline-offset-4">About Sean and how we check the guides</a>
    </header>
  </div>
</section>

<section aria-label="Website guides" class="marketing-section marketing-section--compact bg-white">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    {posts.length ? (
      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 sm:gap-y-12 lg:grid-cols-3">
        {posts.map((post, index) => (
          <GuideCard href={`/blog/${post.slug}/`} title={post.title} excerpt={post.excerpt} publishedAt={post.publishedAt} publishedLabel={formatBlogDate(post.publishedAt, "short")} readTime={post.readTime} authorName={post.author?.name} image={imageFor(post)} eager={index === 0} />
        ))}
      </div>
    ) : <p class="text-base text-slate-700">No guides have been published yet.</p>}
  </div>
</section>
