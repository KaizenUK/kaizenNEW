---
import PortableTextRenderer from "./PortableTextRenderer";
import {
  urlFor,
  type SanityPost,
  type SanityImageSource,
} from "../../lib/sanity/client";
import { getStudioUrl } from "../../lib/site";
import { formatBlogDate, getAuthorPath, getBlogReview } from "../../lib/blog";
import { ArrowLeft } from "@untitledui/icons";

interface Props {
  post: SanityPost;
}

const { post } = Astro.props;

const published = formatBlogDate(post.publishedAt);
const review = getBlogReview(post._id);
const authorPath = getAuthorPath(post.author);

const imageFor = (
  source: SanityImageSource | undefined,
  width: number,
  height: number,
) => {
  if (!source) return null;

  try {
    return urlFor(source)
      .width(width)
      .height(height)
      .fit("crop")
      .quality(72)
      .format("webp")
      .url();
  } catch {
    return null;
  }
};

const coverImageUrl =
  imageFor(post.mainImage, 1200, 690) ??
  imageFor(post.coverImage, 1200, 690);
const studioDocumentId = post._id.replace(/^drafts\./, "");
const studioEditorCookieName = "kaizen_studio_auth";
const studioUrl = getStudioUrl();
---

<article class="marketing-section marketing-section--compact bg-white">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <a
      href="/blog/"
      class="inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-uui-brand-800 outline-uui-brand hover:text-uui-brand-700 focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      <ArrowLeft aria-hidden="true" className="size-4" />
      Back to guides
    </a>

    <header class="mx-auto mt-5 max-w-3xl">
      <div
        id="studio-edit-link"
        class="mb-4 hidden"
        data-editor-cookie={studioEditorCookieName}
        data-document-id={studioDocumentId}
        data-studio-url={studioUrl}
      />

      <h1 class="font-heading text-4xl font-bold text-kaizen-dark sm:text-5xl">
        {post.title}
      </h1>

      {
        post.excerpt ? (
          <p class="mt-5 text-lg leading-relaxed text-slate-700">{post.excerpt}</p>
        ) : null
      }

      <div class="mt-7 flex flex-wrap gap-x-8 gap-y-4 border-y border-slate-200 py-5 text-sm text-slate-600">
        <div>
          <p class="m-0">
            By {authorPath ? (
              <a href={authorPath} rel="author" class="guide-author-link font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-brand-700">
                {post.author?.name}
              </a>
            ) : (post.author?.name ?? "Kaizen")}
          </p>
          <p class="mb-0 mt-1">{post.readTime} min read</p>
        </div>
        <div>
          <p class="m-0 font-semibold text-slate-700">Published</p>
          <time class="mt-1 block" datetime={post.publishedAt}>{published}</time>
        </div>
        {review && (
          <div>
            <p class="m-0 font-semibold text-slate-700">Last checked:</p>
            <time class="mt-1 block" datetime={review.checkedOn}>{review.label}</time>
          </div>
        )}
      </div>
    </header>

    {
      coverImageUrl ? (
        <figure class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
          <img
            src={coverImageUrl}
            width="1200"
            height="690"
            alt={post.title}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-auto w-full object-cover"
          />
        </figure>
      ) : null
    }

    <section data-blog-body class="mx-auto mt-10 max-w-3xl">
      <PortableTextRenderer value={post.body ?? []} />
    </section>
  </div>
</article>

<script is:inline>
  (() => {
    const container = document.getElementById("studio-edit-link");
    if (!container) return;

    const cookieName = container.getAttribute("data-editor-cookie") || "kaizen_studio_auth";
    const hasEditorCookie = document.cookie
      .split(";")
      .some((entry) => entry.trim() === `${cookieName}=1`);

    if (!hasEditorCookie) return;

    const documentId = container.getAttribute("data-document-id");
    if (!documentId) return;

    const studioUrl = container.getAttribute("data-studio-url");
    if (!studioUrl) return;

    const hostname = window.location.hostname.replace(/^www\./, "");
    if (!hostname || hostname === "localhost" || hostname === "127.0.0.1") {
      return;
    }

    const link = document.createElement("a");
    link.href = `${studioUrl}/structure/post;${encodeURIComponent(documentId)}`;
    link.target = "_blank";
    link.rel = "noreferrer";
    link.className =
      "inline-flex min-h-11 items-center rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-semibold text-uui-brand-800 outline-uui-brand hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-4";
    link.textContent = "Edit in Studio";

    container.append(link);
    container.classList.remove("hidden");
  })();
</script>
