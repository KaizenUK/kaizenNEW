---
const steps = [
  {
    title: "Find the right service.",
    copy: "Show what you do and where you work near the top.",
  },
  {
    title: "Read without the struggle.",
    copy: "Keep words clear and leave room to tap. Avoid pop-ups that cover the page.",
  },
  {
    title: "Get in touch.",
    copy: "Make the call or enquiry link easy to find. Check that it works on a phone.",
  },
];
---

<section class="marketing-section bg-white" aria-labelledby="phone-journey-heading">
  <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-6 lg:grid-cols-2 lg:gap-20 lg:px-12">
    <div>
      <p class="marketing-eyebrow mb-4 uppercase tracking-[0.2em]">From a phone to an enquiry</p>
      <h2 id="phone-journey-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Make the next step<br />easy on a phone.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">Your next customer may be reading on a small screen. We check the path from the first page to getting in touch.</p>
      <ol class="mt-7 space-y-6">
        {steps.map((step, index) => (
          <li class="grid grid-cols-[2rem_1fr] gap-4">
            <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-full bg-uui-brand-50 text-sm font-semibold text-uui-brand-800">{index + 1}</span>
            <div>
              <h3 class="font-heading text-2xl font-bold text-uui-dark">{step.title}</h3>
              <p class="mt-2 max-w-md text-base leading-relaxed text-slate-600">{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <figure class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <div role="img" aria-label="Example phone page: a clear plumbing service, the area it covers and a visible call option." class="mx-auto max-w-[292px] rounded-[2.5rem] border-[3px] border-slate-700 bg-slate-950 p-2.5 shadow-xl">
        <div aria-hidden="true" class="overflow-hidden rounded-[1.75rem] bg-white">
          <div class="flex justify-center py-3"><span class="h-1.5 w-16 rounded-full bg-slate-200"></span></div>
          <div class="border-b border-slate-200 px-5 pb-4 text-xs font-semibold text-slate-600">Example website</div>
          <div class="p-5">
            <div class="flex items-center gap-2 text-xs font-semibold text-uui-brand-800"><span class="flex size-6 items-center justify-center rounded-full bg-uui-brand-50">1</span>Plumbing repairs</div>
            <p class="mt-4 font-heading text-3xl font-bold leading-tight text-uui-dark">Help with leaks<br />and dripping taps.</p>
            <p class="mt-3 text-sm leading-6 text-slate-600">See the repairs we do and the areas we cover.</p>
            <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div class="flex items-center gap-2 text-sm font-semibold text-uui-dark"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-xs text-uui-brand-800">2</span>Check your area</div>
              <p class="mt-2 text-sm leading-6 text-slate-600">Find out if we work near you.</p>
            </div>
            <div class="mt-5 flex items-center justify-center gap-2 rounded-lg bg-uui-brand-600 px-4 py-3 text-sm font-semibold text-white"><span class="flex size-6 items-center justify-center rounded-full border border-white/50 text-xs">3</span>Call about a repair</div>
          </div>
          <div class="flex justify-center pb-3"><span class="h-1 w-20 rounded-full bg-slate-200"></span></div>
        </div>
      </div>
      <figcaption class="mx-auto mt-6 max-w-xs text-center text-sm leading-6 text-slate-600">An example phone page with each step easy to find.</figcaption>
    </figure>
  </div>
</section>
