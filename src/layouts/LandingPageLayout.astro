---
import "../../client/global.css";
import { isStagingBuild, STAGING_ROBOTS } from "../lib/site";
import PostHog from "../components/posthog.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "",
  robots = "noindex, nofollow",
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <PostHog />
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={isStagingBuild() ? STAGING_ROBOTS : robots} />
    <link rel="preload" href="/fonts/manifa-v2-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="marketing-page min-h-screen bg-white text-kaizen-text-dark antialiased">
    <slot />
    <AnalyticsConsent />
  </body>
</html>
