---
import "../../client/global.css";
import "../styles/blog.css";
import NavShell from "../../client/components/layout/NavShell";
import SiteFooter from "../../client/components/layout/SiteFooter";
import { isStagingBuild, resolveCanonicalUrl, STAGING_ROBOTS } from "../lib/site";
import PostHog from "../components/posthog.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
  title: string;
  author?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  isPreview?: boolean;
}

const {
  title,
  author = "Kaizen Web",
  description = "Website guides for business owners from Kaizen Web.",
  canonical: canonicalProp,
  ogTitle,
  ogDescription,
  image,
  ogImage,
  ogType = "website",
  robots,
  isPreview = false,
} = Astro.props;

const canonical = resolveCanonicalUrl(canonicalProp, Astro.url.pathname);
const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;
const socialImage = ogImage || image;
const robotsContent = isStagingBuild()
  ? STAGING_ROBOTS
  : robots || (import.meta.env.MODE === "development" ? "noindex" : "index, follow");
const buildNumber = String(import.meta.env.VITE_BUILD_NUMBER ?? "").trim();
const buildSha = String(import.meta.env.VITE_BUILD_SHA ?? "").trim().slice(0, 7);
const buildLabel = buildNumber || buildSha || "local";
const footerBuildLabel =
  buildNumber && buildSha ? `${buildLabel} (${buildSha})` : buildLabel;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <PostHog />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={author} />
    <meta name="publisher" content="Kaizen Web" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Kaizen Web" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preload" href="/fonts/manifa-v2-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="marketing-page blog-page min-h-screen bg-white text-kaizen-text-dark antialiased">
    <NavShell pathname={Astro.url.pathname} client:load />
    <main id="main-content" tabindex="-1" class="pt-20">
      <slot />
    </main>
    <SiteFooter buildLabel={footerBuildLabel} />
    <AnalyticsConsent />
  </body>
</html>
