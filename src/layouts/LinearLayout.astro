---
import "../styles/linear.css";
import BlogNav from "../components/blog/BlogNav.astro";
import { resolveCanonicalUrl } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  isPreview?: boolean;
}

const {
  title,
  description = "Kaizen insights on performance engineering, design systems, and conversion-focused websites.",
  canonical: canonicalProp,
  ogTitle,
  ogDescription,
  image,
  ogImage,
  ogType = "website",
  robots,
  isPreview = false,
} = Astro.props;

const canonical = resolveCanonicalUrl(canonicalProp, Astro.url.pathname);
const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;
const socialImage = ogImage || image;
const robotsContent =
  robots || (import.meta.env.MODE === "development" ? "noindex" : "index, follow");
const buildNumber = String(import.meta.env.VITE_BUILD_NUMBER ?? "").trim();
const buildSha = String(import.meta.env.VITE_BUILD_SHA ?? "").trim().slice(0, 7);
const buildLabel = buildNumber || buildSha || "local";
---

<!doctype html>
<html lang="en-GB" class="h-full bg-[#0a0a0a]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Kaizen Web" />
    <meta name="publisher" content="Kaizen Web" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Kaizen Web" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full bg-[#0a0a0a] text-gray-200 antialiased">
    <BlogNav />
    <slot />
    <footer class="border-t border-white/10 py-6 text-center">
      <p class="text-[11px] font-mono tracking-wide text-gray-500">
        Build {buildLabel}
        {buildNumber && buildSha && <span class="text-gray-600"> ({buildSha})</span>}
      </p>
  </body>
</html>
