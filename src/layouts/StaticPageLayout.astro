---
import "../../client/global.css";
import NavShell from "../../client/components/layout/NavShell";
import SiteFooter from "../../client/components/layout/SiteFooter";
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  getPageMeta,
} from "../../client/lib/seo";
import { getPageByPath, getStaticPageBySlug, urlFor } from "../lib/sanity/client";
import { normalizeSitePath, resolveCanonicalUrl } from "../lib/site";

interface Props {
  path: string;
  title?: string;
  description?: string;
  robots?: string;
  canonical?: string;
}

const {
  path,
  title: titleOverride,
  description: descriptionOverride,
  robots: robotsOverride,
  canonical: canonicalOverride,
} = Astro.props;

const normalizedPath = normalizeSitePath(path);
const seoLookupPath =
  normalizedPath === "/" ? "/" : normalizedPath.replace(/\/$/, "");
const [managedPage, staticPage] = await Promise.all([
  getPageByPath(seoLookupPath, false),
  getStaticPageBySlug(seoLookupPath, false),
]);
const sanityTitle = managedPage?.seo?.metaTitle || staticPage?.seo?.metaTitle;
const sanityDescription =
  managedPage?.seo?.metaDescription || staticPage?.seo?.metaDescription;
const sanityCanonical =
  managedPage?.seo?.canonicalUrl || staticPage?.seo?.canonicalUrl;
const sanityNoIndex =
  managedPage?.seo?.noIndex ?? staticPage?.seo?.noIndex ?? false;
let sanityOgImage: string | undefined;
try {
  const shareImage = managedPage?.seo?.shareImage || staticPage?.seo?.shareImage;
  if (shareImage) {
    sanityOgImage = urlFor(shareImage).width(1200).height(630).fit("crop").auto("format").url();
  }
} catch {
  sanityOgImage = undefined;
}

const meta = getPageMeta(path);
const title = sanityTitle || titleOverride || meta.title;
const description = sanityDescription || descriptionOverride || meta.description;
const canonicalUrl = resolveCanonicalUrl(sanityCanonical || canonicalOverride, path);
const robots =
  robotsOverride ||
  (sanityNoIndex || meta.noIndex
    ? "noindex, nofollow"
    : import.meta.env.MODE === "development"
      ? "noindex"
      : "index, follow");
const ogImage = sanityOgImage || meta.image || DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Kaizen Web" />
    <meta name="publisher" content="Kaizen Web" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-kaizen-text-dark antialiased">
    <NavShell client:load />

    <main class="pt-20">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
