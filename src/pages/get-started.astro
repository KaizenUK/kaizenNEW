---
import { MarketingButton } from "../../client/components/untitled/MarketingButton";
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
import { ContactFormBox } from "../../client/components/ContactFormBox";
import KaizenLogo from "../../client/components/KaizenLogo";

export const prerender = true;
---

<LandingPageLayout
  title="Fix Your Slow Website | Kaizen Web"
  description="Kaizen rebuilds dated, slow business websites. See the Midland Oil result, then tell us about your site. The first conversation is free."
>
<!-- ═══ MINIMAL HEADER ═══ -->
  <header class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200/60">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 h-16 flex items-center justify-between">
      <a href="/" aria-label="Kaizen home" class="inline-flex items-center rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-700">
        <KaizenLogo className="h-7 w-[88px] sm:w-[128px] text-[#001133]" client:load />
      </a>
      <MarketingButton action="contact" href="#get-in-touch" size="sm" className="max-sm:*:data-icon:hidden" />
    </div>
  </header>

  <main>
  <!-- ═══ HERO ═══ -->
  <section class="marketing-section marketing-section--landing-hero relative bg-gray-950 text-white overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(6,182,212,0.08),transparent_50%)]"
    ></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_20%,rgba(38,107,255,0.06),transparent_50%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <h1
          class="text-balance text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          A faster website for your business.
        </h1>
        <p class="text-lg md:text-xl text-white/70 font-body leading-relaxed mb-12 max-w-2xl">
          Kaizen rebuilds dated, slow sites so people can find what they need. We agree the work and price before we start. The first chat is free.
        </p>

        <div class="space-y-4">
          <MarketingButton action="contact" href="#get-in-touch" />
          <p class="text-sm font-body text-white/70 max-w-md">One of us will get back to you the same day, or the next working day at the latest.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHY IT'S SLOW ═══ -->
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
        <div class="md:col-span-4 lg:col-span-3">
          <p
            class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-600 mb-6"
          >
            Start with the cause
          </p>
          <h2
            class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight"
          >
            Find out what slows your site down.
          </h2>
        </div>
        <div class="md:col-span-8 lg:col-span-9">
          <div class="max-w-2xl space-y-6 text-base md:text-lg font-body text-gray-600 leading-relaxed">
            <p>
              Large photos or old page features can slow a site down. We look at your pages before we suggest what to change.
            </p>
            <p>
              You may need a few fixes or a fresh build. We explain the options and what each one would involve.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT IT'S COSTING YOU ═══ -->
  <section class="marketing-section marketing-section--compact bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-16">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-600 mb-6"
        >
          Think about the visitor
        </p>
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight"
        >
          Make it easy to choose your business.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
        <div class="md:col-span-8 lg:col-span-9">
          <p class="text-base md:text-lg font-body text-gray-600 leading-relaxed max-w-2xl">
            Open your site on a phone. Can you see what you sell and how to get in touch? We help make that path clear, from the first page to the form.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THIS ACTUALLY HAPPENED ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_60%_50%,rgba(6,182,212,0.06),transparent_50%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/70 mb-6"
        >
          Midland Oil Group
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight"
        >
          Three times the enquiries.<br /> <span class="text-white/80">In the first month.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
        <div class="md:col-span-5">
          <figure>
            <img src="/images/case-studies/midland-oil-group/mog-new-homepage.webp" width="2550" height="1312" alt="Midland Oil's rebuilt homepage with clear product choices" loading="lazy" decoding="async" class="w-full rounded-lg border border-white/20" />
            <figcaption class="mt-4 text-sm font-body text-white/70">Midland Oil's website after the rebuild.</figcaption>
          </figure>
        </div>

        <div class="md:col-span-7">
          <div class="space-y-5 text-base font-body text-white/70 leading-relaxed">
            <p>
              Midland Oil Group supplies oils and greases to businesses. Its old site took more than 8 seconds to load on a phone.
            </p>
            <p>
              We rebuilt the site with clear product choices. The new pages load in 1.2 seconds.
            </p>
            <p class="text-white/80 font-heading font-bold text-lg">
              Enquiries tripled in the first month after launch. Midland now gets several genuine enquiries a day.
            </p>
          </div>
          <MarketingButton action="caseStudy" href="/case-studies/midland-oil-group/" variant="link" onDark className="mt-8" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT ACTUALLY CHANGES ═══ -->
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-600 mb-6"
        >
          After the rebuild
        </p>
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight"
        >
          Help people find what they need.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
        <div class="border-l-2 border-cyan-600 pl-6">
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            Pages that load quickly.
          </h3>
          <p class="text-base font-body text-gray-600 leading-relaxed">
            We check loading times as we build. You can try your site on a phone before it goes live.
          </p>
        </div>
        <div class="border-l-2 border-cyan-600 pl-6">
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            Clear pages for your services.
          </h3>
          <p class="text-base font-body text-gray-600 leading-relaxed">
            Visitors should know what you sell without hunting for it. We give each main service a clear place on your site.
          </p>
        </div>
        <div class="border-l-2 border-cyan-600 pl-6">
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            An easy way to get in touch.
          </h3>
          <p class="text-base font-body text-gray-600 leading-relaxed">
            We make your contact details easy to find. Your form is checked on phones as well as larger screens.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="marketing-section bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-600 mb-6"
        >
          How it works
        </p>
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-gray-950 leading-tight"
        >
          Agree the plan before the build starts.
        </h2>
      </div>

      <div class="space-y-0">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0 border-b border-gray-300">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="text-sm font-body text-cyan-700 tracking-wide block mb-2">01</span>
            <h3 class="text-2xl md:text-3xl font-heading font-bold text-gray-950">
              Tell us about your site
            </h3>
          </div>
          <div class="md:col-span-8 lg:col-span-9">
            <p class="text-base md:text-lg font-body text-gray-600 leading-relaxed max-w-2xl">
              Use the form below to tell us what needs to change. The first conversation is free. We agree the work and a fixed price before you pay a non-refundable deposit.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0 border-b border-gray-300">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="text-sm font-body text-cyan-700 tracking-wide block mb-2">02</span>
            <h3 class="text-2xl md:text-3xl font-heading font-bold text-gray-950">
              See the work as it grows
            </h3>
          </div>
          <div class="md:col-span-8 lg:col-span-9">
            <p class="text-base md:text-lg font-body text-gray-600 leading-relaxed max-w-2xl">
              Work starts after the deposit. You deal with the same person and see progress as we build. You approve the site before it goes live.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="text-sm font-body text-cyan-700 tracking-wide block mb-2">03</span>
            <h3 class="text-2xl md:text-3xl font-heading font-bold text-gray-950">
              Get help after launch
            </h3>
          </div>
          <div class="md:col-span-8 lg:col-span-9">
            <p class="text-base md:text-lg font-body text-gray-600 leading-relaxed max-w-2xl">
              Report faults in our work within 30 days of launch. We fix those at no extra cost. We agree a price for bigger changes before we start.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT FORM ═══ -->
  <section id="get-in-touch" tabindex="-1" aria-labelledby="contact-heading" class="scroll-mt-20 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-cyan-300 marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-24">
        <!-- Left: Copy -->
        <div class="max-w-lg">
          <p
            class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/70 mb-6"
          >
            Get started
          </p>
          <h2 id="contact-heading"
            class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight mb-8"
          >
            Start with a free chat<br /> <span class="text-white/80">about your site.</span>
          </h2>
          <p class="text-lg text-white/70 font-body leading-relaxed mb-10">
            One of us will get back to you the same day, or the next working day at the latest.
          </p>

          <div class="space-y-5 text-white/70 text-sm font-body">
            <div class="flex items-start gap-3">
              <svg aria-hidden="true" class="w-5 h-5 text-cyan-300 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>You agree the work and price first.</span>
            </div>
            <div class="flex items-start gap-3">
              <svg aria-hidden="true" class="w-5 h-5 text-cyan-300 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>You see and approve the site before launch.</span>
            </div>
            <div class="flex items-start gap-3">
              <svg aria-hidden="true" class="w-5 h-5 text-cyan-300 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>You deal with the same person throughout.</span>
            </div>
          </div>
          <p class="mt-8 text-sm text-white/70">Read <a href="/pledge/" class="underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">our pledge about the work and price</a>.</p>
        </div>

        <!-- Right: Form -->
        <div>
          <ContactFormBox autoFocusFields={false} client:load />
        </div>
      </div>
    </div>
  </section>

  </main>

  <!-- ═══ MINIMAL FOOTER ═══ -->
  <footer class="bg-gray-950 border-t border-white/5 py-8">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/70 font-body">
        <p>&copy; {new Date().getFullYear()} Kaizen Web Ltd. Company No. 17007703</p>
        <a
          href="/"
          class="hover:text-white transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300"
        >
          Kaizen home
        </a>
      </div>
    </div>
  </footer>

</LandingPageLayout>
