---
import BlogPost from "../../../components/blog/BlogPost.astro";
import LinearLayout from "../../../layouts/LinearLayout.astro";
import { getPostById, getPostBySlug, urlFor } from "../../../lib/sanity/client";

// Server-rendered only so drafts are always fresh.
export const prerender = false;

const { slug } = Astro.params;
const requestedId =
  Astro.url.searchParams.get("id")?.replace(/^drafts\./, "").trim() ?? "";

if (!slug) {
  return Astro.redirect("/blog");
}

// Preview routes are only available to Studio-authenticated editors.
const isEditor = Astro.cookies.get("kaizen_studio_auth")?.value === "1";
if (!isEditor) {
  return new Response("Unauthorized - sign in to Sanity Studio first.", {
    status: 401,
  });
}

let post = await getPostBySlug(slug, true);
if (!post && requestedId) {
  post = await getPostById(requestedId, true);
}

if (!post) {
  return Astro.redirect("/blog");
}

const layoutTitle = `[Preview] ${post.seo?.metaTitle || post.title}`;
const layoutDescription = post.seo?.metaDescription || post.excerpt;

let ogImage: string | undefined;
try {
  const source = post.seo?.shareImage ?? post.mainImage;
  const fallbackSource = post.coverImage;
  if (source || fallbackSource) {
    ogImage = urlFor(source ?? fallbackSource!).width(1200).height(630).fit("crop").auto("format").url();
  }
} catch {
  ogImage = undefined;
}

const liveSlug = post.slug || slug;
---

<LinearLayout
  title={layoutTitle}
  description={layoutDescription}
  ogTitle={layoutTitle}
  ogDescription={layoutDescription}
  ogImage={ogImage}
  ogType="article"
>
  <div
    class="fixed top-0 left-0 z-50 w-full bg-amber-500 px-4 py-2 text-center text-sm font-semibold text-black"
  >
    Draft preview - this content is not published yet.
    <a href={`/blog/${liveSlug}`} class="ml-2 underline">View live</a>
    <span class="mx-1">|</span>
    <a href="/studio" class="underline">Back to Studio</a>
  </div>
  <div class="pt-10">
    <BlogPost post={post} />
  </div>
</LinearLayout>
