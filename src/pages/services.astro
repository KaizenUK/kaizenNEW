---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;

const services = [
  {
    title: "Web Design Liverpool",
    description:
      "Fast, modern websites that generate leads and help your business grow online.",
    link: "/web-design-liverpool",
  },
  {
    title: "Web Design Liverpool City Centre",
    description:
      "Specialist web design for Liverpool city centre businesses with unique needs.",
    link: "/web-design-liverpool",
  },
  {
    title: "WordPress Web Design",
    description:
      "Custom, fast, and secure WordPress sites built the right way. No bloat, just performance.",
    link: "/services/wordpress-web-design",
  },
  {
    title: "Local SEO",
    description:
      "Help local customers find you through search. Optimise your Google Business Profile and local visibility.",
    link: "/services/local-seo",
  },
  {
    title: "E-commerce Development",
    description:
      "Sell online with a store that's easy to manage and optimised to convert.",
    link: "/services/ecommerce",
  },
  {
    title: "Digital Transformation",
    description:
      "Join up your website with back-office processes. Automate workflows and improve systems.",
    link: "/digital-transformation",
  },
  {
    title: "Agile Coaching",
    description:
      "Help your team adopt Agile methodology. Improve delivery, reduce waste, ship faster.",
    link: "/agile-coaching",
  },
  {
    title: "Contract Product Owner",
    description:
      "Senior Product Owner support for complex delivery, prioritisation, and roadmap clarity.",
    link: "/contract-product-owner",
  },
];
---

<StaticPageLayout path="/services">
  <section class="bg-kaizen-dark py-20 text-kaizen-text-light md:py-32">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="mb-6 text-4xl font-heading font-bold leading-tight md:text-5xl lg:text-6xl">
          Digital Services Liverpool
        </h1>
        <p class="text-lg text-kaizen-text-light/80">
          We help Liverpool businesses build better digital products. From web
          design to Agile coaching, we bring clarity and expertise to every
          project.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <a
            href={service.link}
            class="group rounded-2xl border border-kaizen-light bg-kaizen-light p-8 transition hover:border-kaizen-cyan hover:shadow-lg"
          >
            <h2 class="mb-4 text-xl font-heading font-bold transition group-hover:text-kaizen-cyan">
              {service.title}
            </h2>
            <p class="mb-6 text-kaizen-text-dark/70">{service.description}</p>
            <span class="inline-flex items-center gap-2 text-sm font-medium text-kaizen-cyan">
              Learn More
              <span aria-hidden="true">-&gt;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-kaizen-dark py-20 text-kaizen-text-light md:py-32">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-6 text-3xl font-heading font-bold md:text-4xl">
        Not sure which service you need?
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-kaizen-text-light/80">
        Let's chat. We'll assess your project and recommend the right approach.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-3 font-heading font-bold text-kaizen-dark transition hover:opacity-90"
      >
        Start a Conversation
        <span aria-hidden="true">-&gt;</span>
      </a>
    </div>
  </section>
</StaticPageLayout>
