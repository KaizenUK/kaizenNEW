---
import { FaqSection } from "../../../client/components/untitled/faq";
import { MarketingButton, contactResponse } from "../../../client/components/untitled/MarketingButton";
import { MetricsBlock } from "../../../client/components/untitled/proof";
import { caseStudies } from "../../../client/components/untitled/proof/evidence";
import PhoneJourney from "../../components/services/PhoneJourney.astro";
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";

export const prerender = true;
const midland = caseStudies.midland;

const paths = [
  {
    number: "01",
    label: "Keep what works",
    headline: "Improve the site you have.",
    ideal: "You like the design, but pages are slow or hard to use on a phone.",
    description: "We check what causes the problems and agree which fixes matter most. You get a clear plan and price before we start.",
    editing: "Keep your pages and the editor you know.",
  },
  {
    number: "02",
    label: "A fresh design",
    headline: "Rebuild around your customers.",
    ideal: "You have tried fixes, but the site is still hard to use or change.",
    description: "We rebuild the pages your customers see around what they need to do. Help them find what you offer and get in touch.",
    editing: "Edit your own pages and blog. We show you how before launch.",
  },
  {
    number: "03",
    label: "Keep WordPress",
    headline: "Build a new WordPress site.",
    ideal: "You want new pages while keeping an editor you know how to use.",
    description: "We build a new WordPress site around your business. This can suit a fresh start or replace a site that no longer fits.",
    editing: "Keep using WordPress, with help when you need it.",
  },
];

const steps = [
  {
    title: "Agree the work and cost.",
    description: "The first conversation is free. We agree what needs to change, the price and dates. Work starts after a non-refundable deposit.",
  },
  {
    title: "See your pages before launch.",
    description: "You see the work before it goes live. We show you how to edit your pages and blog.",
  },
  {
    title: "Get help with later changes.",
    description: "You deal with the same person throughout. You can make your own changes, or ask us to do them for you.",
  },
];

const faqs = [
  {
    "question": "How do I know which option fits?",
    "answer": "We start by looking at your site and asking what you need. We explain the options before you pay for work."
  },
  {
    "question": "Can my Google rankings change after a rebuild?",
    "answer": "Yes, rankings can change when a site changes. We plan which page replaces each old one and check the links. We cannot promise a search position."
  },
  {
    "question": "Can I still edit my own pages?",
    "answer": "Yes. You can edit your pages and blog with each option. We show you how it works before launch."
  },
  {
    "question": "Can you help keep the site secure?",
    "answer": "Yes. We check access to your site and plan how to keep it up to date. We explain what care it needs after launch."
  },
  {
    "question": "How long will the work take?",
    "answer": "It depends on what needs to change. We agree the scope and dates with you before work starts."
  },
  {
    "question": "Can you check a site someone else built?",
    "answer": "Yes. We can look at the site you have. We explain what works, what needs attention and what we would change."
  },
  {
    "question": "Should I rebuild or improve my site?",
    "answer": "Small fixes may be enough if the site still meets your needs. A rebuild may make more sense if it is hard to use or change."
  },
  {
    "question": "Do I have to stay on WordPress?",
    "answer": "No. We can keep WordPress or build a new site around your needs. You can still edit your own content either way."
  },
  {
    "question": "What if my site has been hacked?",
    "answer": "Get in touch and tell us what happened. We can assess the damage and discuss the next steps."
  },
  {
    "question": "Will a new site put me first on Google?",
    "answer": "No one can promise that. A useful site helps people find answers and get in touch. We focus on making it work for your customers."
  }
];


const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "WordPress Web Design",
  description:
    "WordPress web design for businesses. Improve your current site, rebuild it or move to a new site you can edit.",
  provider: {
    "@type": "Organization",
    name: "Kaizen Web",
    url: "https://kaizenweb.co.uk",
  },
});
---

<StaticPageLayout
  path="/services/wordpress-web-design"
  title="WordPress Web Design: Fix, Rebuild or Move | Kaizen Web"
  description="Is your WordPress site slow or hard to update? We can speed it up, rebuild it properly or move you to a faster custom site, and we'll say which fits."
>
  <script type="application/ld+json" set:html={serviceSchema} is:inline />

  <section class="marketing-section bg-white" aria-labelledby="wordpress-heading">
    <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-6 lg:grid-cols-2 lg:gap-16 lg:px-12">
      <div>
        <p class="marketing-eyebrow mb-5 uppercase tracking-[0.2em]">For a slow or dated site</p>
        <h1 id="wordpress-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark sm:text-5xl lg:text-6xl">
          WordPress web design.<br />
          <span class="text-slate-500">Fix it or start fresh.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 md:text-xl">
          We help business owners improve slow, dated sites or plan a new one.
          Keep what works and change what gets in the way.
        </p>
        <p class="mt-5 text-base text-slate-600">Start with a free first conversation.</p>
        <div class="mt-5">
          <MarketingButton action="contact" />
          <p class="mt-4 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
        </div>
      </div>
      <div>
        <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
          <div aria-hidden="true" class="flex items-center gap-3 border-b border-slate-200 bg-white px-4 py-3">
            <span class="flex gap-1.5">
              <span class="size-2 rounded-full bg-slate-300"></span>
              <span class="size-2 rounded-full bg-slate-300"></span>
              <span class="size-2 rounded-full bg-slate-300"></span>
            </span>
            <span class="text-xs text-slate-600">{midland.websiteLabel}</span>
          </div>
          <img src={midland.screenshot.src} alt={midland.screenshot.alt} width={midland.screenshot.width} height={midland.screenshot.height} loading="eager" decoding="async" class="block h-auto w-full" />
          <figcaption class="border-t border-slate-200 bg-white px-5 py-4 text-sm leading-6 text-slate-600">
            A real rebuild for Midland Oil Group. Buyers can find the right oil and send an enquiry.
          </figcaption>
        </figure>
        <MetricsBlock className="mt-7" />
      </div>
    </div>
  </section>

  <section class="marketing-section bg-slate-50" aria-labelledby="wordpress-options-heading">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p class="marketing-eyebrow mb-4 uppercase tracking-[0.2em]">Choose the work you need</p>
        <h2 id="wordpress-options-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">
          A few fixes may be enough.<br />A rebuild is another choice.
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
          The right option depends on what still works for you. We look at your site and explain the choices before you pay.
        </p>
      </div>
      <div class="mt-8 grid gap-5 lg:mt-10 lg:grid-cols-3">
        {paths.map((path) => (
          <article class="flex min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-uui-brand-50 text-sm font-semibold text-uui-brand-800">{path.number}</span>
              <p class="text-sm font-semibold text-slate-600">{path.label}</p>
            </div>
            <h3 class="mt-5 text-balance font-heading text-3xl font-bold text-uui-dark">{path.headline}</h3>
            <p class="mt-5 text-base leading-relaxed text-slate-600">{path.ideal}</p>
            <p class="mt-4 text-base leading-relaxed text-slate-600">{path.description}</p>
            <div class="mt-auto pt-6">
              <p class="border-t border-slate-200 pt-5 text-sm font-semibold leading-6 text-uui-dark">{path.editing}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-7 max-w-2xl text-base leading-relaxed text-slate-600">
        For more detail, <a href="/blog/wordpress-vs-react-business-roi/" class="font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">compare ways to build your website</a> in our guide.
      </p>
    </div>
  </section>

  <PhoneJourney />

  <section class="marketing-section bg-gray-950" aria-labelledby="wordpress-process-heading">
    <div class="mx-auto grid max-w-[1440px] items-start gap-10 px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:px-12">
      <div>
        <p class="marketing-eyebrow marketing-eyebrow--dark mb-4 uppercase tracking-[0.2em]">Know what you are paying for</p>
        <h2 id="wordpress-process-heading" class="text-balance font-heading text-4xl font-bold text-white md:text-5xl">See what will change.<br />Stay in control.</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
          If you paid for a site that let you down, another rebuild can feel like a risk.
          We explain the work and show you your pages before launch.
        </p>
        <a href="/pledge/" class="mt-6 inline-block font-semibold text-uui-brand-200 underline underline-offset-4 hover:text-white">Read our pledge before you decide</a>
      </div>
      <ol class="space-y-7">
        {steps.map((step, index) => (
          <li class="grid grid-cols-[2rem_1fr] gap-4 border-t border-slate-700 pt-6 sm:gap-6">
            <span aria-hidden="true" class="font-heading text-2xl font-bold text-uui-brand-200">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="font-heading text-2xl font-bold text-white sm:text-3xl">{step.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-slate-300">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="marketing-section marketing-section--compact bg-slate-50" aria-labelledby="wordpress-move-heading">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="grid items-start gap-6 lg:grid-cols-2 lg:gap-20">
        <h2 id="wordpress-move-heading" class="text-balance font-heading text-3xl font-bold text-uui-dark md:text-4xl">Look after the pages<br />people already find.</h2>
        <p class="max-w-xl text-lg leading-relaxed text-slate-600">Search positions can change after a rebuild. We plan the move and check for problems before and after launch.</p>
      </div>
      <details id="wordpress-move-plan" class="group mt-6 rounded-xl border border-slate-200 bg-white">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-xl p-5 font-semibold text-uui-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-uui-brand-600 [&::-webkit-details-marker]:hidden">
          How we look after your existing pages
          <span aria-hidden="true" class="shrink-0 text-2xl font-normal text-slate-500 group-open:rotate-45">+</span>
        </summary>
        <ol class="grid gap-6 border-t border-slate-200 p-5 sm:grid-cols-2 sm:p-7">
          <li><h3 class="font-heading text-2xl font-bold text-uui-dark">Record the site first.</h3><p class="mt-2 text-base leading-relaxed text-slate-600">We save the current pages and their web addresses. We check which pages people find through search.</p></li>
          <li><h3 class="font-heading text-2xl font-bold text-uui-dark">Plan each changed address.</h3><p class="mt-2 text-base leading-relaxed text-slate-600">If a page moves, we send its old address to the right new page. We check the links before launch.</p></li>
          <li><h3 class="font-heading text-2xl font-bold text-uui-dark">Keep useful page details.</h3><p class="mt-2 text-base leading-relaxed text-slate-600">We review page titles, descriptions and business details. We carry over what is still correct.</p></li>
          <li><h3 class="font-heading text-2xl font-bold text-uui-dark">Check after launch.</h3><p class="mt-2 text-base leading-relaxed text-slate-600">We look for broken links and pages missing from search. We check how search visits change.</p></li>
        </ol>
      </details>
      <p class="mt-5 text-sm leading-6 text-slate-600">For checks you can do yourself, use our <a href="/blog/local-seo-liverpool-checklist/" class="font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">local search checklist</a>.</p>
    </div>
  </section>

  <FaqSection
    id="wordpress-faq"
    heading="Get clear answers before you decide."
    eyebrow="Common questions"
    items={faqs}
    className="bg-white"
  />

  <section class="marketing-section bg-slate-50" aria-labelledby="wordpress-contact-heading">
    <div class="mx-auto max-w-[1440px] px-6 text-center lg:px-12">
      <h2 id="wordpress-contact-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Tell us where your site falls short.</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
        Share your website and what you want to change. The first conversation is free.
      </p>
      <div class="mt-7">
        <MarketingButton action="contact" />
        <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
      </div>
    </div>
  </section>
</StaticPageLayout>
