---
import { MarketingButton } from "../../../client/components/untitled/MarketingButton";
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../../client/components/ContactCTAButton";

export const prerender = true;

/* ── Three paths ─────────────────────────────────────────────── */
const paths = [
  {
    "number": "01",
    "headline": "Rebuild the site around your business.",
    "hook": "Keep what works. Get a new site that is easier to use.",
    "description": "We rebuild the pages your customers see. You can still edit your own pages and blog. We show you how before launch.",
    "ideal": "Your old site holds you back, even after repeated fixes.",
    "cta": "Talk to us about your site",
    "tag": "A fresh start",
    "tagColor": "cyan"
  },
  {
    "number": "02",
    "headline": "Improve the site you have.",
    "hook": "You may not need to start again.",
    "description": "We check your site and explain what needs work. Then we agree which fixes matter most to your business.",
    "ideal": "You like your site but want it to load faster.",
    "cta": "Talk to us about your site",
    "tag": "Build on what works",
    "tagColor": "gray"
  },
  {
    "number": "03",
    "headline": "Start with a new WordPress site.",
    "hook": "Stay with the editor you know.",
    "description": "We build your pages around what customers need to do. You get a site you can edit, with help when you need it.",
    "ideal": "You want to keep WordPress and improve how your site works.",
    "cta": "Talk to us about your site",
    "tag": "Keep WordPress",
    "tagColor": "gray"
  }
];

/* ── The problem (story-driven) ──────────────────────────────── */
const problems = [
  {
    "stat": "The wait",
    "detail": "A slow page makes it harder to see what you offer. Check what loads before you spend on more ads."
  },
  {
    "stat": "The clutter",
    "detail": "Extra features can get in the way. Keep the parts that help people find what they need."
  },
  {
    "stat": "The next step",
    "detail": "Make it easy to call or send an enquiry. People should not have to hunt for your contact details."
  }
];

/* ── FAQ ─────────────────────────────────────────────────────── */
const faqs = [
  {
    "question": "How do I know which option fits?",
    "answer": "We start by looking at your site and asking what you need. We explain the options before you pay for work."
  },
  {
    "question": "Can my Google rankings change after a rebuild?",
    "answer": "Yes, rankings can change when a site changes. We plan which page replaces each old one and check the links. We cannot promise a search position."
  },
  {
    "question": "Can I still edit my own pages?",
    "answer": "Yes. You can edit your pages and blog with each option. We show you how it works before launch."
  },
  {
    "question": "Can you help keep the site secure?",
    "answer": "Yes. We check access to your site and plan how to keep it up to date. We explain what care it needs after launch."
  },
  {
    "question": "How long will the work take?",
    "answer": "It depends on what needs to change. We agree the scope and dates with you before work starts."
  },
  {
    "question": "Can you check a site someone else built?",
    "answer": "Yes. We can look at the site you have. We explain what works, what needs attention and what we would change."
  },
  {
    "question": "Should I rebuild or improve my site?",
    "answer": "Small fixes may be enough if the site still meets your needs. A rebuild may make more sense if it is hard to use or change."
  },
  {
    "question": "Do I have to stay on WordPress?",
    "answer": "No. We can keep WordPress or build a new site around your needs. You can still edit your own content either way."
  },
  {
    "question": "What if my site has been hacked?",
    "answer": "Get in touch and tell us what happened. We can assess the damage and discuss the next steps."
  },
  {
    "question": "Will a new site put me first on Google?",
    "answer": "No one can promise that. A useful site helps people find answers and get in touch. We focus on making it work for your customers."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "WordPress Web Design",
  description:
    "WordPress web design for businesses. Improve your current site, rebuild it or move to a new site you can edit.",
  provider: {
    "@type": "Organization",
    name: "Kaizen Web",
    url: "https://kaizenweb.co.uk",
  },
});
---

<StaticPageLayout
  path="/services/wordpress-web-design"
  title="WordPress Web Design: Fix, Rebuild or Move | Kaizen Web"
  description="Is your WordPress site slow or hard to update? We can speed it up, rebuild it properly or move you to a faster custom site, and we'll say which fits."
>
  <script type="application/ld+json" set:html={serviceSchema} is:inline />
  <script type="application/ld+json" set:html={faqSchema} is:inline />

  <!-- ═══ HERO ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        WordPress Web Design
      </p>
      <h1
        class="max-w-6xl text-balance text-4xl sm:text-5xl font-heading font-bold leading-[1.1] text-gray-950 md:text-6xl lg:text-7xl"
      >
        WordPress web design that<br />
        <span class="text-gray-400">earns its keep.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-gray-600">
        A slow, dated site can hold your business back. We can improve it or help you start fresh.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <MarketingButton action="contact" />
      </div>
    </div>
  </section>

  <!-- ═══ THE PROBLEM (Concrete + Emotional) ═══ -->
  <section class="bg-gray-950 py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow marketing-eyebrow--dark mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-500"
      >
        Make visits count
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-white md:text-5xl"
      >
        Make it easier for people<br />to choose your business.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-400">
        Your website should help people decide if you are right for them.
        Show what you do and make the next step clear.
      </p>
      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-3">
        {
          problems.map((item) => (
            <div class="border-t border-white/10 pt-8">
              <p class="text-5xl font-heading font-bold text-white md:text-6xl">
                {item.stat}
              </p>
              <p class="mt-4 text-lg leading-relaxed text-gray-400">
                {item.detail}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE THREE PATHS (Simple + Unexpected) ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        Three clear options
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
      >
        Three paths forward.<br />
        <span class="text-gray-400">One of them is yours.</span>
      </h2>
      <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-3">
        {
          paths.map((path) => (
            <article
              class={`relative flex flex-col rounded-2xl border p-8 md:p-10 ${path.tagColor === "cyan" ? "border-gray-950 bg-gray-950 text-white ring-2 ring-cyan-400/30" : "border-gray-200 bg-white text-gray-950"}`}
            >
              <span
                class={`marketing-eyebrow mb-6 inline-block self-start rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider ${
                  path.tagColor === "cyan"
                    ? "marketing-eyebrow--dark bg-cyan-400/15 text-cyan-400"
                    : "bg-gray-100 text-gray-500"
                }`}
              >
                {path.tag}
              </span>
              <p
                class={`text-sm font-medium font-body ${path.tagColor === "cyan" ? "text-gray-500" : "text-gray-400"}`}
              >
                {path.number}
              </p>
              <h3 class="mt-2 text-2xl font-heading font-bold md:text-3xl">
                {path.headline}
              </h3>
              <p
                class={`mt-4 text-lg leading-relaxed ${path.tagColor === "cyan" ? "text-gray-300" : "text-gray-600"}`}
              >
                {path.hook}
              </p>
              <p
                class={`mt-4 leading-relaxed ${path.tagColor === "cyan" ? "text-gray-400" : "text-gray-500"}`}
              >
                {path.description}
              </p>
              <div
                class={`mt-8 border-t pt-6 ${path.tagColor === "cyan" ? "border-white/10" : "border-gray-100"}`}
              >
                <p class:list={["marketing-eyebrow text-sm font-bold uppercase tracking-wider", { "marketing-eyebrow--dark": path.tagColor === "cyan" }]}>
                  Ideal for
                </p>
                <p
                  class={`mt-1 ${path.tagColor === "cyan" ? "text-gray-300" : "text-gray-600"}`}
                >
                  {path.ideal}
                </p>
              </div>
              <div class="mt-auto pt-8">
                <ContactCTAButton />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ WHY MIGRATION IS WORTH IT (Credible + Stories) ═══ -->
  <section class="bg-[#f5f5f3] py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-2">
        <div>
          <p
            class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
          >
            A real rebuild
          </p>
          <h2
            class="text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
          >
            A faster site helped<br />Midland get more enquiries.
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-gray-600">
            Midland's old site took too long to load. We rebuilt it so buyers could find the oil they needed.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-gray-600">
            The new site is faster and easier to use. The result was more enquiries in the first month.
          </p>
        </div>
        <div>
          <div class="rounded-xl bg-white p-8">
            <p class="marketing-eyebrow text-sm font-bold uppercase tracking-wider text-gray-400">
              Real result
            </p>
            <h3 class="mt-3 text-2xl font-heading font-bold text-gray-950">
              Midland Oil Group
            </h3>
            <p class="mt-1 text-lg font-heading font-bold text-cyan-600">
              More than 8 seconds → 1.2 seconds
            </p>
            <p class="mt-3 leading-relaxed text-gray-600">
              Midland has over 40 years in the oil trade. Its old site took
              <strong class="text-gray-950">more than 8 seconds</strong> to load.
              The website needed to catch up with the business.
            </p>
            <p class="mt-3 leading-relaxed text-gray-600">
              The new site loads in <strong class="text-gray-950">1.2 seconds</strong>.
              Midland saw <strong class="text-gray-950">three times the enquiries</strong>
              in the first month.
            </p>
            <MarketingButton action="caseStudy" href="/case-studies/midland-oil-group/" variant="link" className="mt-6" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PATTERN INTERRUPT (Unexpected + Emotional) ═══ -->
  <section class="bg-gray-950 py-24 md:py-32">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-5xl font-heading font-bold leading-tight text-white md:text-6xl lg:text-7xl"
        >
          See what a faster<br />
          site could do<br />
          for your business.
        </p>
        <p class="mt-8 text-xl text-gray-400">
          Start with a free chat.
        </p>
        <div class="mt-10 flex justify-center">
          <ContactCTAButton />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHICH ONE IS RIGHT FOR ME? (Practical Value + Concrete) ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="mb-16">
        <p
          class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
        >
          Which one is right for me?
        </p>
        <h2
          class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
        >
          Rebuild, improve, or start fresh?
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">
          Compare the options below. We can help you choose after a look at your site.
        </p>
      </div>

      <div class="space-y-4">
        <details class="rounded-xl border border-gray-200 bg-white p-6" open>
          <summary class="cursor-pointer text-xl font-heading font-bold text-gray-950">Pick a rebuild if your old site holds you back.</summary>
          <p class="mt-4 text-gray-600">You have tried fixes, but your site is still slow or hard to use.</p>
          <p class="mt-3 text-gray-600">We can plan a fresh design around what your customers need. You can still edit your own pages.</p>
        </details>
        <details class="rounded-xl border border-gray-200 bg-white p-6">
          <summary class="cursor-pointer text-xl font-heading font-bold text-gray-950">Pick smaller fixes if the site still suits you.</summary>
          <p class="mt-4 text-gray-600">You like the design, but some pages are slow or hard to use on a phone.</p>
          <p class="mt-3 text-gray-600">We check what is causing the problems. You get a clear plan for the work, with a price before we start.</p>
        </details>
        <details class="rounded-xl border border-gray-200 bg-white p-6">
          <summary class="cursor-pointer text-xl font-heading font-bold text-gray-950">Pick a new WordPress site if you want to keep its editor.</summary>
          <p class="mt-4 text-gray-600">You know how to use WordPress, but your current site no longer fits.</p>
          <p class="mt-3 text-gray-600">We build new pages around your business. We can make changes for you after launch too.</p>
        </details>
      </div>

      <div class="mt-16 text-center">
        <p class="text-lg text-gray-600">
          Still not sure? That's completely normal.
        </p>
        <MarketingButton action="contact" className="mt-6" />
      </div>
    </div>
  </section>

  <!-- ═══ FAQ (Credible + Practical Value) ═══ -->
  <section class="bg-[#f5f5f3] py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="mb-16">
        <p
          class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
        >
          Common questions
        </p>
        <h2 class="text-4xl font-heading font-bold text-gray-950 md:text-5xl">
          Get clear answers before you decide.
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-x-12">
        {
          faqs.map((item) => (
            <details class="rounded-xl border border-gray-200 bg-white p-6">
              <summary class="cursor-pointer text-lg font-heading font-bold text-gray-950">
                {item.question}
              </summary>
              <p class="mt-4 leading-relaxed text-gray-600">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="bg-gray-950 py-28 md:py-36">
    <div
      class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24 text-center"
    >
      <h2 class="text-4xl font-heading font-bold text-white md:text-5xl">
        Give your site<br />a clear next step.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-xl leading-relaxed text-gray-400">
        Tell us what is not working for you. We will help you decide what to do next.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <MarketingButton action="contact" />
      </div>
    </div>
  </section>
</StaticPageLayout>
