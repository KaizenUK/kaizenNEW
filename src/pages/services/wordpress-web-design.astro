---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../../client/components/ContactCTAButton";

export const prerender = true;

/* ── Three paths ─────────────────────────────────────────────── */
const paths = [
  {
    number: "01",
    headline: "Move beyond WordPress entirely",
    hook: "Same content. Same editor. But the frontend gets rebuilt with modern tools that load in under a second.",
    description:
      "We strip out everything that makes WordPress slow and rebuild the visitor-facing side with the same technology behind the fastest sites in the world. You still edit in a familiar dashboard. Your customers get a site that actually performs.",
    ideal:
      "Businesses ready to invest in the best possible version of their site.",
    cta: "Explore migration",
    tag: "Recommended",
    tagColor: "cyan",
  },
  {
    number: "02",
    headline: "Make your current WordPress site work harder",
    hook: "Sometimes the smartest move is fixing the five things costing you customers right now.",
    description:
      "We audit your site, find what's dragging it down, and fix the problems that matter most — speed, mobile experience, calls to action, content gaps. No unnecessary rebuilds. Just targeted changes you can measure.",
    ideal: "Businesses with a site that's 'okay' but not converting.",
    cta: "Request a site audit",
    tag: "Quick wins",
    tagColor: "gray",
  },
  {
    number: "03",
    headline: "A clean WordPress build, done properly",
    hook: "If WordPress is the right tool, we'll build it the way it should have been done the first time.",
    description:
      "No heavy themes. No plugin soup. Clean code, a block editor built around your workflow, and performance that doesn't embarrass you on Google. A site you can update yourself without breaking anything.",
    ideal:
      "Businesses that need WordPress — for plugins, familiarity, or budget.",
    cta: "Discuss your WordPress build",
    tag: "WordPress only",
    tagColor: "gray",
  },
];

/* ── The problem (story-driven) ──────────────────────────────── */
const problems = [
  {
    stat: "3 seconds",
    detail:
      "That's the window. After that, most customers leave. Most WordPress sites don't even finish loading in that time. And after 8 seconds, they're gone forever.",
  },
  {
    stat: "70%",
    detail:
      "of small business websites have performance issues that directly hurt their Google rankings. Yours might be one of them.",
  },
  {
    stat: "£0",
    detail:
      "is what a beautiful website earns when nobody can find it — or when they leave before it finishes loading.",
  },
];

/* ── FAQ ─────────────────────────────────────────────────────── */
const faqs = [
  {
    question: "How do I know which option is right for me?",
    answer:
      "After a quick look at your current site, we'll recommend the option that makes the most sense for your goals and budget. Sometimes that means we talk you out of a rebuild.",
  },
  {
    question: "Will I lose my Google rankings if I migrate?",
    answer:
      "No. We handle redirects, metadata, and URL structure carefully so your existing rankings carry over. Most clients see rankings improve after migration because the new site is faster.",
  },
  {
    question: "Can my team still edit the site themselves?",
    answer:
      "Yes, in all three options. Whether you stay on WordPress or move to a modern frontend, you'll have a familiar editing experience. We configure the content dashboard around how your business actually works.",
  },
  {
    question: "Is WordPress secure enough for a business site?",
    answer:
      "It can be, but most WordPress sites aren't set up securely. We harden every build — proper hosting, minimal plugins, regular updates, locked-down permissions. If security is a primary concern, option one removes most WordPress vulnerabilities entirely.",
  },
  {
    question: "How long does each option take?",
    answer:
      "Targeted improvements can start delivering results within a week or two. A full WordPress build typically takes 4–6 weeks. A migration to modern tooling takes 6–10 weeks depending on complexity.",
  },
  {
    question:
      "My current site was built by someone else and I don't know what state it's in",
    answer:
      "That's fine — it's actually the most common starting point. We'll audit what you have, give you a clear picture of where things stand, and recommend the best path forward. No judgement on what came before.",
  },
  {
    question: "Should I rebuild my WordPress site or just improve it?",
    answer:
      "It depends on what's wrong. If the core issues are speed, outdated design, or poor mobile experience, targeted improvements can make a big difference quickly. But if your site has been patched together over years with heavy themes and dozens of plugins, rebuilding — or migrating to a custom coded website — is usually the smarter long-term investment.",
  },
  {
    question:
      "What's the difference between a custom coded website and WordPress?",
    answer:
      "A custom coded website is built from scratch using modern technology. It loads faster, ranks better, and doesn't rely on plugins for core functionality. WordPress is a content management system that's flexible and familiar, but performance depends heavily on how it's built. We offer both — and we'll recommend whichever makes more sense for your situation.",
  },
  {
    question: "My WordPress site has been hacked — what should I do?",
    answer:
      "First, don't panic. We can clean up a hacked WordPress site, harden it against future attacks, and assess whether the underlying build is secure enough going forward. In some cases, migrating away from WordPress entirely is the most secure option — it removes the attack surface that plugins and themes create.",
  },
  {
    question: "Why is my WordPress site not ranking on Google?",
    answer:
      "Usually it's a combination of slow page speed, poor Core Web Vitals, thin content, and missing technical SEO basics. WordPress itself isn't the problem — but bloated themes and plugin-heavy builds create performance issues that Google penalises. We'll audit your site and tell you exactly what's holding it back.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "WordPress Web Design",
  description:
    "Custom WordPress web design, performance optimisation, and modern migration services. Three clear paths: migrate beyond WordPress, improve your current site, or get a clean new build.",
  provider: {
    "@type": "Organization",
    name: "Kaizen Web",
    url: "https://kaizenweb.co.uk",
  },
});
---

<StaticPageLayout
  path="/services/wordpress-web-design"
  title="WordPress Web Design | Custom Website vs WordPress | Kaizen Web"
  description="Should you rebuild your WordPress site, improve what you have, or migrate to a custom coded website? Three clear paths — find the right one. Fix a slow WordPress site or build something better."
>
  <script type="application/ld+json" set:html={serviceSchema} is:inline />
  <script type="application/ld+json" set:html={faqSchema} is:inline />

  <!-- ═══ HERO ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        WordPress Web Design
      </p>
      <h1
        class="max-w-4xl text-5xl font-heading font-bold leading-[1.1] text-gray-950 md:text-6xl lg:text-7xl"
