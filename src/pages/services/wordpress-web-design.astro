  <!-- ═══ WHY MIGRATION IS WORTH IT (Credible + Stories) ═══ -->
  <section class="bg-[#f5f5f3] py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
