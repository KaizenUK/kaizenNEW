      >
        Three paths forward.<br />
        <span class="text-gray-400">One of them is yours.</span>
      </h2>
      <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-3">
        {
          paths.map((path) => (
            <article
              class={`relative flex flex-col rounded-2xl border p-8 md:p-10 ${path.tagColor === "cyan" ? "border-gray-950 bg-gray-950 text-white ring-2 ring-cyan-400/30" : "border-gray-200 bg-white text-gray-950"}`}
            >
              <span
                class={`mb-6 inline-block self-start rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider ${
