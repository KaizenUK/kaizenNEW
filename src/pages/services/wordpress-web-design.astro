            >
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ THE PROBLEM (Concrete + Emotional) ═══ -->
  <section class="bg-gray-950 py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-500"
      >
        The real cost of a slow site
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-white md:text-5xl"
      >
        Every day your site loads slowly,<br />someone chooses your competitor.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-400">
        WordPress site slow to load? Visitors leave before they see what you do.<br
        />
        Not ranking on Google? The people who need you can't find you.<br />
        Both cost money. Every single day it stays like that.
      </p>
      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-3">
        {
          problems.map((item) => (
            <div class="border-t border-white/10 pt-8">
              <p class="text-5xl font-heading font-bold text-white md:text-6xl">
                {item.stat}
              </p>
              <p class="mt-4 text-lg leading-relaxed text-gray-400">
                {item.detail}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE THREE PATHS (Simple + Unexpected) ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
