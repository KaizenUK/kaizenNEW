---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";

export const prerender = true;

const calendlyUrl =
  "https://calendly.com/sean-kaizenweb/30-minute-meeting-clone";

const expertiseCards = [
  {
    title: "Headless Ecommerce",
    subtitle: "For Ultimate Performance",
    copy: "Modern React frontends with Shopify or similar backends for speed, SEO, and conversion performance.",
    bestFor:
      "Ambitious brands who need serious speed and a fully custom storefront.",
  },
  {
    title: "WordPress + WooCommerce",
    subtitle: "For Ultimate Control",
    copy: "Powerful, flexible stores with simple content and product management on familiar tools.",
    bestFor:
      "Businesses that need control over products, content, and integrations.",
  },
];

const capabilityCards = [
  {
    title: "Secure Payments",
    copy: "Stripe, PayPal, and major gateways integrated with security best practices.",
  },
  {
    title: "Easy Product Management",
    copy: "Clear admin setup and training so your team can manage catalogue and content confidently.",
  },
  {
    title: "Built to Scale",
    copy: "Technical foundations that hold up whether you run 10 products or 10,000.",
  },
];

const faqs = [
  {
    question: "Shopify or WooCommerce?",
    answer:
      "Shopify is ideal for low-maintenance growth. WooCommerce or headless is better when you need deeper custom functionality and integration control.",
  },
  {
    question: "Can you migrate data from another platform?",
    answer:
      "Yes. We migrate products, customers, and order history and protect SEO continuity during the move.",
  },
  {
    question: "Do you handle payment gateway integration?",
    answer:
      "Yes. We implement Stripe, PayPal, Apple Pay, and other providers with robust checkout flows.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});
---
<StaticPageLayout path="/services/ecommerce">
  <script type="application/ld+json" set:html={faqSchema} is:inline></script>

  <section class="relative min-h-screen overflow-hidden bg-kaizen-dark py-20 text-kaizen-text-light">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
        <div class="max-w-lg">
          <h1 class="mb-6 text-5xl font-heading font-black leading-tight md:text-6xl lg:text-7xl">
            {
              ["Shopify", "Experts", "&", "Custom", "Ecommerce"].map(
                (word) => <span class="block">{word}</span>,
              )
            }
          </h1>
          <p class="mb-8 text-lg leading-relaxed text-slate-300/90">
            Stop losing sales to slow sites. We build fast ecommerce platforms
            for Liverpool and Wirral businesses on the right stack for your
            growth stage.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-6 py-3 font-heading font-bold text-slate-900 transition hover:shadow-lg hover:shadow-kaizen-cyan/50"
            >
              Get in Touch
              <span aria-hidden="true">-&gt;</span>
            </a>
            <a
              href={calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-400/50 px-6 py-3 font-heading font-bold text-slate-300 transition hover:border-kaizen-cyan hover:text-kaizen-cyan"
            >
              Book a 15 Minute Call
              <span aria-hidden="true">-&gt;</span>
            </a>
          </div>
        </div>
        <div class="hidden md:block">
          <img
            src="https://cdn.builder.io/api/v1/image/assets%2Fe4ae46bbd81b4b95bef54d66dd9748cc%2F85912ce9f05a4f7cb336598a47962b01?format=webp&width=800"
            alt="Ecommerce delivery and fulfilment"
            width="800"
            height="600"
            class="h-full w-full rounded-2xl object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-kaizen-light py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-16 max-w-3xl">
        <h2 class="mb-8 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          Shopify Experts and Custom Ecommerce in Liverpool
        </h2>
        <p class="mb-8 text-xl leading-relaxed text-kaizen-text-dark/70">
          We build ecommerce systems that are designed to convert and designed
          to scale.
        </p>
        <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
          Whether you need headless performance, Shopify acceleration, or
          WooCommerce flexibility, we architect around commercial outcomes.
        </p>
      </div>

      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
        {
          expertiseCards.map((item) => (
            <article class="h-full rounded-2xl border border-kaizen-light bg-white p-8 transition hover:border-kaizen-cyan">
              <h3 class="mb-2 text-2xl font-heading font-bold text-kaizen-dark">
                {item.title}
              </h3>
              <p class="mb-4 text-sm font-medium text-kaizen-cyan">{item.subtitle}</p>
              <p class="mb-6 text-lg leading-relaxed text-kaizen-text-dark/70">
                {item.copy}
              </p>
              <p class="mb-2 text-sm font-bold uppercase tracking-wide text-kaizen-cyan">
                Best for
              </p>
              <p class="text-kaizen-text-dark/70">{item.bestFor}</p>
            </article>
          ))
        }
      </div>

      <div class="mx-auto mt-20 max-w-5xl overflow-hidden rounded-3xl border border-slate-700/50 bg-gradient-to-br from-slate-800 via-slate-800 to-slate-900 p-8 md:p-12">
        <h3 class="mb-6 text-3xl font-heading font-bold leading-tight text-white md:text-4xl">
          Shopify Expertise
        </h3>
        <p class="mb-6 max-w-2xl text-lg leading-relaxed text-slate-300/90">
          Theme selection, configuration, and customisation with a focus on
          conversion performance and long-term maintainability.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-3 font-heading font-bold text-kaizen-dark transition hover:opacity-90"
        >
          Explore Shopify Services
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-32">
    <div class="container mx-auto px-4">
      <h2 class="mb-16 text-center text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
        A Secure, Scalable Store. Guaranteed.
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          capabilityCards.map((item) => (
            <article class="rounded-2xl border border-kaizen-light bg-kaizen-light p-8 transition hover:border-kaizen-cyan">
              <h3 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark">
                {item.title}
              </h3>
              <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
                {item.copy}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-32">
    <div class="container mx-auto px-4">
      <h2 class="mb-12 text-center text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
        From Local Brand to National Seller
      </h2>
      <div class="mx-auto grid max-w-5xl grid-cols-1 items-center gap-12 md:grid-cols-2">
        <div class="space-y-6">
          <h3 class="text-sm font-bold uppercase tracking-wide text-kaizen-cyan">
            Client: Independent Retailer - Liverpool
          </h3>
          <div>
            <h4 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark">
              The Problem
            </h4>
            <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
              Slow mobile experience and poor resilience during peak season sales.
            </p>
          </div>
          <div>
            <h4 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark">
              The Fix
            </h4>
            <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
              Rebuilt ecommerce platform with clean architecture and smooth,
              reliable checkout flows.
            </p>
          </div>
          <div>
            <h4 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark">
              The Outcome
            </h4>
            <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
              Stable peak performance and measurable uplift in online sales.
            </p>
          </div>
        </div>
        <div class="flex h-96 items-center justify-center rounded-2xl border border-kaizen-cyan/30 bg-gradient-to-br from-kaizen-cyan/20 to-kaizen-lime/20 p-8">
          <div class="space-y-4 text-center">
            <p class="text-lg font-heading font-bold text-kaizen-text-dark/60">
              Improved Mobile Experience
            </p>
            <p class="text-sm text-kaizen-text-dark/50">
              Measurable increase in online sales
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-kaizen-light py-20 md:py-32">
    <div class="container mx-auto px-4">
      <h2 class="mb-16 text-center text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
        An Online Store is Just the Start
      </h2>
      <div class="mx-auto grid max-w-3xl grid-cols-1 gap-8 md:grid-cols-2">
        <a
          href="/services/local-seo"
          class="group block h-full rounded-2xl border border-kaizen-light bg-white p-8 transition hover:border-kaizen-cyan"
        >
          <h3 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark transition group-hover:text-kaizen-cyan">
            Local SEO
          </h3>
          <p class="mb-6 text-lg leading-relaxed text-kaizen-text-dark/70">
            Get your store found by local customers across Liverpool and Wirral.
          </p>
          <p class="font-medium text-kaizen-cyan">Explore -&gt;</p>
        </a>
        <a
          href="/agile-coaching"
          class="group block h-full rounded-2xl border border-kaizen-light bg-white p-8 transition hover:border-kaizen-cyan"
        >
          <h3 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark transition group-hover:text-kaizen-cyan">
            Agile Coaching
          </h3>
          <p class="mb-6 text-lg leading-relaxed text-kaizen-text-dark/70">
            Improve delivery cadence across your ecommerce and product teams.
          </p>
          <p class="font-medium text-kaizen-cyan">Explore -&gt;</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <div class="mb-12 text-center">
          <p class="mb-4 text-xs font-mono uppercase tracking-[0.25em] text-kaizen-cyan">
            Common Questions
          </p>
          <h2 class="text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
            Ecommerce Web Design FAQs
          </h2>
        </div>
        <div class="space-y-4">
          {
            faqs.map((item) => (
              <details class="rounded-xl border border-gray-200 bg-white p-6">
                <summary class="cursor-pointer text-lg font-heading font-bold text-kaizen-dark">
                  {item.question}
                </summary>
                <p class="mt-4 leading-relaxed text-kaizen-text-dark/70">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-kaizen-dark py-20 text-kaizen-text-light md:py-32">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-8 text-4xl font-heading font-bold md:text-5xl">
        Stop Losing Sales to a Slow Site.
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-xl leading-relaxed text-kaizen-text-light/80">
        Lets pick the right ecommerce platform for your business.
      </p>
      <div class="flex flex-col justify-center gap-6 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-3 font-heading font-bold text-kaizen-dark transition hover:opacity-90"
        >
          Get in Touch
          <span aria-hidden="true">-&gt;</span>
        </a>
        <a
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-kaizen-text-light/30 px-8 py-3 font-heading font-bold text-kaizen-text-light transition hover:border-kaizen-cyan"
        >
          Book a 15 Minute Call
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>
</StaticPageLayout>
