---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../../client/components/ContactCTAButton";

export const prerender = true;

/* ── The blind spots ────────────────────────────────────────── */
const blindSpots = [
  {
    title: "Your site's structure",
    question: "Has your SEO agency ever mentioned Information Architecture?",
    copy: "This is how your pages are organised, linked together, and prioritised. It's what tells Google which pages matter most. Get it wrong and Google spreads your ranking power thinly across everything instead of concentrating it where it counts. Most SEO agencies optimise what's on the page. They never question whether the way the site is organised is the actual problem.",
    insight: "Perfect keywords on a badly structured site still won't rank.",
  },
  {
    title: "The invisible queue",
    question: "What loads before your visitor sees anything?",
    copy: "Before anyone sees your site, their browser downloads and processes all your CSS files and JavaScript. If there's a queue of 14 stylesheets and 23 scripts, nothing appears until they're done. Your SEO report says 'slow page speed'. The real cause? A page builder dumping 400KB of code your page doesn't even use.",
    insight:
      "Google has a limited budget for processing your pages. If they're expensive to render, it may skip some entirely.",
  },
  {
    title: "Hidden code bloat",
    question: "Your About page might have more code than the BBC homepage.",
    copy: "A clean page has around 800 building blocks of code. A page-builder page? Often 3,000 to 5,000. Every one of those is something the browser has to read, arrange, and paint on screen. More code means slower scrolling, laggy buttons, and a score Google uses for ranking called INP (Interaction to Next Paint). The SEO report flags the score. Nobody looks at why it's bad.",
    insight:
      "Google says keep it under 1,400. Most theme-built pages blow past that 3 or 4 times over.",
  },
  {
    title: "Wasted crawl budget",
    question: "Is Google even bothering to look at your best pages?",
    copy: "Google gives every site a limit on how many pages it will visit. If your site has hundreds of tag pages, duplicate archives, and junk URLs — Google burns through that limit on pages that don't matter. By the time it reaches the ones you actually want ranked, it might just... not.",
    insight:
      "Tidying up your site structure can mean Google checks your important pages more often — and ranks them sooner.",
  },
  {
    title: "The page that jumps",
    question: "Does your content shift around while loading?",
    copy: "Images without set sizes, fonts swapping in, ads appearing late — they all shove your content around mid-load. It's annoying for visitors and it's something Google directly measures (called Cumulative Layout Shift). Your SEO agency reports the score. Actually fixing it means changing the code — setting image sizes, reserving space for ads, loading fonts properly.",
    insight:
      "A score above 0.1 is classed as poor. Most off-the-shelf theme sites sit between 0.15 and 0.4.",
  },
  {
    title: "Scripts you never asked for",
    question: "How many extras are slowing you down?",
    copy: "Chat widgets. Analytics. Heatmaps. Social media embeds. Cookie banners. Every one of them adds code that fights with your actual content for attention. We've looked at sites where these extras made up 70% of everything the page had to load. The SEO agency never mentioned it because they didn't know to look.",
    insight:
      "Some of these scripts add half a second to your load time on their own. That can be the difference between page one and page two.",
  },
];

/* ── The real cost comparison ───────────────────────────────── */
const costComparison = {
  retainer: {
    label: "Monthly SEO retainer",
    monthly: "£500–£2,000",
    annual: "£6,000–£24,000",
    items: [
      "Monthly reports showing the same problems",
      "Small tweaks to page descriptions",
      "Blog posts you didn't ask for",
      "Keyword tracking dashboards",
      "Link building that might help, might not",
      "The same broken site, month after month",
    ],
  },
  fix: {
    label: "Fix it once. Properly.",
    monthly: "£0 after",
    annual: "One-off investment",
    items: [
      "Site fixed or rebuilt at the code level",
      "Google's speed checks passing on every page",
      "A structure that tells Google what matters",
      "Data markup Google can actually read",
      "Mobile experience that turns visitors into customers",
      "A foundation that gets stronger over time",
    ],
  },
};

/* ── DNH protocol ───────────────────────────────────────────── */
const dnhSteps = [
  {
    step: "01",
    title: "Snapshot everything first",
    copy: "Before we change a thing, we record every page, every URL, every redirect, and where you currently rank. This is your safety net.",
  },
  {
    step: "02",
    title: "Map every redirect",
    copy: "If a URL changes, we set up a permanent redirect to the new one. Every backlink, every bookmark, every Google result — they all still work. Nothing goes missing.",
  },
  {
    step: "03",
    title: "Carry over your data",
    copy: "All the structured information Google knows about your business — your markup, your social tags, your page descriptions — gets carried over or rebuilt properly. Google's understanding of who you are stays intact.",
  },
  {
    step: "04",
    title: "Watch it after launch",
    copy: "We keep an eye on Search Console and crawl errors after going live. If anything slips, we catch it fast. Your SEO agency should see improvements, not surprises.",
  },
];

/* ── FAQ ─────────────────────────────────────────────────────── */
const faqs = [
  {
    question: "Do I actually need ongoing SEO to rank locally?",
    answer:
      "Not always. If your site is fast, well-structured, mobile-friendly, and has proper data markup — Google can do its job without help. Plenty of businesses rank well locally without a monthly SEO spend, because the site itself does the heavy lifting. Ongoing SEO makes sense in competitive industries, but it should build on a solid foundation — not compensate for a broken one.",
  },
  {
    question: "Why isn't my site ranking even though I'm paying for SEO?",
    answer:
      "Usually because the SEO work sits on top of a site with fundamental technical problems. Slow speed, poor mobile experience, missing data markup, bad structure. Those undermine everything else. We fix the foundation so the SEO work you're already paying for can actually take effect.",
  },
  {
    question: "What is Information Architecture?",
    answer:
      "It's how your site's content is structured and connected — your URL layout, internal links, navigation, and page groupings. Google uses it to understand which pages matter most and how topics relate to each other. Poor structure means Google can't figure out what your site is about, so it spreads your ranking power thinly instead of concentrating it where it counts.",
  },
  {
    question: "What are Core Web Vitals?",
    answer:
      "Google's way of scoring three things: how fast your site loads, how quickly it responds when someone taps something, and how stable the layout is while loading. They're a direct ranking factor. Most sites built with heavy themes or page builders fail these checks because of bloated code, unoptimised images, and scripts that block the page from appearing.",
  },
  {
    question: "Will I lose my rankings if you change my site?",
    answer:
      "No. We follow a Do No Harm protocol — every URL is mapped, every redirect is handled, all your data markup is preserved or improved. We snapshot your rankings before we start and monitor them after launch. Everything you've built up stays intact. The technical improvements just let it work harder.",
  },
  {
    question: "Can I keep my SEO agency?",
    answer:
      "Absolutely — and they'll probably thank you. SEO agencies do their best work when the site underneath is fast, well-structured, and technically sound. We handle the code-level stuff they can't (or won't), and their content, strategy, and link building suddenly becomes far more effective.",
  },
  {
    question: "What does the SEO agency vetting involve?",
    answer:
      "We review the work your current agency has done — what they've changed, what they're reporting, and whether it's actually moved the needle. We'll tell you if they're doing solid work, if the reports are just vanity metrics, or if there are gaps. Think of it as a second opinion from someone who understands the technical side.",
  },
  {
    question: "How long until I see results?",
    answer:
      "Google recrawls most sites within days of a speed improvement. You'll typically see the speed scores improve in Search Console within about a month. Ranking movement varies, but clients often see things shift within 4–8 weeks. Unlike retainer-based SEO, the fixes compound over time — they don't stop working when you stop paying.",
  },
  {
    question: "How is this different from what my SEO agency does?",
    answer:
      "They optimise content, build links, and track rankings — they work with what the site gives them. We work on the site itself — the code, the structure, the speed, the data markup. They're decorating the house. We're fixing the foundations.",
  },
  {
    question: "Is a monthly retainer ever worth it?",
    answer:
      "In competitive industries, yes — ongoing SEO can be valuable. But only on top of a technically sound site. If your agency is spending half their time working around your site's limitations, that's money going toward patching problems rather than building on strengths. Fix the site first. Then decide if you still need monthly support.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Local SEO Technical Foundations",
  description:
    "Technical website fixes that improve local search rankings — page speed, Core Web Vitals, Information Architecture, structured data, mobile optimisation, and Google Business Profile setup.",
  provider: {
    "@type": "Organization",
    name: "Kaizen Web",
    url: "https://kaizenweb.co.uk",
  },
});
