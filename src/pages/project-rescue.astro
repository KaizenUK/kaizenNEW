---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;

const calendlyUrl =
  "https://calendly.com/sean-kaizenweb/30-minute-meeting-clone";

const symptoms = [
  "You've spent serious money but don't have usable software to show for it.",
  "Deadlines keep slipping and nobody can clearly explain why.",
  "Every change request turns into an argument about scope.",
  "Stakeholders have lost confidence in the delivery team.",
  "The backlog is a mess with no clear priorities.",
  "Stand-ups are status updates, not problem-solving sessions.",
  "You're paying developers who seem blocked.",
  "The project feels out of control and you've lost visibility.",
];

const processSteps = [
  {
    step: "01",
    title: "Rapid Audit",
    content:
      "Review scope, backlog, and architecture. Output: diagnosis and priority list.",
  },
  {
    step: "02",
    title: "Stabilise & Replan",
    content:
      "Step in as senior product leadership. Set realistic goals, clean the backlog, and restore decision clarity.",
  },
  {
    step: "03",
    title: "Deliver & Hand Over",
    content:
      "Run focused delivery cycles and leave behind a clear roadmap with sustainable rituals.",
  },
];

const interventions = [
  "Own and prioritise the backlog with clear product authority.",
  "Set up sprint planning, reviews, and stand-ups that solve blockers.",
  "Translate between stakeholders and engineers without losing technical detail.",
  "Leave behind a sustainable way of working.",
  "Remove blockers and make fast, auditable decisions.",
  "Rebuild stakeholder confidence with visible, predictable progress.",
];

const faqs = [
  {
    question: "How do you audit code so quickly?",
    answer:
      "We combine experienced technical review with AI-assisted diagnostics to identify risks, blockers, and debt in hours rather than weeks.",
  },
  {
    question: "Can you fix legacy code?",
    answer:
      "Yes. We modernise legacy platforms incrementally where possible, without forcing a full rebuild unless economics clearly justify it.",
  },
  {
    question: "How quickly can you start?",
    answer:
      "Most rescue audits can start within 48 hours, with an initial triage output delivered immediately after.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});
---

<StaticPageLayout
  path="/project-rescue"
  title="Software Project Rescue | Senior Product Leadership | Kaizen"
  description="When your build is over budget, late, or stuck, Kaizen steps in as senior product leadership to stabilise delivery, restore control, and ship."
>
  <script type="application/ld+json" set:html={faqSchema} is:inline></script>

  <section class="relative min-h-screen overflow-hidden bg-slate-950 py-20 text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,255,255,0.1),transparent_50%)]"></div>
    <div class="pointer-events-none absolute right-10 top-20 h-96 w-96 rounded-full bg-kaizen-cyan/10 blur-3xl"></div>
    <div class="pointer-events-none absolute bottom-20 left-10 h-96 w-96 rounded-full bg-kaizen-lime/10 blur-3xl"></div>

    <div class="container relative mx-auto px-4">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-xs font-mono uppercase tracking-[0.25em] text-kaizen-cyan">
          Hands-On Product Leadership
        </p>
        <h1 class="mb-8 text-5xl font-heading font-black leading-tight md:text-7xl">
          Software Project Rescue Services
        </h1>
        <p class="mx-auto mb-6 max-w-3xl text-xl leading-relaxed text-white/80 md:text-2xl">
          When your build is over budget, late, or stuck, we step in as senior
          product leadership to stabilise delivery, restore control, and ship.
          No theatre. No waffle.
        </p>

        <div class="mx-auto mb-8 max-w-3xl rounded-2xl border border-white/10 bg-white/5 p-6 text-left backdrop-blur-sm">
          <p class="mb-2 text-xs font-mono uppercase tracking-widest text-kaizen-cyan">
            Proof, not promises
          </p>
          <p class="leading-relaxed text-white/85">
            We led a complex rescue and transformation for a
            <strong> high-scale gaming platform</strong>, delivering
            compliance-safe product architecture and Live Ops governance.
          </p>
          <a
            href="/case-studies/high-five-games/"
            class="mt-4 inline-flex items-center gap-2 font-semibold text-kaizen-cyan transition hover:text-white"
          >
            Read the case study
            <span aria-hidden="true">-&gt;</span>
          </a>
        </div>

        <p class="mx-auto mb-10 max-w-3xl text-base leading-relaxed text-white/80 md:text-lg">
          Thinking of restarting? Before you spend another penny, read our
          <a
            href="/blog/fix-failing-software-project-financial-guide"
            class="underline decoration-2 underline-offset-4 hover:text-kaizen-cyan"
          >
            financial guide to rescue vs rebuild
          </a>
          and decide with clear economics.
        </p>

        <a
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-4 font-heading font-bold text-lg text-kaizen-dark transition hover:shadow-lg hover:shadow-kaizen-cyan/50"
        >
          Book a Project Triage Call
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mb-16 text-center">
        <h2 class="mb-6 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          Is your project going off the rails?
        </h2>
        <p class="mx-auto max-w-2xl text-xl text-kaizen-text-dark/70">
          If any of these sound familiar, you need Project Rescue.
        </p>
      </div>
      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
        {
          symptoms.map((symptom) => (
            <div class="flex items-start gap-4 rounded-xl border border-red-200 bg-red-50 p-6">
              <p class="text-base font-medium text-kaizen-dark">{symptom}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-kaizen-light py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mb-16 text-center">
        <h2 class="text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          How Project Rescue Works
        </h2>
      </div>
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-3">
        {
          processSteps.map((item) => (
            <article class="rounded-2xl border border-kaizen-light bg-white p-8">
              <p class="mb-4 text-6xl font-heading font-black text-kaizen-cyan/20">
                {item.step}
              </p>
              <h3 class="mb-4 text-2xl font-heading font-bold text-kaizen-dark">
                {item.title}
              </h3>
              <p class="text-base leading-relaxed text-kaizen-text-dark/70">
                {item.content}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mb-16 text-center">
        <h2 class="mb-6 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          Expert Intervention
        </h2>
        <p class="mx-auto max-w-2xl text-xl text-kaizen-text-dark/70">
          What we actually do when we step in.
        </p>
      </div>
      <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 md:grid-cols-2">
        {
          interventions.map((item) => (
            <div class="flex items-start gap-4 rounded-xl bg-kaizen-light p-6">
              <p class="text-base font-medium text-kaizen-dark">{item}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-8 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          Comprehensive Software Project Rescue Services
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-kaizen-text-dark/70">
          Our rescue process is about more than fixing bugs. It's about securing
          your asset and restoring delivery confidence.
        </p>
        <div class="space-y-4">
          <div>
            <h3 class="mb-2 text-lg font-heading font-bold text-kaizen-dark">
              Code Audits & Triage
            </h3>
            <p class="text-base text-kaizen-text-dark/70">
              Identify technical risk, debt, and immediate blockers quickly.
            </p>
          </div>
          <div>
            <h3 class="mb-2 text-lg font-heading font-bold text-kaizen-dark">
              Legacy System Modernisation
            </h3>
            <p class="text-base text-kaizen-text-dark/70">
              Move off outdated stacks safely without losing business-critical data.
            </p>
          </div>
          <div>
            <h3 class="mb-2 text-lg font-heading font-bold text-kaizen-dark">
              Vendor Handover
            </h3>
            <p class="text-base text-kaizen-text-dark/70">
              Take control back from an underperforming supplier with a clean transition.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <div class="mb-12 text-center">
          <p class="mb-4 text-xs font-mono uppercase tracking-[0.25em] text-kaizen-cyan">
            Common Questions
          </p>
          <h2 class="text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
            Project Rescue FAQs
          </h2>
        </div>
        <div class="space-y-4">
          {
            faqs.map((item) => (
              <details class="rounded-xl border border-gray-200 bg-white p-6">
                <summary class="cursor-pointer text-lg font-heading font-bold text-kaizen-dark">
                  {item.question}
                </summary>
                <p class="mt-4 leading-relaxed text-kaizen-text-dark/70">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-kaizen-light py-20 md:py-32">
    <div class="container mx-auto px-4">
      <div class="mb-16 text-center">
        <h2 class="text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
          Is this right for you?
        </h2>
      </div>
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-2">
        <article class="rounded-2xl border-2 border-green-300 bg-green-50 p-8">
          <h3 class="mb-6 text-2xl font-heading font-bold text-kaizen-dark">
            Best Fit
          </h3>
          <ul class="space-y-3 text-base text-kaizen-dark">
            <li>✓ You have dev/design resources but lack leadership.</li>
            <li>✓ The project is commercially critical.</li>
            <li>✓ You are open to changing workflows.</li>
            <li>✓ You need someone to own the backlog and decisions.</li>
            <li>✓ You want to ship working software, not manage chaos.</li>
          </ul>
        </article>
        <article class="rounded-2xl border-2 border-red-300 bg-red-50 p-8">
          <h3 class="mb-6 text-2xl font-heading font-bold text-kaizen-dark">
            Not a Fit
          </h3>
          <ul class="space-y-3 text-base text-kaizen-dark">
            <li>✗ You are shopping for the cheapest build.</li>
            <li>✗ You are not open to changing workflows.</li>
            <li>✗ You want a fixed-price miracle.</li>
            <li>✗ You need a team to build everything from scratch.</li>
            <li>✗ You need marketing support, not delivery leadership.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-slate-950 py-20 text-white md:py-32">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,255,255,0.1),transparent_50%)]"></div>
    <div class="container relative mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-6 text-4xl font-heading font-bold md:text-5xl">
          Stop the bleeding. Start shipping.
        </h2>
        <p class="mb-12 text-xl leading-relaxed text-white/80">
          Book a free 30-minute triage call. We'll diagnose and tell you
          honestly if we can help.
        </p>
        <a
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-4 font-heading font-bold text-lg text-kaizen-dark transition hover:shadow-lg hover:shadow-kaizen-cyan/50"
        >
          Book a Free 30-Minute Triage Call
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>
</StaticPageLayout>
