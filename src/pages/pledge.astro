---
import { MarketingButton } from "../../client/components/untitled/MarketingButton";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../client/components/ContactCTAButton";

export const prerender = true;

/* ── Commitments ──────────────────────────────────────────── */
const commitments = [
  {
    num: "01",
    title: "AI is a tool, not a shortcut.",
    copy: "Yes, Kaizen uses AI. It handles the repetitive work so more time goes into the things that actually matter — your strategy, your design, your site's architecture. A prompt can't understand your customers or design a brand. It can save hours on the grunt work so the thinking gets the attention it deserves.",
  },
  {
    num: "02",
    title: "The quote is the quote.",
    copy: "The price agreed is the price you pay. If the work takes longer than expected, that's not your problem. The only thing that changes the number is if the scope changes — and that's always a conversation, never a surprise on an invoice.",
  },
  {
    num: "03",
    title: "30 days of snagging. Free.",
    copy: "After launch, you get 30 days where any bug or issue gets fixed at no extra cost. Minor tweaks within reason are included too. If something bigger comes up, you'll know whether it's a fix or a new feature before any work starts.",
  },
  {
    num: "04",
    title: "Sometimes the answer is no.",
    copy: "Not every project is the right fit. If Kaizen isn't the right choice for what you need, you'll hear that upfront — not three weeks into a project that's going sideways. The same goes the other way. This works best when both sides are genuinely invested.",
  },
];
---

<StaticPageLayout
  path="/pledge"
  title="What to Expect Before You Commit | The Kaizen Pledge"
  description="What working with Kaizen looks like, in writing, before you commit to anything: how pricing works, how we use AI and what happens if the scope changes."
>
  <!-- ═══ HERO ═══ -->
  <section class="marketing-section relative bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          The pledge
        </p>
        <h1
          class="text-balance text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          <span class="block text-balance">Here's what you can expect.</span>
          <span class="block text-balance text-gray-400">Before you commit to anything.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          Most agencies talk about transparency. This page actually does it.
          No spin, no small print — just how this works, written down so
          you can hold Kaizen to it.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ COMMITMENTS ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
        >
          What you're signing up for
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight"
        >
          No surprises.<br />On either side.
        </h2>
      </div>

      <div class="space-y-0">
        {
          commitments.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0",
                i < commitments.length - 1 && "border-b border-white/10",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-kaizen-cyan tracking-wide block mb-2">
                  {item.num}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                  {item.copy}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE SHORT VERSION ═══ -->
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          The short version.
        </h2>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          You'll know what's happening, what it costs, and what you're getting —
          at every stage. If something changes, you'll hear about it before it
          hits your inbox. That's it. That's the pledge.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-balance text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          <span class="block text-balance">Now you know how this works.</span>
          <span class="block text-balance text-gray-500">Ready to see if it fits?</span>
        </h2>
        <p class="text-lg md:text-xl text-white/50 font-body leading-relaxed mb-14 max-w-2xl">
          A quick conversation is the easiest way to find out. No pitch deck,
          no pressure — just a proper look at what you need and whether Kaizen
          is the right fit.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <ContactCTAButton />
          <MarketingButton action="speed" />
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
