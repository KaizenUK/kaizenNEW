---
import { MarketingButton } from "../../client/components/untitled/MarketingButton";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;

/* ── Commitments ──────────────────────────────────────────── */
const commitments = [
  {
    num: "01",
    title: "Your business guides the work.",
    copy: "We use AI to help with routine tasks. We plan the site around what your customers need. We check the work before it goes live.",
  },
  {
    num: "02",
    title: "You agree the price first.",
    copy: "We agree the work and price before we start. Extra time on that work does not change your quote. If you want more work, we agree a new price first.",
  },
  {
    num: "03",
    title: "Report a fault within 30 days.",
    copy: "Tell us about faults in our work within 30 days of launch. We fix them at no extra cost. Small tweaks within reason are included too. For a bigger change, we agree the cost before work starts.",
  },
  {
    num: "04",
    title: "We tell you if we can help.",
    copy: "We talk through what your website needs before you commit. If we are not the right fit, we will tell you before work starts.",
  },
];
---

<StaticPageLayout
  path="/pledge"
  title="What to Expect Before You Commit | The Kaizen Pledge"
  description="What working with Kaizen looks like, in writing, before you commit to anything: how pricing works, how we use AI and what happens if the scope changes."
>
  <!-- ═══ HERO ═══ -->
  <section class="marketing-section relative bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          The Kaizen pledge
        </p>
        <h1
          class="text-balance text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          <span class="block text-balance">Know what to expect.</span>
          <span class="block text-balance text-gray-500">Before we build your website.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 font-body leading-relaxed">
          Your business should know what its new website will cost.
          We agree the work and price before you commit.
        </p>
        <div class="mt-6">
          <MarketingButton action="contact" />
          <p class="mt-4 max-w-md font-body text-sm leading-relaxed text-gray-600">
            One of us will get back to you the same day, or the next working day at the latest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ COMMITMENTS ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
        >
          How we work
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight"
        >
          Agree the work<br />before we start.
        </h2>
      </div>

      <div class="space-y-0">
        {
          commitments.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0",
                i < commitments.length - 1 && "border-b border-white/10",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-kaizen-cyan tracking-wide block mb-2">
                  {item.num}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                  {item.copy}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE SHORT VERSION ═══ -->
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          You can ask before you decide.
        </h2>
        <p class="text-lg md:text-xl text-gray-600 font-body leading-relaxed">
          Ask us about anything you are unsure of. We explain what the quote covers before you pay.
          Work starts after a non-refundable deposit.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-balance text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          <span class="block text-balance">Talk through your plans.</span>
          <span class="block text-balance text-gray-500">Start with a free chat.</span>
        </h2>
        <p class="text-lg md:text-xl text-white/50 font-body leading-relaxed mb-8 max-w-2xl">
          Tell us what your site needs to do. We will explain where we can help.
        </p>

        <div>
          <MarketingButton action="contact" />
          <p class="mt-4 max-w-md font-body text-sm leading-relaxed text-white/70">
            One of us will get back to you the same day, or the next working day at the latest.
          </p>
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
