---
import { Button } from "../../client/components/untitled/base/buttons/button";
import { contactResponse } from "../../client/components/untitled/MarketingButton";
import { ArrowRight } from "lucide-react";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;
const recommendedReads = [
  { title: "5 Website Mistakes You Can Check on Your Own Site", slug: "website-mistakes-liverpool", description: "Try five checks on your pages and contact form." },
  { title: "How Much Does a Website Cost? A Guide to Quotes", slug: "how-much-does-a-website-cost-in-liverpool-in-2025", description: "See what to look for when you compare website quotes." },
  { title: "How to Choose a Web Designer", slug: "choose-web-design-agency-liverpool", description: "Questions to ask before you agree to the work." },
];
---

<StaticPageLayout path="/thank-you" robots="noindex, follow">
  <section class="marketing-section bg-uui-dark text-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <h1 class="text-balance font-heading text-4xl font-bold md:text-5xl lg:text-6xl">Thanks for getting in touch.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">{contactResponse}</p>
        <Button href="/" color="secondary" size="lg" className="mt-7">Back to home</Button>
      </div>
      <div class="mt-10 border-t border-slate-600 pt-8 lg:mt-14 lg:pt-10">
        <h2 class="font-heading text-3xl font-bold md:text-4xl">Make your next website choice clearer.</h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">These guides can help while you wait for a reply.</p>
        <div class="mt-7 grid gap-6 md:grid-cols-3">
          {recommendedReads.map((read) => (
            <a href={`/blog/${read.slug}/`} class="group block rounded-2xl border border-slate-600 p-6 outline-offset-4 transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-uui-brand-200">
              <h3 class="font-heading text-2xl font-bold text-white">{read.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-slate-300">{read.description}</p>
              <ArrowRight className="mt-5 size-5 text-uui-brand-200" aria-hidden="true" />
            </a>
          ))}
        </div>
        <div class="mt-7 flex flex-wrap gap-x-8 gap-y-4 text-base font-semibold text-uui-brand-200">
          <a href="/services/wordpress-web-design/" class="underline underline-offset-4 hover:text-white">Compare our website rebuild options</a>
          <a href="/blog/" class="underline underline-offset-4 hover:text-white">Browse all website guides</a>
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
