---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";

export const prerender = true;

const builtWith = ["React", "Headless WordPress", "Local SEO"];

const outcomes = [
  {
    value: "100%",
    label: "Performance Score",
    copy: "Google Lighthouse score tuned for speed and discoverability.",
  },
  {
    value: "Zero",
    label: "Booking Friction",
    copy: "A cleaner flow from social traffic to confirmed appointments.",
  },
  {
    value: "#1",
    label: "Local Ranking",
    copy: "Dominant visibility for key Wallasey and Wirral service terms.",
  },
];
---

<StaticPageLayout
  path="/case-studies/helen-moore-hairdressing"
  title="Wirral Web Design Case Study: Helen Moore | Kaizen"
  description="How we transformed a Wirral salon website into a faster, conversion-focused booking experience with stronger local SEO."
>
  <section class="bg-white">
    <div class="grid min-h-[75vh] grid-cols-1 lg:grid-cols-2">
      <div class="relative h-72 overflow-hidden lg:h-auto">
        <img
          src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1674&auto=format&fit=crop"
          alt="Helen Moore Hairdressing salon interior"
          width="1674"
          height="1116"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="flex items-center px-6 py-16 lg:px-16">
        <div class="max-w-xl">
          <a href="/case-studies" class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-slate-900">
            <span aria-hidden="true">&larr;</span>
            Back to Case Studies
          </a>
          <p class="mb-4 text-xs font-mono font-bold uppercase tracking-[0.2em] text-rose-500">The Salon Experience</p>
          <h1 class="mb-6 text-5xl font-heading font-black leading-tight text-slate-900 md:text-6xl">Helen Moore Hairdressing</h1>
          <div class="space-y-4 text-lg leading-relaxed text-slate-600">
            <p>
              Helen Moore is a well-known salon brand in Wallasey, but the previous website was slow, dated, and weak on mobile.
            </p>
            <p>
              We rebuilt the site with a modern frontend and clear local-search structure, so social visitors can move from scroll to
              booking without unnecessary steps.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            {
              builtWith.map((item) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{item}</span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          outcomes.map((item) => (
            <article class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm">
              <h2 class="mb-1 text-4xl font-heading font-bold text-slate-900">{item.value}</h2>
              <p class="mb-3 text-xs font-mono font-bold uppercase tracking-wider text-slate-400">{item.label}</p>
              <p class="text-sm text-slate-600">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-900 py-20 text-white">
    <div class="container mx-auto max-w-4xl px-4 text-center">
      <h2 class="mb-6 text-4xl font-heading font-bold md:text-5xl">Want a site that performs like this?</h2>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-white/75">
        If your current site gets traffic but not enough bookings, we can rebuild the experience around speed, trust, and local intent.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3 font-heading font-bold text-slate-900 transition hover:bg-slate-100"
      >
        Get a Quote Like This
        <span aria-hidden="true">-&gt;</span>
      </a>
    </div>
  </section>

  <section class="border-t border-slate-100 bg-white py-12">
    <div class="container mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 text-sm font-medium">
      <a href="/case-studies/as-collections" class="text-slate-900 transition hover:text-rose-500">&larr; Previous Case Study</a>
      <a href="/case-studies" class="text-slate-500 transition hover:text-slate-900">View All</a>
      <a href="/case-studies/kaizen-rebuild" class="text-slate-900 transition hover:text-rose-500">Next Case Study &rarr;</a>
    </div>
  </section>
</StaticPageLayout>
