---
export const prerender = true;

Astro.response.status = 410;
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Page Removed | Kaizen Web</title>
  <style>
    body { font-family: 'DM Sans', system-ui, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #030712; color: #fff; }
    .wrap { text-align: center; max-width: 480px; padding: 2rem; }
    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem; }
    p { color: rgba(255,255,255,0.5); line-height: 1.6; margin-bottom: 2rem; }
    a { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
    a:hover { color: rgba(255,255,255,0.7); }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>This page has been removed.</h1>
    <p>The case study you're looking for is no longer available.</p>
    <a href="/case-studies/">View our case studies</a>
  </div>
</body>
</html>
