---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";
import { MarketingButton, contactResponse } from "../../../client/components/untitled/MarketingButton";
import { MetricsBlock } from "../../../client/components/untitled/proof/MetricsBlock";
import StudyImage from "../../components/case-studies/StudyImage.astro";
import ImageLightbox from "../../../client/components/ImageLightbox";

export const prerender = true;
const imageRoot = "/images/case-studies/midland-oil-group/";
const details = [
  { title: "See where each menu link leads", copy: "The menus explain what each section holds. Buyers can see the choices before they open a page.", image: "mog-mega-nav.webp", alt: "Midland menu with industry links and short descriptions", width: 2542, height: 415, caption: "Industry choices have a short, useful description." },
  { title: "Find the services as well as the oil", copy: "Waste oil collection now has its own place on the site. It sits alongside blending and the other oil services.", image: "mog-services-hub.webp", alt: "Midland website page listing its oil services", width: 2533, height: 1296, caption: "Buyers can see the full range of oil services." },
  { title: "Choose a brand and find its range", copy: "Each Midland brand has its own area. Buyers can see what it offers and find the right product range.", image: "mog-brands-on-homepage.webp", alt: "Midland brands with links to their product ranges", width: 1684, height: 403, caption: "Each brand has a clear place on the homepage." },
  { title: "Search for the right data sheet", copy: "Buyers can search for the data sheet they need. They can check the details before they choose a product.", image: "mog-technical-library.webp", alt: "Midland data sheet search with product filters", width: 1719, height: 1126, caption: "Search and filters help buyers find product details." },
  { title: "Check the company behind the products", copy: "Company details and certificates are easy to find. Buyers can check who they are dealing with before they get in touch.", image: "mog-footer-with-iso.webp", alt: "Midland website footer with company details and certificate links", width: 1662, height: 636, caption: "The footer puts company details and documents together." },
];
---

<StaticPageLayout
  path="/case-studies/midland-oil-group/"
  title="Midland Oil Group Case Study | Kaizen Web"
  description="How we rebuilt Midland Oil Group's website to help buyers find the right oil. Real before-and-after screens, an oil finder and three times the enquiries."
>
  <section class="marketing-section bg-slate-50">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <a href="/case-studies/" class="mb-7 inline-block text-sm font-semibold text-uui-brand-800 underline underline-offset-4">All website case studies</a>
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
        <div>
          <p class="marketing-eyebrow mb-4">Web design for trade and industry</p>
          <h1 class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl lg:text-6xl">Midland Oil Group.<br /><span class="text-uui-brand-800">A clearer path to the right oil.</span></h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">Midland's old site made choosing oil hard. We rebuilt it so buyers could find products and send an enquiry.</p>
          <div class="mt-7">
            <MarketingButton action="contact" />
            <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
          </div>
        </div>
        <StudyImage src={imageRoot + "mog-new-homepage.webp"} alt="The rebuilt Midland Oil Group homepage with industry choices" width={2550} height={1312} caption="The new site gives buyers a clear place to start." eager />
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section--compact border-y border-slate-200 bg-white" aria-labelledby="midland-result-heading">
    <div class="mx-auto grid max-w-[1440px] gap-9 px-6 lg:grid-cols-2 lg:gap-16 lg:px-12">
      <div>
        <h2 id="midland-result-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">More visits turn into real enquiries.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">Since the rebuild, Midland gets several genuine enquiries a day. A large national business has also shown interest.</p>
        <p class="mt-3 text-sm leading-6 text-slate-600">These are Midland's results. They are not a promise for every site.</p>
      </div>
      <MetricsBlock showSourceLink={false} />
    </div>
  </section>

  <section class="marketing-section bg-slate-50" aria-labelledby="midland-before-heading">
    <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-6 lg:grid-cols-2 lg:gap-16 lg:px-12">
      <div>
        <p class="marketing-eyebrow mb-4">Before the rebuild</p>
        <h2 id="midland-before-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Good products were hard to find.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Midland makes and supplies oil in the West Midlands. It has more than 40 years in the trade.</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">The old site expected buyers to know product names. Services were hard to spot, and data sheets sat in a long list.</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">People needed to call to work out where to start.</p>
      </div>
      <StudyImage src={imageRoot + "mog-old-homepage.webp"} alt="The old Midland Oil Group homepage with its product list" width={2544} height={1313} caption="The old site left buyers to work out which range they needed." />
    </div>
  </section>

  <section class="marketing-section bg-white" aria-labelledby="midland-industry-heading">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="mb-9 grid gap-5 lg:grid-cols-2 lg:gap-16">
        <h2 id="midland-industry-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Start with the work.<br />Then find the oil.</h2>
        <p class="max-w-xl text-lg leading-relaxed text-slate-600">Buyers choose their industry first. The site then shows products that fit that kind of work. They do not need to know a product code.</p>
      </div>
      <StudyImage src={imageRoot + "mog-new-sectors.webp"} alt="Midland oil products grouped for farming customers" width={2537} height={1228} caption="The farming pages bring the relevant oils into one place." />
    </div>
  </section>

  <section class="marketing-section bg-uui-dark text-white" aria-labelledby="midland-finder-heading">
    <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-6 lg:grid-cols-[1fr_0.8fr] lg:gap-24 lg:px-12">
      <div>
        <p class="marketing-eyebrow marketing-eyebrow--dark mb-4">Ask MOG oil finder</p>
        <h2 id="midland-finder-heading" class="text-balance font-heading text-4xl font-bold md:text-5xl">Find a starting point without a phone call.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">The oil finder asks about the vehicle, machine or job. It then suggests a product from the range.</p>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-300">Buyers can narrow down the choice before they contact Midland.</p>
        <p class="mt-6 border-l-2 border-uui-brand-300 pl-4 text-sm leading-6 text-slate-300">Oil finder provided on licence by Kaizen.</p>
      </div>
      <div class="mx-auto w-full max-w-sm">
        <StudyImage src={imageRoot + "mog-ask-mog.webp"} alt="Ask MOG oil finder showing vehicle and machine choices" width={543} height={701} caption="A useful first step for buyers who do not know the range." onDark />
      </div>
    </div>
  </section>

  <section class="marketing-section bg-slate-50" aria-labelledby="midland-details-heading">
    <div class="mx-auto grid max-w-[1440px] items-start gap-9 px-6 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16 lg:px-12">
      <div>
        <h2 id="midland-details-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">The details help buyers choose.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Open each example to see how the rest of the site works.</p>
        <a href="https://midlandoilgroup.co.uk/" class="mt-6 inline-block font-semibold text-uui-brand-800 underline underline-offset-4" rel="noopener" target="_blank">Visit Midland Oil Group's website</a>
      </div>
      <div class="min-w-0 divide-y divide-slate-200 border-y border-slate-200">
        {details.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 rounded-sm font-heading text-xl font-bold text-uui-dark outline-offset-4 focus-visible:outline-2 focus-visible:outline-uui-brand-500 [&::-webkit-details-marker]:hidden">
              {item.title}
              <svg class="size-5 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="pt-5">
              <p class="mb-6 text-base leading-relaxed text-slate-600">{item.copy}</p>
              <StudyImage src={imageRoot + item.image} alt={item.alt} width={item.width} height={item.height} caption={item.caption} />
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="marketing-section bg-white" aria-labelledby="midland-contact-heading">
    <div class="mx-auto grid max-w-[1440px] gap-8 px-6 lg:grid-cols-2 lg:gap-16 lg:px-12">
      <div>
        <p class="marketing-eyebrow mb-4">Your website</p>
        <h2 id="midland-contact-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Help buyers find what they need.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">We rebuild dated, slow websites for businesses. The first chat is free, so we can talk through what needs to change.</p>
        <div class="mt-7">
          <MarketingButton action="contact" />
          <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
        </div>
      </div>
      <div class="self-center rounded-2xl border border-slate-200 bg-slate-50 p-7 md:p-9">
        <h3 class="font-heading text-2xl font-bold text-uui-dark">See what a rebuild involves.</h3>
        <p class="mt-4 text-base leading-relaxed text-slate-600">We agree the price before work starts. A non-refundable deposit comes before the first draft.</p>
        <ul class="mt-6 space-y-4 font-semibold text-uui-brand-800">
          <li><a href="/services/wordpress-web-design/" class="underline underline-offset-4">Compare our website rebuild options</a></li>
          <li><a href="/pledge/" class="underline underline-offset-4">Read our promises before you pay</a></li>
          <li><a href="/case-studies/helen-moore-hairdressing/" class="underline underline-offset-4">See Helen Moore's salon website story</a></li>
        </ul>
      </div>
    </div>
  </section>
  <ImageLightbox client:load />
</StaticPageLayout>
