---
import { Button } from "../../../client/components/untitled/base/buttons/button";
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../../client/components/ContactCTAButton";
import ImageLightbox from "../../../client/components/ImageLightbox";

export const prerender = true;

/* ── Before / After ─────────────────────────────────────────── */
const beforeProblems = [
  {
    "label": "Hard to choose a product",
    "copy": "Visitors knew their machine or industry. They did not always know the product name. The site gave them little help with that choice."
  },
  {
    "label": "Useful services were hard to find",
    "copy": "Waste oil collection was easy to miss. Buyers could leave without knowing Midland offered what they needed."
  },
  {
    "label": "Questions became phone calls",
    "copy": "People had to call to ask which oil to use. The site could not guide them to a product."
  },
  {
    "label": "Proof was missing from the pages",
    "copy": "Midland held ISO certificates, but the site did not show them. Buyers had more work to do before they could trust it."
  },
  {
    "label": "Data sheets were hard to browse",
    "copy": "The old downloads page was a long list. Finding a sheet meant searching through the files."
  }
];

/* ── The walkthrough sections ───────────────────────────────── */
const walkthrough = [
  {
    "num": "01",
    "title": "Start with the industry",
    "subtitle": "A clear first choice",
    "copy": "Buyers choose their industry first. The site then shows products that fit that kind of work. They do not need to know a product code.",
    "alt": "Midland oil products grouped for farming customers",
    "img": "/images/case-studies/midland-oil-group/mog-new-sectors.webp",
    "width": 2537,
    "height": 1228
  },
  {
    "num": "02",
    "title": "Make the menus useful",
    "subtitle": "Know where each link leads",
    "copy": "The menus explain what each section holds. Buyers can see the choices before they open a page.",
    "alt": "Midland website menu with industry links and short descriptions",
    "img": "/images/case-studies/midland-oil-group/mog-mega-nav.webp",
    "width": 2542,
    "height": 415
  },
  {
    "num": "03",
    "title": "Ask MOG",
    "subtitle": "Help choosing the right oil",
    "copy": "The oil finder asks about the vehicle, machine or job. It then suggests a product from the range. Buyers can find a starting point without calling Midland.",
    "alt": "Ask MOG oil finder showing vehicle and machine choices",
    "img": "/images/case-studies/midland-oil-group/mog-ask-mog.webp",
    "width": 543,
    "height": 701
  },
  {
    "num": "04",
    "title": "Give each service a page",
    "subtitle": "Show the full offer",
    "copy": "Waste oil collection now has its own place on the site. It sits alongside blending and the other oil services. Buyers can see what Midland offers.",
    "alt": "Midland website page listing its oil services",
    "img": "/images/case-studies/midland-oil-group/mog-services-hub.webp",
    "width": 2533,
    "height": 1296
  },
  {
    "num": "05",
    "title": "Show how the brands fit",
    "subtitle": "A clear home for each range",
    "copy": "Each Midland brand now has its own area. Buyers can see what it offers and find the right product range.",
    "alt": "Midland brands with links to their product ranges",
    "img": "/images/case-studies/midland-oil-group/mog-brands-on-homepage.webp",
    "width": 1684,
    "height": 403
  },
  {
    "num": "06",
    "title": "Find a data sheet",
    "subtitle": "Search by product name",
    "copy": "Buyers can search for the data sheet they need. They can check the details before they choose a product.",
    "alt": "Midland data sheet search with product filters",
    "img": "/images/case-studies/midland-oil-group/mog-technical-library.webp",
    "width": 1719,
    "height": 1126
  }
];

/* ── Results / numbers ──────────────────────────────────────── */
const results = [
  {
    "stat": "3x",
    "label": "Enquiries in the first month",
    "copy": "Three times the enquiries after the rebuild."
  },
  {
    "stat": "40+",
    "label": "Years in the oil trade",
    "copy": "Experience buyers can see and check on the site."
  },
  {
    "stat": "1.2s",
    "label": "Load time",
    "copy": "Down from more than 8 seconds on the old site."
  }
];
---

<StaticPageLayout
  path="/case-studies/midland-oil-group/"
  title="Midland Oil Group Case Study | Kaizen Web"
  description="How we rebuilt Midland Oil Group's website so customers can find the right oil without phoning. Products sorted by industry, plus an AI oil finder."
>
  <!-- ═══ HERO ═══ -->
  <section class="relative bg-gray-950 py-28 md:py-40 overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(6,182,212,0.08),transparent_60%)]"
    >
    </div>
    <div
      class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24 relative"
    >
      <a
        href="/case-studies/"
        class="mb-10 inline-flex items-center gap-2 text-white/40 transition hover:text-white font-body text-sm"
      >
        <span aria-hidden="true">&larr;</span>
         All case studies
      </a>
      <p
        class="marketing-eyebrow marketing-eyebrow--dark mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40"
      >Case study: Midland Oil Group</p>
      <h1
        class="max-w-6xl text-5xl font-heading font-bold leading-[1.1] text-white md:text-6xl lg:text-7xl"
      >A faster website.<br /><span class="text-gray-500">More enquiries for Midland Oil.</span></h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-gray-400"><a href="https://midlandoilgroup.co.uk/" rel="nofollow noopener" target="_blank" class="text-white underline decoration-white/30 hover:decoration-white">Midland Oil Group</a> has more than 40 years in the oil trade. Its old website made choosing a product hard. We rebuilt it around the questions customers ask.</p>
      <p class="mt-6 max-w-2xl text-3xl font-heading font-bold text-cyan-400 md:text-4xl">Find the right oil without a phone call.</p>
    </div>
  </section>

  <!-- ═══ HERO IMAGE — BEFORE / AFTER ═══ -->
  <section class="bg-gray-950 pb-28 md:pb-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <figure>
          <p class="marketing-eyebrow marketing-eyebrow--dark mb-4 text-sm font-bold uppercase tracking-wider text-gray-500">
            Before
          </p>
          <img
            src="/images/case-studies/midland-oil-group/mog-old-homepage.webp"
            width="2544"
            height="1313"
            alt="The old Midland Oil Group WordPress site: generic template, flat navigation, broken on mobile"
            loading="eager"
            decoding="async"
            data-lightbox
            class="w-full rounded-2xl border border-white/10"
          />
          <figcaption class="mt-3 text-sm text-gray-500">The old site made products hard to find on a phone.</figcaption>
        </figure>
        <figure>
          <p class="marketing-eyebrow marketing-eyebrow--dark mb-4 text-sm font-bold uppercase tracking-wider text-cyan-400">
            After
          </p>
          <img
            src="/images/case-studies/midland-oil-group/mog-new-homepage.webp"
            width="2550"
            height="1312"
            alt="The new Midland Oil Group platform: custom-built with sector-first navigation and responsive design"
            loading="eager"
            decoding="async"
            data-lightbox
            class="w-full rounded-2xl border border-cyan-400/20"
          />
          <figcaption class="mt-3 text-sm text-gray-500">The new site helps buyers choose oil for their industry.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══ QUICK SUMMARY ═══ -->
  <section class="bg-white py-20 border-b border-gray-200">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-16">
        <div>
          <p
            class="marketing-eyebrow mb-3 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
          >
            The client
          </p>
          <p class="text-lg leading-relaxed text-gray-700">Midland makes and supplies oil from the West Midlands. It holds ISO 9001 and ISO 14001 certificates. <a href="https://midlandoilgroup.co.uk/" rel="nofollow noopener" target="_blank" class="text-cyan-600 underline decoration-cyan-600/30 hover:decoration-cyan-600">Visit the Midland Oil website</a>.</p>
        </div>
        <div>
          <p
            class="marketing-eyebrow mb-3 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
          >
            What we did
          </p>
          <p class="text-lg leading-relaxed text-gray-700">
            We rebuilt the site around how customers choose their oil.
            They can browse by industry or ask the oil finder.
            They can also search the data sheets.
          </p>
        </div>
        <div>
          <p
            class="marketing-eyebrow mb-3 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
          >
            The shift
          </p>
          <p class="text-lg leading-relaxed text-gray-700">
            Customers can now find the right oil on the site.
            They do not need to start with a phone call.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE PROBLEM ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        Where they were
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
      >Buyers needed a starting point.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">The old site expected people to know which oil they needed. Buyers had to search long product lists or call for help. Useful services were hard to spot. The site also loaded slowly.</p>

      <!-- Before screenshot -->
      <div class="mt-12">
        <img
          src="/images/case-studies/midland-oil-group/mog-old-homepage.webp"
            width="2544"
            height="1313"
          alt="The old Midland Oil Group WordPress homepage with generic template design and product-first navigation"
          loading="lazy"
          decoding="async"
          data-lightbox
          class="w-full rounded-2xl border border-gray-200"
        />
        <p class="mt-3 text-sm text-gray-400 text-center">The old homepage led with products, with little help choosing.</p>
      </div>

      <div class="mt-20 space-y-0">
        {
          beforeProblems.map((item, i) => (
            <div
              class={`grid grid-cols-1 gap-4 border-t border-gray-200 py-8 md:grid-cols-[240px_1fr] md:gap-10 ${i === beforeProblems.length - 1 ? "border-b" : ""}`}
            >
              <p class="text-lg font-heading font-bold text-gray-950">
                {item.label}
              </p>
              <p class="leading-relaxed text-gray-600">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ PATTERN INTERRUPT ═══ -->
  <section class="bg-gray-950 py-24 md:py-32">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-5xl font-heading font-bold leading-tight text-white md:text-6xl lg:text-7xl"
        >The same oil business.<br /><span class="text-cyan-400">An easier way to buy.</span></p>
        <p class="mt-8 text-xl text-gray-400">We put the questions buyers ask at the centre of the new site.</p>
      </div>
    </div>
  </section>

  <!-- ═══ THE WALKTHROUGH ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        What changed
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
      >Help people find what they need.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">These changes make the range easier to explore.</p>

      <div class="mt-20 space-y-28 md:space-y-36">
        {
          walkthrough.map((item) => (
            <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
              <div>
                <span class="text-sm font-medium font-body text-gray-400">
                  {item.num}
                </span>
                <h3 class="mt-2 text-3xl font-heading font-bold text-gray-950 md:text-4xl">
                  {item.title}
                </h3>
                <p class="marketing-eyebrow mt-1 text-sm font-bold uppercase tracking-wider text-cyan-600/70">
                  {item.subtitle}
                </p>
                <p class="mt-5 text-lg leading-relaxed text-gray-600">
                  {item.copy}
                </p>
              </div>
              <img
                src={item.img}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                data-lightbox
                class="w-full rounded-2xl border border-gray-200"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ TRUST & CREDIBILITY ═══ -->
  <section class="bg-[#f5f5f3] py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_1.2fr] lg:items-start">
        <div>
          <p
            class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
          >Proof buyers can check</p>
          <h2
            class="text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
          >More than 40 years in oil.<br /><span class="text-gray-400">Now clear on the site.</span></h2>
          <p class="mt-6 text-lg leading-relaxed text-gray-600">Midland already had the experience and certificates buyers look for. The old site did little to show them.</p>
          <p class="mt-4 text-lg leading-relaxed text-gray-600">The new footer shows the ISO badges and company number. Buyers can also find the legal pages from any page. That makes the key details easier to check.</p>
        </div>
        <div>
          <img
            src="/images/case-studies/midland-oil-group/mog-footer-with-iso.webp"
            width="1662"
            height="636"
            alt="Footer showing ISO 9001 and ISO 14001 certification badges, company number, and LinkedIn link"
            loading="lazy"
            decoding="async"
            data-lightbox
            class="w-full rounded-2xl border border-gray-200"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOMEPAGE WALKTHROUGH ═══ -->
  <section class="bg-white py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        The homepage
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
      >Show what Midland does.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">The homepage explains the oil services and helps buyers choose where to start. It shows the brands and links to their product ranges.</p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        <img
          src="/images/case-studies/midland-oil-group/mog-homepage-hero.webp"
            width="2141"
            height="863"
          alt="New homepage hero with UK Lubricant Specialists headline and oil droplet imagery"
          loading="lazy"
          decoding="async"
          data-lightbox
          class="w-full rounded-2xl border border-gray-200"
        />
        <img
          src="/images/case-studies/midland-oil-group/mog-lubricant-lifecycle.webp"
            width="1723"
            height="502"
          alt="The Complete Lubricant Lifecycle section: Formulation, Manufacture, Regeneration, Disposal"
          loading="lazy"
          decoding="async"
          data-lightbox
          class="w-full rounded-2xl border border-gray-200"
        />
        <img
          src="/images/case-studies/midland-oil-group/mog-brands-on-homepage.webp"
            width="1684"
            height="403"
          alt="Brands section showing four sub-brands with positioning statements"
          loading="lazy"
          decoding="async"
          data-lightbox
          class="w-full rounded-2xl border border-gray-200"
        />
        <img
          src="/images/case-studies/midland-oil-group/mog-stats-by-the-numbers.webp"
            width="1834"
            height="408"
          alt="By The Numbers: 5,000+ product variations, 40+ years experience, 130+ industrial products"
          loading="lazy"
          decoding="async"
          data-lightbox
          class="w-full rounded-2xl border border-gray-200"
        />
      </div>
    </div>
  </section>

  <!-- ═══ BEFORE / AFTER COMPARISON ═══ -->
  <section class="bg-gray-950 py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow marketing-eyebrow--dark mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-500"
      >
        Side by side
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-white md:text-5xl"
      >See the change for yourself.</h2>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div>
          <p
            class="marketing-eyebrow marketing-eyebrow--dark mb-4 text-sm font-bold uppercase tracking-wider text-gray-500"
          >
            Before
          </p>
          <img
            src="/images/case-studies/midland-oil-group/mog-old-homepage.webp"
            width="2544"
            height="1313"
            alt="Old Midland Oil Group WordPress site with generic template and flat navigation"
            loading="lazy"
            decoding="async"
            data-lightbox
            class="w-full rounded-2xl border border-white/10"
          />
          <ul class="mt-6 space-y-3 text-gray-500">
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-gray-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
              >
              <span>A template that did not match the brand.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-gray-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
              >
              <span>The same look across different brands.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-gray-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
              >
              <span>Long menus with little help choosing.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-gray-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
              >
              <span>Slow pages that needed a rebuild.</span>
            </li>
          </ul>
        </div>
        <div>
          <p
            class="marketing-eyebrow marketing-eyebrow--dark mb-4 text-sm font-bold uppercase tracking-wider text-cyan-400"
          >
            After
          </p>
          <img
            src="/images/case-studies/midland-oil-group/mog-new-homepage.webp"
            width="2550"
            height="1312"
            alt="New Midland Oil Group homepage with clear menus and industry links"
            loading="lazy"
            decoding="async"
            data-lightbox
            class="w-full rounded-2xl border border-cyan-400/20"
          />
          <ul class="mt-6 space-y-3 text-gray-300">
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-cyan-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 6 9 17l-5-5"></path></svg
              >
              <span>A design that fits the Midland brand.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-cyan-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 6 9 17l-5-5"></path></svg
              >
              <span>Browse products by industry.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-cyan-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 6 9 17l-5-5"></path></svg
              >
              <span>Ask MOG&#8482; helps buyers choose the right oil.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-cyan-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 6 9 17l-5-5"></path></svg
              >
              <span>You can edit the pages and blog easily.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ RESULTS ═══ -->
  <section class="bg-[#f5f5f3] py-28 md:py-36">
    <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 xl:px-24">
      <p
        class="marketing-eyebrow mb-6 text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400"
      >
        The outcome
      </p>
      <h2
        class="max-w-3xl text-4xl font-heading font-bold leading-tight text-gray-950 md:text-5xl"
      >More enquiries after the rebuild.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">Midland saw three times the enquiries in the first month. It now gets several genuine enquiries a day. A large national business also showed interest after finding the new site.</p>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          results.map((item) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-8">
              <p class="text-4xl font-heading font-bold text-cyan-600">
