---
import StaticPageLayout from "../../layouts/StaticPageLayout.astro";

export const prerender = true;

const summary = [
  {
    heading: "The Problem",
    copy:
      "A dated website was failing to convert on mobile and did not reflect the firm\'s authority.",
  },
  {
    heading: "The Solution",
    copy:
      "A complete custom rebuild focused on clarity, trust, and a cleaner conversion path.",
  },
  {
    heading: "Services Provided",
    copy: "Web design, content strategy, and WordPress development.",
  },
];

const solutionPoints = [
  {
    title: "A crystal-clear process",
    copy:
      "We mapped the Letter Before Action and legal flow in plain language so prospects knew exactly what to expect.",
  },
  {
    title: "Transparent pricing",
    copy:
      "We made pricing visible and simple to compare, creating immediate trust in a category that is usually vague.",
  },
  {
    title: "Visible trust signals",
    copy:
      "No Win, No Fee, success-rate messaging, and review evidence were brought to the surface.",
  },
  {
    title: "Low-friction enquiry",
    copy:
      "The instruction form was streamlined to remove unnecessary steps and improve completion rate.",
  },
];
---

<StaticPageLayout
  path="/case-studies/as-collections/"
  title="A.S Collections Case Study | Kaizen Web"
  description="How we redesigned A.S Collections' website to build trust and authority for a Liverpool debt recovery firm."
>
  <section class="relative bg-gradient-to-b from-blue-600 to-blue-700 py-24 text-white md:py-32">
    <div class="container mx-auto max-w-5xl px-4">
      <a href="/case-studies/" class="mb-10 inline-flex items-center gap-2 text-white/80 transition hover:text-white">
        <span aria-hidden="true">&larr;</span>
        Back to Case Studies
      </a>
      <p class="mb-4 text-xs font-mono font-bold uppercase tracking-[0.2em] text-blue-200">Case Study</p>
      <h1 class="mb-6 text-5xl font-heading font-black leading-tight md:text-6xl lg:text-7xl">A.S Collections</h1>
      <p class="max-w-3xl text-xl text-white/80 md:text-2xl">
        Transforming a dated website into a high-trust, authoritative platform for a leading Liverpool debt recovery firm.
      </p>
    </div>
  </section>

  <section class="border-b border-kaizen-light bg-white py-16">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-12">
        {
          summary.map((item) => (
            <article>
              <h2 class="mb-3 text-sm font-mono font-bold uppercase tracking-widest text-kaizen-cyan">{item.heading}</h2>
              <p class="text-lg leading-relaxed text-kaizen-text-dark">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-kaizen-light py-20 md:py-28">
    <div class="container mx-auto max-w-4xl px-4">
      <article class="mb-16">
        <h2 class="mb-6 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">The Challenge</h2>
        <p class="text-lg leading-relaxed text-kaizen-text-dark/75">
          A.S Collections had a strong reputation offline, but the old website looked generic, loaded slowly, and did not inspire confidence.
          On mobile, performance and readability issues were creating friction at exactly the point where trust mattered most.
        </p>
      </article>

      <article class="mb-16">
        <h2 class="mb-6 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">The Solution</h2>
        <p class="mb-8 text-lg leading-relaxed text-kaizen-text-dark/75">
          We rebuilt the site from the ground up with a clearer structure, tighter messaging, and a conversion path that reflects how debt
          recovery decisions are actually made.
        </p>
        <ul class="space-y-5">
          {
            solutionPoints.map((item) => (
              <li class="rounded-2xl border border-kaizen-light bg-white p-6">
                <h3 class="mb-2 text-xl font-heading font-bold text-kaizen-dark">{item.title}</h3>
                <p class="text-kaizen-text-dark/75">{item.copy}</p>
              </li>
            ))
          }
        </ul>
      </article>

      <article>
        <h2 class="mb-6 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">The Result</h2>
        <p class="text-lg leading-relaxed text-kaizen-text-dark/75">
          The site now acts as a conversion-focused front door: faster on mobile, clearer in positioning, and stronger in trust signals.
          Prospects can understand the process quickly and move directly into the instruction flow.
        </p>
      </article>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container mx-auto max-w-5xl px-4">
      <h2 class="mb-10 text-center text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">Need a Similar Result?</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <a
          href="/web-design-liverpool"
          class="group rounded-2xl border border-kaizen-light bg-kaizen-light p-8 transition hover:border-kaizen-cyan"
        >
          <h3 class="mb-3 text-2xl font-heading font-bold text-kaizen-dark transition group-hover:text-kaizen-cyan">
            Explore Web Design Services
          </h3>
          <p class="text-kaizen-text-dark/70">See how we build fast, trust-first websites for high-stakes service businesses.</p>
        </a>
        <a
          href="/pledge"
          class="group rounded-2xl border border-kaizen-light bg-kaizen-light p-8 transition hover:border-kaizen-cyan"
        >
          <h3 class="mb-3 text-2xl font-heading font-bold text-kaizen-dark transition group-hover:text-kaizen-cyan">
            Read the No-BS Pledge
          </h3>
          <p class="text-kaizen-text-dark/70">Our delivery standards, communication rules, and transparency commitments in plain English.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-kaizen-light bg-kaizen-light py-12">
    <div class="container mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 text-sm font-medium">
      <a href="/case-studies/midland-oil-group/" class="text-kaizen-dark transition hover:text-kaizen-cyan">&larr; Previous Case Study</a>
      <a href="/case-studies/" class="text-kaizen-cyan transition hover:text-kaizen-dark">View All</a>
      <a href="/case-studies/helen-moore-hairdressing/" class="text-kaizen-dark transition hover:text-kaizen-cyan">Next Case Study &rarr;</a>
    </div>
  </section>
</StaticPageLayout>
