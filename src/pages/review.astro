---
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
import SpeedScanner from "../../client/components/SpeedScanner";
import { ContactFormBox } from "../../client/components/ContactFormBox";
import KaizenLogo from "../../client/components/KaizenLogo";

export const prerender = true;

const problems = [
  {
    num: "01",
    title: "It's slow.",
    detail:
      "If your site takes more than 3 seconds to load on mobile, over half your visitors leave before they see a single word. That's not a guess — it's what Google's own data shows.",
  },
  {
    num: "02",
    title: "It doesn't work on mobile.",
    detail:
      "Google ranks your site based on its mobile version, not desktop. If text is too small, buttons are too close together, or layouts break on a phone — your rankings are paying for it.",
  },
  {
    num: "03",
    title: "It looks outdated.",
    detail:
      "People decide whether to trust a business within seconds of landing on the site. An outdated design doesn't just look bad — it actively costs you credibility with potential customers.",
  },
  {
    num: "04",
    title: "It's invisible to Google.",
    detail:
      "Poor structure, missing data markup, and technical issues mean Google can't understand what your site is about. You could have the best product in your area and still not show up.",
  },
];
---

<LandingPageLayout
  title="Your Website Review | Kaizen Web"
>
  <!-- ═══ MINIMAL HEADER ═══ -->
  <header class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200/60">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 h-16 flex items-center justify-between">
      <a href="https://kaizenweb.co.uk" class="inline-flex items-center">
        <KaizenLogo className="h-7 w-[128px] text-[#001133]" client:load />
      </a>
      <a
        href="#get-in-touch"
        class="text-sm font-heading font-bold text-gray-950 hover:text-cyan-600 transition-colors"
      >
        Get in touch
      </a>
    </div>
  </header>

  <!-- ═══ HERO ═══ -->
  <section class="relative bg-[#f5f5f3] pt-36 pb-28 md:pt-44 md:pb-36">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          Your website review
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          Your website could be<br />
          <span class="text-gray-400">working a lot harder.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          You got in touch because something about your site isn't right.
          Maybe it's slow, maybe it looks tired, maybe it's just not
          bringing in the leads it should. This page explains what's
          likely going wrong — and what it would take to fix it.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE SPOTTED ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-20 md:mb-28">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
        >
          Common issues
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight"
        >
          Four things that cost<br />
          <span class="text-gray-500">businesses customers every day.</span>
        </h2>
      </div>

      <div class="space-y-0">
        {
          problems.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
                i < problems.length - 1 && "border-b border-white/10",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-cyan-400/60 tracking-wide block mb-2">
                  {item.num}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                  {item.detail}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ TEST IT YOURSELF ═══ -->
  <section class="bg-gray-950 py-20 md:py-28 relative overflow-hidden border-t border-white/5">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(6,182,212,0.06),transparent_60%)]"
    ></div>
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <SpeedScanner client:load />
    </div>
  </section>

  <!-- ═══ WHAT KAIZEN DOES ═══ -->
  <section class="py-28 md:py-36 bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-20">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          What happens next
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          A site that earns its keep.<br />
          <span class="text-gray-400">Not just one that exists.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
        <div>
          <div class="w-12 h-12 rounded-xl bg-gray-950 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            Fast, mobile-first design
          </h3>
          <p class="text-base font-body text-gray-500 leading-relaxed">
            Clean code, optimised images, no page builder bloat. Your
            site loads in under two seconds and works on every device.
          </p>
        </div>
        <div>
          <div class="w-12 h-12 rounded-xl bg-gray-950 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            Built to rank locally
          </h3>
          <p class="text-base font-body text-gray-500 leading-relaxed">
            Proper structure, data markup, and Core Web Vitals that
            pass. The technical foundation that makes SEO actually work.
          </p>
        </div>
        <div>
          <div class="w-12 h-12 rounded-xl bg-gray-950 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-gray-950 mb-3">
            You own everything
          </h3>
          <p class="text-base font-body text-gray-500 leading-relaxed">
            No lock-in. No proprietary platform. No monthly fee to keep
            your own site running. It's yours, full stop.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF ═══ -->
  <section class="py-20 md:py-28 bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mx-auto text-center">
        <blockquote class="text-2xl md:text-3xl font-heading font-bold text-gray-950 leading-snug mb-8">
          "We went from a 23 PageSpeed score to 98. Enquiries doubled
          within the first month."
        </blockquote>
        <p class="text-base font-body text-gray-500">
          Midland Oil Group — WordPress rebuild by Kaizen
        </p>
        <a
          href="/case-studies/midland-oil-group/"
          target="_blank"
          class="inline-flex items-center gap-2 mt-6 text-sm font-body font-medium text-cyan-600 hover:text-cyan-700 transition-colors"
        >
          Read the case study
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ CONTACT FORM ═══ -->
  <section id="get-in-touch" class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        <!-- Left: Copy -->
        <div class="max-w-lg">
          <p
            class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
          >
            Next step
          </p>
          <h2
            class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight mb-8"
          >
            Worth a conversation.<br />
            <span class="text-gray-500">No pitch deck involved.</span>
          </h2>
          <p class="text-lg text-white/50 font-body leading-relaxed mb-10">
            If what you've seen on this page rings true, a quick chat is
            the easiest way to find out what fixing it would actually
            involve. No pressure, no 47-slide deck — just a proper look
            at what's going on and what the options are.
          </p>

          <div class="space-y-6 text-white/30 text-sm font-body">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-cyan-400/60 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>Fixed-price quotes — no surprise invoices</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-cyan-400/60 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>30 days of snagging included after launch</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-cyan-400/60 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>You own everything — no lock-in, no monthly fees</span>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div>
          <ContactFormBox autoFocusFields={false} client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ MINIMAL FOOTER ═══ -->
  <footer class="bg-gray-950 border-t border-white/5 py-8">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/20 font-body">
        <p>&copy; {new Date().getFullYear()} Kaizen Web Ltd. Company No. 17007703</p>
        <a
          href="https://kaizenweb.co.uk"
          class="hover:text-white/40 transition-colors"
        >
          kaizenweb.co.uk
        </a>
      </div>
    </div>
  </footer>
</LandingPageLayout>
