---
import { MarketingButton, contactResponse } from "../../client/components/untitled/MarketingButton";
import { caseStudies } from "../../client/components/untitled/proof/evidence";
import StudyImage from "../components/case-studies/StudyImage.astro";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;
const screenshot = caseStudies.midland.screenshot;
const experience = [
  { name: "Playtech", work: "Sean worked on product plans and the move from older software.", use: "He can help you plan changes to a service that is already in use." },
  { name: "High 5 Games", work: "Sean helped coordinate the work needed to bring games to business clients.", use: "He knows how to keep connected pieces of work moving together." },
  { name: "SMD Credit Solutions", work: "Sean helped improve how software work was planned and delivered.", use: "He can help you spot where the way of working is slowing things down." },
  { name: "LeoVegas", work: "Sean built a player support service that worked across languages.", use: "He can help you turn what users tell you into useful changes." },
];
const choices = [
  { title: "Choosing what to build", intro: "Start with what people need the software to do.", questions: [
    ["The goal", "What should the software help people do?"],
    ["The order", "Which change will help the most?"],
    ["New requests", "Is this worth doing now?"],
    ["Checking progress", "Does it solve the problem we agreed?"],
  ] },
  { title: "Planning how to deliver it", intro: "Work out how to get there, with the people involved.", questions: [
    ["The goal", "What needs to happen before launch?"],
    ["The order", "Which work can happen next?"],
    ["New requests", "How will this affect the plan?"],
    ["Checking progress", "Is the work ready when we need it?"],
  ] },
];
const steps = [
  { title: "Look at the work so far.", copy: "We review what exists and speak to the people who use it. Then we agree what the project needs to achieve." },
  { title: "Choose what comes next.", copy: "We put the work in order and make the choices clear. You can see what is included and what can wait." },
  { title: "Check the work as it grows.", copy: "We review progress against the agreed aim. You get plain updates on what is ready and what needs attention." },
];
---

<StaticPageLayout
  path="/contract-product-owner"
  title="Contract Product Owner for Hire | Kaizen Web"
  description="Software project drifting? A contract product owner sets the priorities, keeps the work moving and makes sure what gets built is what you need."
>
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <p class="marketing-eyebrow mb-4">For owners of software projects</p>
      <h1 class="font-heading text-4xl font-bold text-uui-dark md:text-5xl lg:text-6xl"><span class="block">Contract product owner.</span>{" "}<span class="block text-uui-brand-800">A clear next step for your project.</span></h1>
      <div class="mt-7 grid items-start gap-10 lg:mt-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="max-w-xl text-lg leading-relaxed text-slate-600">A software project can keep costing money without getting closer to launch. We help you decide what to build and keep the work moving.</p>
          <div class="mt-6">
            <MarketingButton action="contact" />
            <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
          </div>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-600">You work with <a href="/authors/sean-mcdonnell/" class="font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">Sean McDonnell, Kaizen's founder</a>. We can work alongside your current suppliers.</p>
        </div>
        <div>
          <StudyImage src={screenshot.src} alt={screenshot.alt} width={screenshot.width} height={screenshot.height} eager caption="Our Midland Oil website rebuild helps buyers find the right oil." />
          <a href="/case-studies/midland-oil-group/" class="mt-4 inline-block font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">See the Midland Oil website case study</a>
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-section bg-slate-50" aria-labelledby="purpose-heading">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <h2 id="purpose-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Keep the purpose and the plan together.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">A product owner helps you choose what the software should do. A project plan sets out how the work gets done. Both need to serve the same goal.</p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {choices.map((choice) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
            <h3 class="font-heading text-2xl font-bold text-uui-dark md:text-3xl">{choice.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-slate-600">{choice.intro}</p>
            <dl class="mt-6 divide-y divide-slate-200">
              {choice.questions.map(([label, question]) => (
                <div class="py-4 first:pt-0 last:pb-0">
                  <dt class="text-xs font-semibold tracking-wide text-uui-brand-800">{label}</dt>
                  <dd class="mt-1 text-base leading-relaxed text-uui-dark">{question}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-600">We explain the choices and costs before you commit. You can see why each piece of work is worth doing.</p>
    </div>
  </section>

  <section class="marketing-section bg-white" aria-labelledby="experience-heading">
    <div class="mx-auto grid max-w-[1440px] gap-8 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-12">
      <div>
        <p class="marketing-eyebrow mb-4">Sean's work history</p>
        <h2 id="experience-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Experience with software people use.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">Sean brings this experience to the choices your project faces. From changing older software to hearing what users need, it shapes how we work.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {experience.map((item) => (
          <article class="rounded-2xl border border-slate-200 p-6">
            <h3 class="font-heading text-2xl font-bold text-uui-dark">{item.name}</h3>
            <p class="mt-4 text-base leading-relaxed text-slate-600">{item.work}</p>
            <p class="mt-4 border-t border-slate-200 pt-4 text-sm leading-6 text-slate-600">{item.use}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="marketing-section bg-uui-dark text-white" aria-labelledby="review-heading">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <h2 id="review-heading" class="text-balance font-heading text-4xl font-bold md:text-5xl">Review the work before adding more.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">If dates keep moving, we help you find out what needs to change. The review gives the next choice a clear basis.</p>
      </div>
      <ol class="mt-9 grid gap-8 md:grid-cols-3 md:gap-10">
        {steps.map((step, index) => (
          <li class="border-t border-slate-600 pt-6">
            <span class="font-heading text-3xl font-bold text-uui-brand-200" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-5 font-heading text-2xl font-bold">{step.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-slate-300">{step.copy}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 border-t border-slate-600 pt-7">
        <p class="max-w-3xl text-base leading-relaxed text-slate-300">Not every project needs to start again. Our guide helps you check what works and compare the choices ahead.</p>
        <a href="/blog/fix-failing-software-project-financial-guide/" class="mt-4 inline-block font-semibold text-uui-brand-200 underline underline-offset-4 hover:text-white">Read the guide to fixing or rebuilding unfinished software</a>
      </div>
    </div>
  </section>

  <section class="marketing-section bg-slate-50" aria-labelledby="project-contact-heading">
    <div class="mx-auto grid max-w-[1440px] gap-9 px-6 lg:grid-cols-2 lg:gap-20 lg:px-12">
      <div>
        <h2 id="project-contact-heading" class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl">Talk through where the work has got stuck.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">The first conversation is free. Tell us what you need the software to do. We will help you decide whether this service fits.</p>
        <div class="mt-7">
          <MarketingButton action="contact" />
          <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
        </div>
      </div>
      <div class="self-center rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h3 class="font-heading text-2xl font-bold text-uui-dark">Agree the work before you pay.</h3>
        <p class="mt-4 text-base leading-relaxed text-slate-600">We agree what is included and the price before starting. Paid work begins after a non-refundable deposit.</p>
        <a href="/pledge/" class="mt-5 block font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">Read our promises before you pay</a>
        <p class="mt-6 border-t border-slate-200 pt-6 text-sm leading-6 text-slate-600">If your website is the problem, <a href="/services/wordpress-web-design/" class="font-semibold text-uui-brand-800 underline underline-offset-4 hover:text-uui-dark">compare our website rebuild options</a>.</p>
      </div>
    </div>
  </section>
</StaticPageLayout>
