---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import SpeedScanner from "../../client/components/SpeedScanner";
import ContactCTAButton from "../../client/components/ContactCTAButton";

export const prerender = true;

const vitals = [
  {
    code: "01",
    title: "Time to see the page",
    plain: "How quickly the main content appears.",
    why: "Can people see what you offer without a long wait? The test checks when the main image or text appears.",
  },
  {
    code: "02",
    title: "A page that stays still",
    plain: "How much the page jumps around while loading.",
    why: "A moving page can make someone tap the wrong link. The test checks how much content shifts as it loads.",
  },
  {
    code: "03",
    title: "Time spent stuck",
    plain: "How long the page is too busy to respond.",
    why: "A button should work when you tap it. This test spots delays while the page starts up.",
  },
];

const faqs = [
  {
    question: "Why is my WordPress site so slow?",
    answer:
      "Large images or extra features can slow a page down. The test helps you find what to check first.",
  },
  {
    question: "What is a good Google PageSpeed score?",
    answer:
      "Google calls a score of 90 or more good. It does not promise a place in search results. Real visitors may get different results.",
  },
  {
    question: "Does website speed affect Google rankings?",
    answer:
      "Speed is one part of the picture. Google also looks at how well your page answers the search. A high score alone will not put you first.",
  },
  {
    question: "Why is my mobile score lower than desktop?",
    answer:
      "The phone test uses a slower connection and less power. It can show delays that a desktop test misses. This tool runs the phone test.",
  },
  {
    question: "Will I need to give my email address?",
    answer:
      "You see your score first. If it is below 90, enter your email to see the full report. You can then download it as a PDF. Tips by email are optional.",
  },
  {
    question: "Does this show what every visitor sees?",
    answer:
      "No. This is a test of one page at one point in time. Real visits vary by phone, connection and what someone does on the page.",
  },
  {
    question: "How often should I test my website speed?",
    answer:
      "Try it after a change, such as adding large images. Run it again to see whether the change helped.",
  },
  {
    question: "Why did my PageSpeed score drop suddenly?",
    answer:
      "A new image or feature could make your page slower. Test results also vary between runs. Compare a few runs before you decide what to change.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});
---

<StaticPageLayout
  path="/performance-scanner"
  title="Free Website Speed Test for Business Sites | Kaizen Web"
  description="Test how fast your website loads on a phone. See what is slowing it down and what to fix first, in plain English. Free."
>
  <script type="application/ld+json" set:html={faqSchema} is:inline />
  <!-- ═══ HERO ═══ -->
  <section class="relative bg-[#f5f5f3] pt-36 pb-28 md:pt-44 md:pb-36">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          Free website speed test
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          Test your website speed.<br />
          <span class="text-gray-400">Find what may be slowing it down.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          A slow site can make it hard to win new customers.
          Check how your page loads on a phone. See your score first.
          If it is below 90, enter your email for the full report.
        </p>
      </div>

      <!-- Stats -->
      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3 max-w-4xl">
        <div class="border-l-2 border-gray-300 pl-6">
          <p class="text-4xl font-heading font-bold text-gray-950">Free</p>
          <p class="mt-2 text-sm text-gray-500 font-body leading-relaxed">
            Paste your web address to start. There is no charge for the test or report.
          </p>
        </div>
        <div class="border-l-2 border-gray-300 pl-6">
          <p class="text-4xl font-heading font-bold text-gray-950">Mobile</p>
          <p class="mt-2 text-sm text-gray-500 font-body leading-relaxed">
            Google's test acts like a phone on a slow connection. It checks one page at a time.
          </p>
        </div>
        <div class="border-l-2 border-gray-300 pl-6">
          <p class="text-4xl font-heading font-bold text-gray-950">PDF</p>
          <p class="mt-2 text-sm text-gray-500 font-body leading-relaxed">
            Save the full report to read later. It is a download, so you do not need to wait for an email.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SCANNER ═══ -->
  <section class="bg-gray-950 py-20 md:py-28 relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(6,182,212,0.06),transparent_60%)]"
    ></div>
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <SpeedScanner client:load />
    </div>
  </section>

  <!-- ═══ WHAT IT MEASURES ═══ -->
  <section class="py-28 md:py-36 bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-20">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          What it measures
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          See where your page slows down.<br />
          <span class="text-gray-400">Find what to check first.</span>
        </h2>
      </div>

      <div class="space-y-0">
        {
          vitals.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
                i < vitals.length - 1 && "border-b border-gray-200",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-cyan-600 tracking-wide block mb-2">
                  {item.code}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-gray-950">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-lg font-body font-medium text-gray-950 mb-3">
                  {item.plain}
                </p>
                <p class="text-base font-body text-gray-500 leading-relaxed max-w-2xl">
                  {item.why}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="py-28 md:py-36 bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="mb-16">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          Common questions
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          Know what your speed test tells you.
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-x-12">
        {
          faqs.map((item) => (
            <details class="rounded-xl border border-gray-200 bg-white p-6">
              <summary class="cursor-pointer text-lg font-heading font-bold text-gray-950">
                {item.question}
              </summary>
              <p class="mt-4 leading-relaxed text-gray-600">{item.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-8 text-gray-600">
        Read <a class="underline" href="/blog/free-website-speed-scan/">how the free website speed scan works</a>.
        See <a class="underline" href="https://developers.google.com/speed/docs/insights/v5/about">Google's guide to speed test results</a>
        and <a class="underline" href="https://developers.google.com/search/docs/appearance/page-experience">how page experience affects search</a>.
      </p>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          Know what's wrong.<br />
          <span class="text-gray-500">Now let's fix it.</span>
        </h2>
        <p class="text-lg md:text-xl text-white/50 font-body leading-relaxed mb-14 max-w-2xl">
          We can help you read the report and choose what to fix.
          Start with a free chat about your site.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <ContactCTAButton label="Talk to us about your site" client:load />
          <a
            href="/services/wordpress-web-design/"
            class="inline-flex items-center gap-3 px-10 py-5 rounded-lg border border-white/20 text-white font-heading font-bold text-xl transition-all duration-200 hover:scale-[1.03] hover:border-white/50 active:scale-[0.97]"
          >
            Help with a slow WordPress site
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
