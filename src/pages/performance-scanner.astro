---
import { FaqSection } from "../../client/components/untitled/faq";
import { Button } from "../../client/components/untitled/base/buttons/button";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import SpeedScanner from "../../client/components/SpeedScanner";
import ContactCTAButton from "../../client/components/ContactCTAButton";

export const prerender = true;

const vitals = [
  {
    code: "01",
    title: "Time to see the page",
    plain: "How quickly the main content appears.",
    why: "Can people see what you offer without a long wait? The test checks when the main image or text appears.",
  },
  {
    code: "02",
    title: "A page that stays still",
    plain: "How much the page jumps around while loading.",
    why: "A moving page can make someone tap the wrong link. The test checks how much content shifts as it loads.",
  },
  {
    code: "03",
    title: "Time spent stuck",
    plain: "How long the page is too busy to respond.",
    why: "A button should work when you tap it. This test spots delays while the page starts up.",
  },
];

const faqs = [
  {
    question: "Why is my WordPress site so slow?",
    answer:
      "Large images or extra features can slow a page down. The test helps you find what to check first.",
  },
  {
    question: "What is a good Google PageSpeed score?",
    answer:
      "Google calls a score of 90 or more good. It does not promise a place in search results. Real visitors may get different results.",
  },
  {
    question: "Does website speed affect Google rankings?",
    answer:
      "Speed is one part of the picture. Google also looks at how well your page answers the search. A high score alone will not put you first.",
  },
  {
    question: "Why is my mobile score lower than desktop?",
    answer:
      "The phone test uses a slower connection and less power. It can show delays that a desktop test misses. This tool runs the phone test.",
  },
  {
    question: "Will I need to give my email address?",
    answer:
      "You see your score first. If it is below 90, enter your email to see the full report. You can then download it as a PDF. Tips by email are optional.",
  },
  {
    question: "Does this show what every visitor sees?",
    answer:
      "No. This is a test of one page at one point in time. Real visits vary by phone, connection and what someone does on the page.",
  },
  {
    question: "How often should I test my website speed?",
    answer:
      "Try it after a change, such as adding large images. Run it again to see whether the change helped.",
  },
  {
    question: "Why did my PageSpeed score drop suddenly?",
    answer:
      "A new image or feature could make your page slower. Test results also vary between runs. Compare a few runs before you decide what to change.",
  },
];

---

<StaticPageLayout
  path="/performance-scanner"
  title="Free Website Speed Test for Business Sites | Kaizen Web"
  description="Test how fast your website loads on a phone. See what is slowing it down and what to fix first, in plain English. Free."
>
  <section class="scanner-hero marketing-section bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <SpeedScanner showExample client:load>
      <div class="max-w-3xl mb-7 md:mb-10">
        <p class="marketing-eyebrow mb-4 text-slate-600 uppercase tracking-[0.2em]">Free website speed test</p>
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-slate-950 mb-5">Test your website speed.<br /><span class="text-slate-500">Find where to start.</span></h1>
        <p class="max-w-2xl text-lg text-slate-600 leading-relaxed">A free check for business websites. See how one page loads on a phone, then choose what to check first.</p>
      </div>
      </SpeedScanner>
    </div>
  </section>

  <!-- ═══ WHAT IT MEASURES ═══ -->
  <section class="marketing-section bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mb-8 md:mb-12">
        <p
          class="marketing-eyebrow text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          What it measures
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          See where your page slows down.<br />
          <span class="text-gray-500">Find what to check first.</span>
        </h2>
      </div>

      <div class="space-y-0">
        {
          vitals.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 py-8 md:py-10 first:pt-0 last:pb-0",
                i < vitals.length - 1 && "border-b border-gray-200",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-cyan-700 tracking-wide block mb-2">
                  {item.code}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-gray-950">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-lg font-body font-medium text-gray-950 mb-3">
                  {item.plain}
                </p>
                <p class="text-base font-body text-gray-500 leading-relaxed max-w-2xl">
                  {item.why}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection
    id="scanner-faq"
    heading="Know what your speed test tells you."
    eyebrow="Common questions"
    items={faqs}
    className="bg-[#f5f5f3]"
  >
    <p slot="footer">
      Read <a class="underline" href="/blog/free-website-speed-scan/">how the free website speed scan works</a>.
      See <a class="underline" href="https://developers.google.com/speed/docs/insights/v5/about">Google's guide to speed test results</a>
      and <a class="underline" href="https://developers.google.com/search/docs/appearance/page-experience">how page experience affects search</a>.
    </p>
  </FaqSection>

  <!-- ═══ CTA ═══ -->
  <section class="marketing-section bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="marketing-eyebrow marketing-eyebrow--dark text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          Make sense of your report.<br />
          <span class="text-gray-500">Choose what to check next.</span>
        </h2>
        <p class="text-lg md:text-xl text-slate-300 font-body leading-relaxed mb-8 max-w-2xl">
          We can help you read the report and choose what to fix.
          Start with a free chat about your site.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <div class="max-w-md">
            <ContactCTAButton />
            <p class="mt-4 text-sm leading-relaxed text-slate-300">One of us will get back to you the same day, or the next working day at the latest.</p>
          </div>
          <Button href="/services/wordpress-web-design/" color="secondary" size="lg">Help with a slow WordPress site</Button>
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>

<style>
  .scanner-hero { padding-top: 2.5rem; }
  @media (min-width: 768px) { .scanner-hero { padding-top: 4rem; } }
</style>
