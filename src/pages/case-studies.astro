---
import { MarketingButton, contactResponse } from "../../client/components/untitled/MarketingButton";
import { CaseStudyCard } from "../../client/components/untitled/proof/CaseStudyCard";
import { MetricsBlock } from "../../client/components/untitled/proof/MetricsBlock";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;
---

<StaticPageLayout
  path="/case-studies"
  title="Web Design Case Studies | Kaizen Web"
  description="Real websites we have built and fixed, and what changed for each business. See the Midland Oil Group and Helen Moore Hairdressing projects."
>
  <section class="marketing-section bg-white">
    <div class="mx-auto grid max-w-[1440px] items-end gap-7 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:px-12">
      <div>
        <p class="marketing-eyebrow mb-4">Real work and results</p>
        <h1 class="text-balance font-heading text-4xl font-bold text-uui-dark md:text-5xl lg:text-6xl">Web design case studies.<br /><span class="text-uui-brand-800">Help customers choose you.</span></h1>
      </div>
      <div>
        <p class="max-w-xl text-lg leading-relaxed text-slate-600">We rebuild dated, slow websites for businesses. See the work and results for an oil supplier and a salon.</p>
        <div class="mt-7">
          <MarketingButton action="contact" />
          <p class="mt-3 max-w-md text-sm leading-6 text-slate-600">{contactResponse}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section--continuation bg-white" aria-label="Website projects and results">
    <div class="mx-auto max-w-[1440px] space-y-12 px-6 lg:space-y-16 lg:px-12">
      <div>
        <CaseStudyCard studyId="midland" headingLevel="h2" layout="wide" imageLoading="eager" />
        <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <MetricsBlock showSourceLink={false} />
        </div>
      </div>
      <CaseStudyCard studyId="helen" headingLevel="h2" layout="wide" />
      <p class="max-w-2xl text-sm leading-6 text-slate-600">These are each client's results after the rebuild. They are not a promise of the same result for every business.</p>
    </div>
  </section>

  <section class="marketing-section bg-uui-dark text-white" aria-labelledby="case-studies-contact-heading">
    <div class="mx-auto grid max-w-[1440px] gap-9 px-6 lg:grid-cols-2 lg:gap-20 lg:px-12">
      <div>
        <h2 id="case-studies-contact-heading" class="text-balance font-heading text-4xl font-bold md:text-5xl">Talk through what your site needs.</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">The first conversation is free. Tell us what is holding your site back, and we will help you choose a next step.</p>
        <div class="mt-7">
          <MarketingButton action="contact" />
          <p class="mt-3 max-w-md text-sm leading-6 text-slate-300">{contactResponse}</p>
        </div>
      </div>
      <div class="self-center border-t border-slate-600 pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
        <h3 class="font-heading text-2xl font-bold">Find the right place to start.</h3>
        <p class="mt-4 text-base leading-relaxed text-slate-300">You can compare the website options or start with a free speed check.</p>
        <a href="/services/wordpress-web-design/" class="mt-6 block font-semibold text-uui-brand-200 underline underline-offset-4 hover:text-white">Compare our website rebuild options</a>
        <MarketingButton action="speed" variant="secondary" className="mt-5" />
        <p class="mt-6 text-sm leading-6 text-slate-300">Before you commit, <a href="/pledge/" class="font-semibold text-uui-brand-200 underline underline-offset-4 hover:text-white">read our promises before you pay</a>.</p>
      </div>
    </div>
  </section>
</StaticPageLayout>
