---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";

export const prerender = true;

const caseStudies = [
  {
    client: "Midland Oil Group",
    summary:
      "A full platform rebuild — replacing a slow WordPress site with custom architecture, AI-powered product discovery, and sector-first navigation.",
    services: ["Platform Rebuild", "AI Tooling", "Information Architecture", "Performance"],
    slug: "midland-oil-group",
  },
  {
    client: "Helen Moore Hairdressing",
    summary:
      "A salon site rebuilt around speed, trust, and easier booking — with the technical foundations needed to win local search.",
    services: ["Web Design", "Local SEO", "Booking System"],
    slug: "helen-moore-hairdressing",
  },
];
---

<StaticPageLayout
  path="/case-studies"
  description="Proof, not promises. Two public case studies showing the kind of rebuild, technical SEO foundation work, and delivery clarity Kaizen wants more of."
>
  <section class="flex min-h-[60vh] items-center bg-white py-20">
    <div class="container mx-auto max-w-4xl px-4">
      <h1 class="mb-8 text-5xl font-heading font-black leading-tight text-kaizen-dark md:text-6xl lg:text-7xl">
        Proof, trimmed to the work that matters most.
      </h1>
      <p class="text-xl leading-relaxed text-kaizen-text-dark/70 md:text-2xl">
        We are keeping the public proof tight: two projects that best represent
        the kind of work we want more of.
      </p>
    </div>
  </section>

  <section class="bg-kaizen-light py-20">
    <div class="container mx-auto max-w-5xl px-4">
      <h2 class="mb-16 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">
        Featured Case Studies
      </h2>

      <ul class="space-y-0">
        {caseStudies.map((study) => (
          <li>
            <a
              href={`/case-studies/${study.slug}/`}
              class="group block border-b border-kaizen-light bg-transparent px-8 py-12 transition hover:bg-white"
            >
              <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
                <div>
                  <h3 class="mb-4 text-3xl font-heading font-bold text-kaizen-dark transition group-hover:text-kaizen-cyan md:text-4xl">
                    {study.client}
                  </h3>
                  <p class="text-lg leading-relaxed text-kaizen-text-dark/70">
                    {study.summary}
                  </p>
                </div>

                <div class="flex h-full flex-col justify-between">
                  <div>
                    <p class="mb-4 text-xs font-mono font-bold tracking-widest text-kaizen-text-dark/50">
                      SERVICES PROVIDED
                    </p>
                    <div class="flex flex-wrap gap-3">
                      {study.services.map((service) => (
                        <span class="inline-block rounded-full border border-kaizen-light bg-white px-4 py-2 text-sm font-medium text-kaizen-dark transition group-hover:border-kaizen-cyan">
                          {service}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="mt-6 flex items-center gap-2 font-medium text-kaizen-cyan">
                    Read Case Study
                    <span aria-hidden="true">-&gt;</span>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-kaizen-dark py-20 text-white md:py-32">
    <div class="container mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-8 text-4xl font-heading font-black md:text-5xl lg:text-6xl">
        Want work like this on your side?
      </h2>
      <p class="mb-12 text-xl leading-relaxed text-white/80">
        If the job is commercially important, technically messy, or both, we
        should talk.
      </p>
      <div class="flex flex-col items-center justify-center gap-6 sm:flex-row">
        <a
          href="/contact/"
          class="rounded-lg bg-gradient-to-r from-kaizen-cyan to-kaizen-lime px-8 py-3 font-heading font-bold text-kaizen-dark transition hover:shadow-lg hover:shadow-kaizen-cyan/50"
        >
          Get in Touch
        </a>
        <a
          href="/performance-scanner/"
          class="rounded-lg border-2 border-white/30 px-8 py-3 font-heading font-bold text-white transition hover:border-kaizen-cyan hover:text-kaizen-cyan"
        >
          Run the Free Audit
        </a>
      </div>
    </div>
  </section>
</StaticPageLayout>
