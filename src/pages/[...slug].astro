---
import ReactRoutePage from "../layouts/ReactRoutePage.astro";
import ManagedRoutePage from "../../client/static/ManagedRoutePage";
import { getManagedRoutePaths, getPageByPath } from "../lib/sanity/client";

export const prerender = true;

export async function getStaticPaths() {
  const paths = await getManagedRoutePaths();
  return paths
    .filter((pathname) => pathname !== "/")
    .map((pathname) => ({
      params: { slug: pathname.replace(/^\/+/, "") },
    }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam || "";
const pathname = `/${slug}`.replace(/\/+$/, "") || "/";
const page = await getPageByPath(pathname, false);

if (!page || !page.replaceRouteContent) {
  throw new Error(`No managed page found for path: ${pathname}`);
}
---

<ReactRoutePage path={pathname}>
  <ManagedRoutePage path={pathname} page={page} client:load />
</ReactRoutePage>
