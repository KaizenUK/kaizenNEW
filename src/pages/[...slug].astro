---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import ManagedPageRenderer from "../../client/components/sanity/ManagedPageRenderer";
import { getManagedRoutePaths, getPageByPath } from "../lib/sanity/client";
import { RETIRED_PUBLIC_PATHS } from "../../shared/publicRoutePolicy.js";
import { getBuilderPublishedPages } from "../lib/builderPublished";
import PublishedPage from "../../client/visual-builder/Renderer";
import { needsBuilderRuntime, type PageDocument } from "../../shared/visualBuilder";
import builderRuntimeUrl from "../../client/visual-builder/runtime.js?url&no-inline";
interface Props { builderPage?: PageDocument }

export const prerender = true;

export async function getStaticPaths() {
  const paths = await getManagedRoutePaths();
  const builderPages = await getBuilderPublishedPages();
  for (const page of builderPages) {
    if (paths.some(path => path.replace(/^\/+|\/+$/g, "") === page.slug)) throw new Error(`Builder URL conflicts with Sanity: ${page.slug}`);
  }
  return [...builderPages.map(page => ({ params: { slug: page.slug }, props: { builderPage: page } })), ...paths
    .filter((pathname) => pathname !== "/")
    .filter((pathname) => !RETIRED_PUBLIC_PATHS.includes(`${pathname.replace(/\/+$/, "")}/`))
    .map((pathname) => ({
      params: { slug: pathname.replace(/^\/+/, "") },
    }))];
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam || "";
const pathname = `/${slug}`.replace(/\/+$/, "") || "/";
const builderPage = Astro.props.builderPage;
const page = builderPage ? null : await getPageByPath(pathname, false);

if (!builderPage && (!page || !page.replaceRouteContent)) {
  throw new Error(`No managed page found for path: ${pathname}`);
}

const title = builderPage?.title || page?.seo?.metaTitle || page?.title || undefined;
const description = builderPage?.description || page?.seo?.metaDescription || undefined;
const robots = (builderPage?.noIndex || page?.seo?.noIndex) ? "noindex, nofollow" : undefined;
const canonical = page?.seo?.canonicalUrl || undefined;
---

{builderPage ? <html lang="en" data-kaizen-builder-page><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><meta name="robots" content={robots || "index, follow"} /><link rel="canonical" href={`https://kaizenweb.co.uk/${builderPage.slug}/`} /></head><body style="margin:0"><PublishedPage document={builderPage} />{needsBuilderRuntime(builderPage.data.content) && <script is:inline src={builderRuntimeUrl} defer />}</body></html> : <StaticPageLayout
  path={pathname}
  title={title}
  description={description}
  robots={robots}
  canonical={canonical}
>
  <ManagedPageRenderer page={page} client:load />
</StaticPageLayout>}
