---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import ManagedPageRenderer from "../../client/components/sanity/ManagedPageRenderer";
import { getManagedRoutePaths, getPageByPath } from "../lib/sanity/client";

export const prerender = true;

export async function getStaticPaths() {
  const paths = await getManagedRoutePaths();
  return paths
    .filter((pathname) => pathname !== "/")
    .map((pathname) => ({
      params: { slug: pathname.replace(/^\/+/, "") },
    }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam || "";
const pathname = `/${slug}`.replace(/\/+$/, "") || "/";
const page = await getPageByPath(pathname, false);

if (!page || !page.replaceRouteContent) {
  throw new Error(`No managed page found for path: ${pathname}`);
}

const title = page.seo?.metaTitle || page.title || undefined;
const description = page.seo?.metaDescription || undefined;
const robots = page.seo?.noIndex ? "noindex, nofollow" : undefined;
const canonical = page.seo?.canonicalUrl || undefined;
---

<StaticPageLayout
  path={pathname}
  title={title}
  description={description}
  robots={robots}
  canonical={canonical}
>
  <ManagedPageRenderer page={page} client:load />
</StaticPageLayout>
