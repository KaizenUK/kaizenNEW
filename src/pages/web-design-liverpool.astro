---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import WebDesignCityPage from "../components/static/WebDesignCityPage.astro";

export const prerender = true;

const features = [
  {
    title: "Secure and Trustworthy",
    description:
      "Sites built to protect your business with reliable hosting, backups, and practical security.",
  },
  {
    title: "Built for Speed",
    description:
      "Fast sites that load in under two seconds on mobile and desktop.",
  },
  {
    title: "Professional and Reliable",
    description:
      "Clear messaging and strong structure that make your business look established.",
  },
  {
    title: "Ranks on Google",
    description:
      "Technical foundations designed to support local search visibility in Liverpool.",
  },
];

const sectors = [
  {
    title: "Professional Services",
    location: "Commercial District",
    description:
      "Websites for solicitors, accountants, and consultants who need to win high-value clients.",
  },
  {
    title: "Clinics and Healthcare",
    location: "Knowledge Quarter",
    description:
      "Trust-building websites for clinics and practices that need to convert booking intent.",
  },
  {
    title: "Trades and Construction",
    location: "Across the City Region",
    description:
      "Lead-generation websites for builders and service firms that need consistent enquiries.",
  },
];

const faqs = [
  {
    question: "Why choose a Liverpool City Region agency?",
    answer:
      "We understand the local market and build sites that compete with national agencies without inflated fees.",
  },
  {
    question: "Do you work with clinics and healthcare providers?",
    answer:
      "Yes. We build trustworthy, high-performance sites for clinics, dental practices, and healthcare teams.",
  },
  {
    question: "How long does a website take to build?",
    answer:
      "Most projects complete in four to six weeks with a clear scope and timeline from day one.",
  },
  {
    question: "Do you work with WordPress?",
    answer:
      "Yes, where it is the right fit. For speed-critical sites, we often recommend a custom build.",
  },
  {
    question: "What happens after launch?",
    answer:
      "You get 30 days of snagging support for issues, tweaks, and post-launch stabilisation.",
  },
  {
    question: "Can you rescue a slow or broken site?",
    answer:
      "Yes. We audit, prioritise fixes, and stabilise underperforming websites.",
  },
];
---
<StaticPageLayout
  path="/web-design-liverpool"
  title="Web Design Liverpool | Fast Sites That Bring in Work"
  description="Websites for Liverpool businesses who need more customers. Fast, professional, and built to rank."
>
  <WebDesignCityPage
    badge="Web Design Liverpool"
    heroLines={["Fast Websites", "for Liverpool", "Businesses."]}
    heroDescription="We build websites for Liverpool businesses who need more customers. Fast sites that rank and turn visitors into paying clients."
    featureIntro="Liverpool businesses deserve websites that work as hard as they do."
    sectorsIntro="From the Commercial District to the Knowledge Quarter, your website should perform at a world-class level."
    finalDescription="Whether you are a clinic, building firm, consultancy, or service business, we build websites that load fast and win trust."
    features={features}
    sectors={sectors}
    faqs={faqs}
  />
</StaticPageLayout>
