---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../client/components/ContactCTAButton";

export const prerender = true;

/* ── What you get — concrete outcomes ─────────────────────── */
const outcomes = [
  {
    num: "01",
    title: "One person. The whole way.",
    copy: "From first conversation to launch and beyond. No account managers. No handoffs. No repeating yourself to someone new every fortnight. You deal with the person doing the work.",
  },
  {
    num: "02",
    title: "Advice before invoices.",
    copy: "Sometimes your site needs rebuilding. Sometimes it needs three things fixing. You'll know which before any work starts — and you'll understand exactly why.",
  },
  {
    num: "03",
    title: "Built to perform, not just look nice.",
    copy: "Every site passes Google's Core Web Vitals. Every page loads fast on every device. That's not a bonus — it's the baseline. If it doesn't perform, it doesn't ship.",
  },
  {
    num: "04",
    title: "Plain English. Every step.",
    copy: "No jargon. No acronyms dropped to sound clever. You'll understand every recommendation, every decision, and exactly what it means for your business.",
  },
];
---

<StaticPageLayout
  path="/about"
  title="About Kaizen Web | Web Design That Actually Works"
  description="Kaizen means continuous improvement. One person, start to finish. No jargon, no handoffs. Websites that perform as hard as your business does."
>
  <!-- ═══ HERO ═══ -->
  <section class="relative bg-[#f5f5f3] pt-36 pb-28 md:pt-44 md:pb-36">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          About
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >
          You've been through the agency thing before.
        </h1>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed mb-6">
          The big pitch. The fancy proposal. Three months of back-and-forth
          with someone who's never looked at your site. Then a bill for something
          that doesn't quite work — and the person who sold it to you has moved on
          to the next client.
        </p>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          This isn't that.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ THE NAME ═══ -->
  <section class="py-28 md:py-36 bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        <div>
          <h2
            class="text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-gray-950 leading-none mb-8"
          >
            Kaizen.
          </h2>
          <p
            class="text-2xl md:text-3xl font-heading font-bold text-gray-950 leading-snug"
          >
            It's a Japanese word.<br />It means continuous improvement.
          </p>
        </div>
        <div class="lg:pt-8">
          <div class="border-l-2 border-gray-200 pl-8 lg:pl-10">
            <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed mb-6">
              Not "launch and leave." The idea that something can always be
              better — and that small, consistent changes beat one big expensive
              gamble every time.
            </p>
            <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">
              Your website isn't a one-off project. It's a living thing.
              It should get sharper, faster, and more effective every month —
              not just on the day it goes live.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW THIS IS DIFFERENT ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-20 md:mb-28">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
        >
          How this works
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight"
        >
          No layers.<br />No runaround.
        </h2>
      </div>

      <div class="space-y-0">
        {
          outcomes.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
                i < outcomes.length - 1 && "border-b border-white/10",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-kaizen-cyan tracking-wide block mb-2">
                  {item.num}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                  {item.copy}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE PERSONAL BIT ═══ -->
  <section class="py-28 md:py-36 bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mx-auto">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          The personal bit
        </p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight mb-10"
        >
          Based on the Wirral.<br />
          <span class="text-gray-400">Working across the UK.</span>
        </h2>
        <div class="space-y-6 text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          <p>
            Most of the businesses Kaizen works with are small to mid-sized
            companies who know their website isn't pulling its weight — but don't
            know where to start fixing it. Or they've tried, and it didn't work
            out.
          </p>
          <p>
            When you work with Kaizen, you deal with the same person from first
            conversation to final delivery. No handoffs. No disappearing into a
            queue. No "I'll pass that on."
          </p>
          <p>
            Fewer projects, done properly. If Kaizen takes you on, you get full
            attention — not whatever's left after the bigger clients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >
          A conversation costs nothing.<br />
          <span class="text-gray-500">The wrong website costs everything.</span>
        </h2>
        <p class="text-lg md:text-xl text-white/50 font-body leading-relaxed mb-14 max-w-2xl">
          Whether you need a ground-up rebuild or just want someone to look at
          what you've got and tell you what's actually going on — that's a good
          place to start.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <ContactCTAButton label="Start a conversation" client:load />
          <a
            href="/performance-scanner/"
            class="inline-flex items-center gap-3 px-10 py-5 rounded-lg border border-white/20 text-white font-heading font-bold text-xl transition-all duration-200 hover:scale-[1.03] hover:border-white/50 active:scale-[0.97]"
          >
            Free site audit
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
