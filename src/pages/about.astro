---
import { MarketingButton } from "../../client/components/untitled/MarketingButton";
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import ContactCTAButton from "../../client/components/ContactCTAButton";

export const prerender = true;

/* ── What you get — concrete outcomes ─────────────────────── */
const outcomes = [
  {
    "num": "01",
    "title": "The same person throughout.",
    "copy": "You speak to the person doing the work. They know your site and the choices made along the way."
  },
  {
    "num": "02",
    "title": "Advice before invoices.",
    "copy": "You may need a rebuild, or a few small fixes. We explain the options before work starts."
  },
  {
    "num": "03",
    "title": "See the work before launch.",
    "copy": "Check the pages on your phone and computer. We agree what needs to work and test it before launch."
  },
  {
    "num": "04",
    "title": "Plain English at each step.",
    "copy": "You should understand what you are paying for. Ask us to explain anything that is unclear."
  }
];
---

<StaticPageLayout
  path="/about"
  title="About Kaizen Web | How We Work"
  description="Kaizen means continuous improvement. You deal with the same person from first call to launch, in plain English, with advice before any invoice."
>
  <!-- ═══ HERO ═══ -->
  <section class="relative bg-[#f5f5f3] pt-36 pb-28 md:pt-44 md:pb-36">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >
          About
        </p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-950 leading-tight mb-8"
        >Web design with the same person<br />from first chat to launch.</h1>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed mb-6">You paid for a website. It should help your business. If the last build left you let down, we understand the doubt.</p>
        <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">We start by looking at what works and what needs to change.</p>
      </div>
    </div>
  </section>

  <!-- ═══ THE NAME ═══ -->
  <section class="py-28 md:py-36 bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        <div>
          <h2
            class="text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-gray-950 leading-none mb-8"
          >
            Kaizen.
          </h2>
          <p
            class="text-2xl md:text-3xl font-heading font-bold text-gray-950 leading-snug"
          >Kaizen means continuous improvement.</p>
        </div>
        <div class="lg:pt-8">
          <div class="border-l-2 border-gray-200 pl-8 lg:pl-10">
            <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed mb-6">A website needs care after launch. We can make changes for you as your business grows.</p>
            <p class="text-lg md:text-xl text-gray-500 font-body leading-relaxed">Start with the changes that matter most. You should know what each change is for before you pay for it.</p>
            <p class="mt-6 text-lg text-gray-700">
              See <a href="/blog/more-than-a-refresh-why-we-rebuilt-the-kaizen-website/" class="underline underline-offset-4 hover:text-gray-950">why we rebuilt the Kaizen website</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW THIS IS DIFFERENT ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full bg-kaizen-cyan/[0.04] blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl mb-20 md:mb-28">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-6"
        >
          How this works
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight"
        >You know who to speak to.</h2>
      </div>

      <div class="space-y-0">
        {
          outcomes.map((item, i) => (
            <div
              class:list={[
                "grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-16 md:py-20",
                i < outcomes.length - 1 && "border-b border-white/10",
              ]}
            >
              <div class="md:col-span-4 lg:col-span-3">
                <span class="text-sm font-body text-kaizen-cyan tracking-wide block mb-2">
                  {item.num}
                </span>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">
                  {item.title}
                </h3>
              </div>
              <div class="md:col-span-8 lg:col-span-9">
                <p class="text-base md:text-lg font-body text-white/50 leading-relaxed max-w-2xl">
                  {item.copy}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE PERSONAL BIT ═══ -->
  <section class="py-28 md:py-36 bg-[#f5f5f3]">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-12">
      <div class="max-w-3xl mx-auto">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-gray-400 mb-6"
        >Where we work</p>
        <h2
          class="text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight mb-10"
        >Merseyside and West Yorkshire.<br /><span class="text-gray-400">We come to you.</span></h2>
        <div class="space-y-6 text-lg md:text-xl text-gray-500 font-body leading-relaxed">
          <p>We work with owners who want more from their websites. That might mean more calls or an easier way to book.</p>
          <p>You deal with the same person from the first chat onwards. You can ask questions and get clear answers.</p>
          <p>We show you what we plan to do. Work starts after a non-refundable deposit. You review the site before launch.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="py-28 md:py-36 bg-gray-950 text-white relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(6,182,212,0.08),transparent_60%)]"
    ></div>

    <div class="mx-auto max-w-[1440px] px-6 lg:px-12 relative z-10">
      <div class="max-w-3xl">
        <p
          class="text-xs font-medium font-body uppercase tracking-[0.25em] text-white/40 mb-8"
        >
          Next step
        </p>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-8"
        >Start with a free chat<br /><span class="text-gray-500">about your website.</span></h2>
        <p class="text-lg md:text-xl text-white/50 font-body leading-relaxed mb-14 max-w-2xl">Tell us what is wrong with the site. We will help you work out what to do next.</p>

        <div class="flex flex-col sm:flex-row items-start gap-6">
          <ContactCTAButton />
          <MarketingButton action="speed" />
        </div>
      </div>
    </div>
  </section>
</StaticPageLayout>
