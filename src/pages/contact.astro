---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import { ContactFormBox } from "../../client/components/ContactFormBox";
import { BUSINESS_EMAIL } from "../../client/lib/seo";

export const prerender = true;

---

<StaticPageLayout
  path="/contact"
  title="Contact Kaizen Web | Talk About Your Website"
  description="Tell us what is wrong with your website, or what you need from a new one. We will come back with clear next steps, in plain English."
>
  <section class="marketing-section bg-gradient-to-br from-kaizen-dark via-slate-900 to-kaizen-dark text-white">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-5xl">
        <div class="mb-12 text-center">
          <h1 class="mb-6 text-5xl font-heading font-bold leading-tight md:text-6xl lg:text-7xl">Tell us about your site.</h1>
          <p class="mx-auto max-w-2xl text-lg leading-relaxed text-white/80">
            One of us will get back to you the same day, or the next working day at the latest.
          </p>
          <p class="mt-4 text-base leading-relaxed text-white/80">
            Start with a free chat about your business website.
          </p>
          <p class="mt-4 text-base leading-relaxed text-white/80">
            You can also email <!--email_off--><a href={`mailto:${BUSINESS_EMAIL}`} class="underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{BUSINESS_EMAIL}</a><!--/email_off-->.
          </p>
        </div>

        <section aria-labelledby="contact-form-heading" class="mx-auto max-w-xl">
          <h2 id="contact-form-heading" class="sr-only">Website enquiry form</h2>
          <ContactFormBox autoFocusFields={false} client:load />
        </section>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section--compact bg-white">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-8 text-4xl font-heading font-bold text-kaizen-dark md:text-5xl">Agree the work before you pay.</h2>
        <p class="text-lg leading-relaxed text-kaizen-text-dark/70 md:text-xl">
          We talk through what needs to change and agree the work and price.
          Work starts after a non-refundable deposit.
          Read <a href="/pledge/" class="underline underline-offset-4 hover:text-kaizen-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-700">our pledge about the work and price</a> before you decide.
        </p>
      </div>
    </div>
  </section>
</StaticPageLayout>
