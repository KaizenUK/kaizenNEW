---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import WebDesignCityPage from "../components/static/WebDesignCityPage.astro";

export const prerender = true;

const features = [
  {
    title: "Fast by Default",
    description:
      "Every site is engineered for sub-2s loading so first impressions stay sharp.",
  },
  {
    title: "Secure and Reliable",
    description:
      "Secure infrastructure and dependable delivery for high-trust sectors.",
  },
  {
    title: "Local and Accountable",
    description:
      "North West based team with direct communication and hands-on ownership.",
  },
  {
    title: "Built to Rank",
    description:
      "Search-friendly architecture designed to improve Chester visibility.",
  },
];

const sectors = [
  {
    title: "Law Firms and Solicitors",
    location: "Chester Business Park",
    description:
      "Trust-first websites for legal practices that need to convert serious enquiries.",
  },
  {
    title: "Financial Advisors and Wealth Management",
    location: "The Rows and City Centre",
    description:
      "Secure, premium digital experiences for high-trust client relationships.",
  },
  {
    title: "Consultants and Professional Services",
    location: "Hoole and Greater Chester",
    description:
      "Clear conversion-focused websites for specialist service firms.",
  },
];

const faqs = [
  {
    question: "Why choose a Chester-based web agency?",
    answer:
      "We balance established brand positioning with modern performance and conversion best practice.",
  },
  {
    question: "Do you work with legal and finance firms?",
    answer:
      "Yes. We specialise in high-trust sectors where credibility, speed, and clarity matter.",
  },
  {
    question: "How long does a website build take?",
    answer:
      "Most sites complete in four to six weeks, with discovery support for messaging-heavy projects.",
  },
  {
    question: "Can you improve our existing WordPress site?",
    answer:
      "Yes. We audit and recommend fix versus rebuild based on performance and ROI.",
  },
  {
    question: "What happens after launch?",
    answer:
      "30 days of snagging support is included with optional ongoing support plans.",
  },
  {
    question: "Can you build secure client areas?",
    answer:
      "Yes. We can implement secure document and portal workflows based on your requirements.",
  },
];
---
<StaticPageLayout
  path="/web-design-chester"
  title="Web Design Chester | Trusted Sites for Law and Finance"
  description="Professional websites for Chester law firms and financial advisors. Fast, secure, and built to win trust."
>
  <WebDesignCityPage
    badge="Web Design Chester"
    heroLines={["Trusted Websites", "for Chester", "Businesses."]}
    heroDescription="Professional websites for Chester firms that need trust, speed, and reliable lead flow."
    featureIntro="From legal to financial services, we build websites that support high-trust buying decisions."
    sectorsIntro="Built for firms across Chester Business Park, Hoole, and the city centre."
    finalDescription="If your business relies on trust, your website must communicate credibility in seconds."
    features={features}
    sectors={sectors}
    faqs={faqs}
  />
</StaticPageLayout>
