---
export const prerender = false;

const { path } = Astro.params;
const studioPath = typeof path === "string" ? path : Array.isArray(path) ? path.join("/") : "";
const target = `/studio/${studioPath}`.replace(/\/+$/, "");
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kaizen CMS</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #101112;
        overflow: hidden;
      }
      iframe {
        border: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
    </style>
  </head>
  <body>
    <iframe src={target} allow="clipboard-read; clipboard-write" />
  </body>
</html>
