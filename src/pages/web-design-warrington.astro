---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import WebDesignCityPage from "../components/static/WebDesignCityPage.astro";

export const prerender = true;

const features = [
  {
    title: "Built to Last",
    description:
      "Reliable hosting and architecture for businesses that cannot afford downtime.",
  },
  {
    title: "Fast and Simple",
    description:
      "Practical sites that load quickly and make customer actions straightforward.",
  },
  {
    title: "We Get Industry",
    description:
      "We design around how logistics, manufacturing, and trade businesses operate.",
  },
  {
    title: "Built for Business",
    description:
      "Scalable sites that stay usable under growth and traffic pressure.",
  },
];

const sectors = [
  {
    title: "Logistics and Distribution",
    location: "Omega Business Park",
    description:
      "Websites and portals for tracking, documents, and client communication.",
  },
  {
    title: "Engineering and Manufacturing",
    location: "Birchwood Park",
    description:
      "Clear technical messaging for complex services and capability-led buying.",
  },
  {
    title: "Professional Services",
    location: "Warrington Town Centre",
    description:
      "Established digital presence for consultants, contractors, and service firms.",
  },
];

const faqs = [
  {
    question: "Why choose a Warrington web design agency?",
    answer:
      "We understand local operational businesses and build practical websites that support sales.",
  },
  {
    question: "Can you build portals or tracking systems?",
    answer:
      "Yes. We can deliver secure client access areas and simple operational tools.",
  },
  {
    question: "How long does build take?",
    answer:
      "Most websites deliver in four to six weeks with fixed milestones.",
  },
  {
    question: "Do you work with WordPress?",
    answer:
      "Yes where it fits. For high performance and lower maintenance, custom builds are often better.",
  },
  {
    question: "What support is included after launch?",
    answer:
      "30 days of snagging support is included with optional ongoing plans.",
  },
  {
    question: "Can you rescue a broken current site?",
    answer:
      "Yes. We provide audit-led rescue and stabilisation work.",
  },
];
---
<StaticPageLayout
  path="/web-design-warrington"
  title="Web Design Warrington | Sites Built for Business"
  description="Reliable websites for Warrington businesses. Fast, professional, and built for operational clarity."
>
  <WebDesignCityPage
    badge="Web Design Warrington"
    heroLines={["Reliable Websites", "for Warrington", "Businesses."]}
    heroDescription="Fast, practical websites for operational businesses that need consistent lead flow and trust."
    featureIntro="No fuss, no bloat, just websites built for real business outcomes."
    sectorsIntro="Designed for businesses across Omega, Birchwood, and the wider Warrington region."
    finalDescription="From logistics to engineering and services, we build sites that work under pressure."
    features={features}
    sectors={sectors}
    faqs={faqs}
  />
</StaticPageLayout>
