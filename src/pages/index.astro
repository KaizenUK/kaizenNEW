---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import Hero from "../components/homepage/Hero.astro";
import Services from "../components/homepage/Services.astro";
import Problem from "../components/homepage/Problem.astro";
import Process from "../components/homepage/Process.astro";
import WhyUs from "../components/homepage/WhyUs.astro";
import CaseSpotlight from "../components/homepage/CaseSpotlight.astro";
import Reviews from "../components/homepage/Reviews.astro";
import FinalCTA from "../components/homepage/FinalCTA.astro";
import AboutKaizen from "../components/homepage/AboutKaizen.astro";
import ThirtySeconds from "../components/homepage/ThirtySeconds.astro";
import { HomepageFAQ } from "../../client/components/homepage/HomepageFAQ";

export const prerender = true;
---

<StaticPageLayout
  path="/"
  title="Web Design & Website Performance Optimisation | Kaizen Web"
  description="We build websites that look outstanding, convert your customers and perform with awe. From WordPress optimisation to performance audits, Kaizen has you covered"
>
  <Hero />
  <Services />
  <Problem />
  <Process />
  <AboutKaizen />
  <WhyUs />
  <ThirtySeconds />
  <CaseSpotlight />
  <Reviews />
  <HomepageFAQ client:visible />
  <FinalCTA />
</StaticPageLayout>
