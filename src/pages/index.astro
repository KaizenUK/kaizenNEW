  <Services />
  <Problem />
  <Process />
  <AboutKaizen />
  <WhyUs />
  <ThirtySeconds />
  <CaseSpotlight />
  <Reviews />
  <HomepageFAQ />
  <FinalCTA />
</StaticPageLayout>
