---
import "../../client/global.css";
import { DEFAULT_OG_IMAGE, SITE_NAME, getPageMeta } from "../../client/lib/seo";
import { BUILD_AT, BUILD_NUMBER, BUILD_SHA } from "../../client/generated/buildInfo";
import SpeedScanner from "../../client/components/SpeedScanner";

const meta = getPageMeta("/");
const canonicalUrl = "https://kaizenweb.co.uk";
const buildLabel = BUILD_NUMBER?.trim()
  ? `Build #${BUILD_NUMBER.trim()}`
  : BUILD_SHA?.trim()
    ? `Build ${BUILD_SHA.trim().slice(0, 7)}`
    : BUILD_AT?.trim()
      ? `Built ${BUILD_AT.trim()}`
      : "";

const navLinks = [
  { href: "/web-design-wirral", label: "Web Design Wirral" },
  { href: "/web-design-liverpool", label: "Web Design Liverpool" },
  { href: "/services", label: "Services" },
  { href: "/case-studies", label: "Case Studies" },
  { href: "/performance-scanner", label: "Free Audit" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const serviceCards = [
  {
    name: "Web Design and Rebuilds",
    blurb:
      "Fast websites built for lead generation, search visibility and conversion. No template spam, no WordPress bloat.",
    bullets: [
      "Performance budgets from day one",
      "Clean technical SEO foundations",
      "Mobile-first conversion journeys",
    ],
    href: "/services",
    cta: "Explore web design",
  },
  {
    name: "Project Rescue",
    blurb:
      "If your build is late, fragile or over budget, we stabilise architecture and ship safely with clear milestones.",
    bullets: [
      "Rapid technical triage",
      "Fix-first delivery plans",
      "Rollback-safe releases",
    ],
    href: "/project-rescue",
    cta: "Get rescue support",
  },
  {
    name: "Fractional Product Leadership",
    blurb:
      "Senior delivery ownership for teams that need roadmap clarity, pace and measurable commercial outcomes.",
    bullets: [
      "Roadmap and delivery governance",
      "Stakeholder alignment",
      "Execution with accountability",
    ],
    href: "/contract-product-owner",
    cta: "View product support",
  },
];

const caseStudies = [
  {
    title: "Helen Moore Hairdressing",
    result: "From invisible to 3k+ monthly local impressions.",
    href: "/case-studies/helen-moore-hairdressing",
  },
  {
    title: "Independent Retailer",
    result: "Improved conversion flow and higher quality enquiries.",
    href: "/case-studies/independent-retailer",
  },
  {
    title: "Kaizen Rebuild",
    result: "Legacy stack replaced with a performance-first architecture.",
    href: "/case-studies/kaizen-rebuild",
  },
];

const pricingTiers = [
  {
    name: "Starter",
    price: "GBP 2k-4k",
    audience: "Lean brochure and lead-generation builds.",
  },
  {
    name: "Growth",
    price: "GBP 5k-9k",
    audience: "Conversion-focused websites for scaling teams.",
  },
  {
    name: "Advanced",
    price: "GBP 10k-15k+",
    audience: "Complex migrations, rescue and deeper integrations.",
  },
];

const processSteps = [
  { step: "01", title: "Discovery", text: "Business goals, audience, technical scope." },
  { step: "02", title: "Blueprint", text: "Architecture, SEO and performance targets." },
  { step: "03", title: "Build", text: "Implementation on staged environments." },
  { step: "04", title: "Launch", text: "Safe release with verification and monitoring." },
  { step: "05", title: "Improve", text: "Post-launch optimisation for conversion and speed." },
];

const localAreas = [
  { href: "/web-design-wirral", title: "Wirral", text: "Local lead generation and conversion-first builds." },
  { href: "/web-design-liverpool", title: "Liverpool", text: "Performance websites for high-competition sectors." },
  { href: "/web-design-chester", title: "Chester", text: "Modern websites that are easy to maintain and scale." },
  { href: "/web-design-warrington", title: "Warrington", text: "Commercially focused sites for growing teams." },
];

const faqs = [
  {
    q: "How quickly can you launch a new site?",
    a: "Most brochure and lead-generation builds launch in 2-4 weeks. Rescue and migration work depends on the handover quality, but we set a clear milestone plan before work starts.",
  },
  {
    q: "Do you only work with Liverpool and Wirral businesses?",
    a: "No. We are based local and work UK-wide, but we keep local market positioning strong for Wirral, Liverpool, Chester and Warrington.",
  },
  {
    q: "Can you improve our current site without rebuilding everything?",
    a: "Yes. We can run focused performance, conversion and SEO improvements when a full rebuild is not the right commercial move.",
  },
  {
    q: "Do you provide hosting and support after launch?",
    a: "Yes. We support staged releases, ongoing maintenance and performance monitoring so the site keeps producing results post-launch.",
  },
  {
    q: "Can you rescue a project another agency has stalled?",
    a: "Yes. We regularly step into delayed or unstable builds, run triage, stabilise delivery and get to launch with realistic timelines.",
  },
  {
    q: "Do you offer e-commerce and advanced integrations?",
    a: "Yes. We support commerce builds and complex integrations when they are required, while still protecting Core Web Vitals and maintainability.",
  },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.noIndex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={meta.image ?? DEFAULT_OG_IMAGE} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image ?? DEFAULT_OG_IMAGE} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-950 text-white antialiased selection:bg-cyan-400/30 selection:text-white">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="text-xl font-black tracking-tight text-white">Kaizen Web</a>
        <nav class="hidden items-center gap-6 text-sm text-white/80 md:flex">
          {navLinks.map((link) => (
            <a href={link.href} class="transition hover:text-white">{link.label}</a>
          ))}
        </nav>
        <a
          href="/contact"
          class="rounded-full bg-cyan-400 px-5 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
        >
          Book Intro Call
        </a>
      </div>
      <div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 pb-4 text-xs text-white/80 md:hidden">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="whitespace-nowrap rounded-full border border-white/15 px-3 py-1.5 transition hover:border-cyan-400/60 hover:text-white"
          >
            {link.label}
          </a>
        ))}
      </div>
    </header>

    <main>
      <section class="relative overflow-hidden border-b border-white/10">
        <div class="hero-mesh-bg absolute inset-0 pointer-events-none">
          <div class="hero-mesh-blob hero-mesh-blob--violet"></div>
          <div class="hero-mesh-blob hero-mesh-blob--teal"></div>
          <div class="hero-mesh-blob hero-mesh-blob--gold"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_15%,rgba(6,182,212,0.22),transparent_52%),radial-gradient(circle_at_90%_70%,rgba(16,185,129,0.18),transparent_54%)]"></div>
        </div>
        <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:px-8 lg:py-28">
          <div>
            <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Wirral Web Design</p>
            <h1 class="text-5xl font-black leading-tight sm:text-6xl">
              Sites That Actually Make You Money
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
              Slow websites waste ad spend and kill lead quality. We build fast, conversion-focused
              websites that improve qualified enquiries, search visibility and sales outcomes.
            </p>
            <div class="mt-6 flex flex-wrap gap-2 text-xs uppercase tracking-[0.18em] text-white/70">
              <span class="rounded-full border border-white/15 px-3 py-1">Performance budgets</span>
              <span class="rounded-full border border-white/15 px-3 py-1">Core Web Vitals first</span>
              <span class="rounded-full border border-white/15 px-3 py-1">No WordPress bloat</span>
            </div>
            <div class="mt-10 flex flex-wrap gap-4">
              <a
                href="/contact"
                class="rounded-lg bg-white px-7 py-4 font-semibold text-slate-950 transition hover:bg-white/90"
              >
                Start Your Project
              </a>
              <a
                href="/performance-scanner"
                class="rounded-lg border border-white/25 px-7 py-4 font-semibold transition hover:border-cyan-400 hover:text-cyan-300"
              >
                Run Free Speed Audit
              </a>
            </div>
            <p class="mt-8 text-sm text-white/65">
              Trusted by Wirral trades, local retailers, service firms and product teams.
            </p>
          </div>

          <div class="rounded-3xl border border-emerald-300/35 bg-slate-950/70 p-8 shadow-[0_24px_80px_rgba(6,182,212,0.16)]">
            <p class="text-xs uppercase tracking-[0.24em] text-emerald-300">Performance Standard</p>
            <div class="mt-5 flex items-center gap-6">
              <div class="relative h-28 w-28">
                <svg class="h-full w-full -rotate-90" viewBox="0 0 200 200" aria-hidden="true">
                  <circle cx="100" cy="100" r="84" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="10"></circle>
                  <circle
                    cx="100"
                    cy="100"
                    r="84"
                    fill="none"
                    stroke="#34d399"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-dasharray="527.8"
                    stroke-dashoffset="21.1"
                  ></circle>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center text-3xl font-black text-emerald-300">96</div>
              </div>
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-white/65">Lighthouse target</p>
                <p class="mt-2 text-sm text-white/75">
                  We treat performance as a delivery requirement, not a post-launch patch.
                </p>
              </div>
            </div>
            <div class="mt-8 grid grid-cols-3 gap-3 text-center">
              <div class="rounded-xl border border-white/10 bg-slate-950/75 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-white/50">LCP</p>
                <p class="mt-2 text-2xl font-bold">0.8s</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-slate-950/75 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-white/50">TBT</p>
                <p class="mt-2 text-2xl font-bold">0ms</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-slate-950/75 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-white/50">CLS</p>
                <p class="mt-2 text-2xl font-bold">0.01</p>
              </div>
            </div>
            <a
              href="/performance-scanner"
              class="mt-8 inline-flex rounded-lg border border-cyan-400/50 px-5 py-3 text-sm font-semibold text-cyan-300 transition hover:border-cyan-300 hover:text-cyan-200"
            >
              See full performance report
            </a>
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-900">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:px-8">
          <div>
            <p class="mb-4 text-xs uppercase tracking-[0.24em] text-amber-300">The Uncomfortable Truth</p>
            <h2 class="text-3xl font-black leading-tight sm:text-4xl">
              Do not build your business on rented land.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-white/80">
              If your only channel is social media, you do not own your audience. Algorithms shift,
              reach gets throttled, and account access can disappear overnight.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-white/80">
              Your website is the only digital asset you control end to end. It should be your most
              reliable lead source, not an afterthought.
            </p>
          </div>
          <div class="grid gap-4">
            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-6">
              <p class="text-sm font-semibold text-cyan-300">Conversion-led architecture</p>
              <p class="mt-2 text-sm text-white/70">Pages built around intent, trust and next action.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-6">
              <p class="text-sm font-semibold text-cyan-300">Search visibility by design</p>
              <p class="mt-2 text-sm text-white/70">Technical SEO and local relevance from first commit.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-6">
              <p class="text-sm font-semibold text-cyan-300">Commercial outcomes first</p>
              <p class="mt-2 text-sm text-white/70">We optimise for lead quality, not vanity stats.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="live-performance-scanner" class="border-b border-white/10 bg-slate-950">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <div class="max-w-4xl">
            <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Free Site Audit</p>
            <h2 class="text-3xl font-black sm:text-4xl">How does Google see your site today?</h2>
            <p class="mt-4 text-lg text-white/75">
              Enter your URL and get a real-time performance reading with actionable improvement
              areas. This section lazy-loads on scroll so it does not slow first paint.
            </p>
          </div>
          <div class="mt-10 rounded-3xl border border-white/12 bg-slate-900/55 p-4 md:p-8">
            <SpeedScanner client:visible />
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-900">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Case Studies</p>
              <h2 class="text-3xl font-black sm:text-4xl">Proof, not promises.</h2>
            </div>
            <a href="/case-studies" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200">View all case studies</a>
          </div>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {caseStudies.map((item) => (
              <a
                href={item.href}
                class="group rounded-2xl border border-white/12 bg-slate-950/70 p-6 transition hover:border-cyan-400/50"
              >
                <p class="text-sm uppercase tracking-[0.2em] text-cyan-300/90">Case Study</p>
                <h3 class="mt-3 text-xl font-bold text-white">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white/72">{item.result}</p>
                <p class="mt-5 text-sm font-semibold text-cyan-300 group-hover:text-cyan-200">Read case study</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-950">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">How We Help</p>
          <h2 class="max-w-3xl text-3xl font-black sm:text-4xl">Three delivery tracks.</h2>
          <p class="mt-4 max-w-3xl text-white/72">
            Pick the route that fits your current commercial need. We keep delivery practical and outcome-driven.
          </p>
          <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {serviceCards.map((card) => (
              <article class="rounded-3xl border border-white/15 bg-slate-900/60 p-7">
                <h3 class="text-2xl font-bold">{card.name}</h3>
                <p class="mt-4 text-white/74">{card.blurb}</p>
                <ul class="mt-5 space-y-2 text-sm text-white/76">
                  {card.bullets.map((bullet) => (
                    <li class="flex gap-3">
                      <span class="mt-1 inline-block h-2 w-2 rounded-full bg-cyan-300"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={card.href}
                  class="mt-6 inline-flex rounded-lg border border-cyan-400/40 px-4 py-2.5 text-sm font-semibold text-cyan-300 transition hover:border-cyan-300 hover:text-cyan-200"
                >
                  {card.cta}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-900/90">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Pricing</p>
          <h2 class="max-w-3xl text-3xl font-black sm:text-4xl">Clear ranges. No hidden surprises.</h2>
          <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {pricingTiers.map((tier) => (
              <article class="rounded-2xl border border-white/12 bg-slate-950/70 p-6">
                <p class="text-xs uppercase tracking-[0.2em] text-white/60">{tier.name}</p>
                <h3 class="mt-3 text-3xl font-black text-white">{tier.price}</h3>
                <p class="mt-3 text-sm text-white/74">{tier.audience}</p>
              </article>
            ))}
          </div>
          <a
            href="/contact"
            class="mt-8 inline-flex rounded-lg bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            Get a tailored quote
          </a>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-950">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Delivery Flow</p>
          <h2 class="max-w-3xl text-3xl font-black sm:text-4xl">Built for clarity from day one.</h2>
          <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
            {processSteps.map((item) => (
              <article class="rounded-xl border border-white/12 bg-slate-900/45 p-5">
                <p class="text-xs uppercase tracking-[0.2em] text-white/50">{item.step}</p>
                <h3 class="mt-2 text-lg font-semibold">{item.title}</h3>
                <p class="mt-2 text-sm text-white/70">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-900">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8">
          <div>
            <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">Local Trust</p>
            <h2 class="text-3xl font-black sm:text-4xl">Moreton-based. Merseyside-focused.</h2>
            <p class="mt-4 text-lg leading-relaxed text-white/78">
              You are not dealing with a faceless agency. We support businesses across Wirral,
              Liverpool, Chester and Warrington with enterprise-grade delivery discipline.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              {localAreas.map((area) => (
                <a
                  href={area.href}
                  class="rounded-xl border border-white/12 bg-slate-950/60 p-4 transition hover:border-cyan-400/50"
                >
                  <h3 class="font-semibold text-white">{area.title}</h3>
                  <p class="mt-2 text-sm text-white/72">{area.text}</p>
                </a>
              ))}
            </div>
          </div>
          <div class="rounded-2xl border border-white/12 bg-slate-950/65 p-4">
            <img
              src="/kaizen-web-map-wirral-liverpool.svg"
              alt="Map of Wirral and Liverpool highlighting Kaizen Web service area"
              loading="lazy"
              decoding="async"
              width="514"
              height="363"
              class="h-full w-full rounded-xl object-cover"
            />
          </div>
        </div>
      </section>

      <section class="border-b border-white/10 bg-slate-950">
        <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
          <p class="mb-4 text-xs uppercase tracking-[0.24em] text-cyan-300">FAQ</p>
          <h2 class="text-3xl font-black sm:text-4xl">Common questions before we start.</h2>
          <div class="mt-10 space-y-4">
            {faqs.map((item) => (
              <details class="group rounded-xl border border-white/12 bg-slate-900/45 p-5">
                <summary class="cursor-pointer list-none text-lg font-semibold">
                  {item.q}
                  <span class="ml-3 inline-block text-white/45 transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-white/75">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-slate-950">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
          <div class="rounded-3xl border border-cyan-400/35 bg-gradient-to-r from-cyan-500/15 via-cyan-500/10 to-emerald-500/12 p-10">
            <p class="text-xs uppercase tracking-[0.24em] text-cyan-300">Next Step</p>
            <h2 class="mt-3 text-3xl font-black sm:text-4xl">Ready to outpace your competitors?</h2>
            <p class="mt-4 max-w-2xl text-white/82">
              Bring your current site, goals and constraints. We will give you a practical delivery
              plan with clear performance and conversion targets.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="/contact"
                class="rounded-lg bg-cyan-400 px-7 py-4 font-semibold text-slate-950 transition hover:bg-cyan-300"
              >
                Book Intro Call
              </a>
              <a
                href="/case-studies"
                class="rounded-lg border border-white/30 px-7 py-4 font-semibold transition hover:border-white/60"
              >
                View Case Studies
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/10 bg-slate-950">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 text-sm text-white/60 sm:px-6 lg:px-8 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="font-semibold text-white/80">Kaizen Web Ltd</p>
          <p class="mt-1">(c) Kaizen Web Ltd t/a Kaizen (Company No. 17007703).</p>
        </div>
