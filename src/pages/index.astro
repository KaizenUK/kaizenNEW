---
import "../../client/global.css";
import { DEFAULT_OG_IMAGE, SITE_NAME, getPageMeta } from "../../client/lib/seo";
import { BUILD_AT, BUILD_NUMBER, BUILD_SHA } from "../../client/generated/buildInfo";
import SpeedScanner from "../../client/components/SpeedScanner";

const meta = getPageMeta("/");
const canonicalUrl = "https://kaizenweb.co.uk";
const currentYear = new Date().getFullYear();
const buildLabel = BUILD_NUMBER?.trim()
  ? `Build #${BUILD_NUMBER.trim()}`
  : BUILD_SHA?.trim()
    ? `Build ${BUILD_SHA.trim().slice(0, 7)}`
    : BUILD_AT?.trim()
      ? `Built ${BUILD_AT.trim()}`
      : "";

const navLinks = [
  { href: "/web-design-wirral", label: "Web Design Wirral" },
  { href: "/web-design-liverpool", label: "Web Design Liverpool" },
  { href: "/services", label: "Services" },
  { href: "/case-studies", label: "Case Studies" },
  { href: "/performance-scanner", label: "Free Audit" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const pricingTiers = [
  {
    name: "Starter",
    audience: "Trades & Sole Traders",
    price: "From £500",
    detail: "Template setup, fast launch.",
    includes: ["Ready-made template", "Basic SEO", "Mobile responsive"],
    cta: "Get a Starter Quote",
  },
  {
    name: "Growth",
    audience: "Small Business / Marketing",
    price: "£2k – £5k",
    detail: "Custom design, lead gen focused.",
    includes: ["Custom design", "Lead capture forms", "Analytics setup"],
    cta: "Book a Growth Call",
  },
  {
    name: "Scale",
    audience: "High-Performance",
    price: "£8k – £15k",
    detail: "React/Headless, instant load.",
    includes: ["React/Headless build", "96+ Lighthouse score", "Full SEO optimisation"],
    cta: "Get a Scale Quote",
  },
  {
    name: "Enterprise",
    audience: "SaaS / Web App",
    price: "£15k+",
    detail: "Complex logic, user portals.",
    includes: ["Complex features", "User authentication", "Dedicated Product Owner"],
    cta: "Book an Enterprise Call",
  },
  {
    name: "Rescue",
    audience: "Broken Project?",
    price: "Custom Triage",
    detail: "We fix what others broke.",
    includes: ["Full project audit", "Recovery plan", "New team stabilisation"],
    cta: "Get Help Now",
  },
];

const faqs = [
  {
    q: "How quickly can you build my website?",
    a: "Most websites are delivered within 2-4 weeks depending on complexity. We focus on rapid deployment of core functionality first, then iterate based on real user feedback rather than building everything upfront.",
  },
  {
    q: "Are you based on the Wirral?",
    a: "Yes — we're based in Moreton on the Wirral, and we work with clients across the UK. We're happy to meet face-to-face for local projects.",
  },
  {
    q: "Do you provide hosting?",
    a: "We provide high-performance VPS hosting for clients on our maintenance plans. We do not use cheap shared hosting as it compromises speed and security.",
  },
  {
    q: "What makes your websites faster than competitors?",
    a: "We use modern frameworks like React and headless architecture, implement aggressive code splitting, optimize all images, use CDN delivery, and follow Google's Core Web Vitals guidelines. Most agencies still build slow WordPress sites.",
  },
  {
    q: "Can you redesign my existing website?",
    a: "Absolutely. We specialize in rescuing and rebuilding underperforming websites. We'll audit your current site, identify performance bottlenecks, and deliver a faster, conversion-optimized replacement.",
  },
  {
    q: "Do you offer SEO services?",
    a: "Yes. We focus on technical SEO fundamentals: fast page speeds, mobile optimization, structured data, and clean architecture. We don't do keyword stuffing — we build sites that Google naturally wants to rank.",
  },
  {
    q: "What happens after my website launches?",
    a: "We offer ongoing maintenance plans that include security updates, performance monitoring, content updates, and technical support. You're never locked into a contract — month-to-month only.",
  },
  {
    q: "Can I update the website myself?",
    a: "Yes. We provide an intuitive content management system (headless CMS) that lets you update text, images, and pages without touching code. We also provide training and documentation.",
  },
  {
    q: "What if I need help with my existing web developer's work?",
    a: "We offer project rescue services. If your current build is late, over budget, or stuck, we can step in to stabilize the project, fix technical issues, and get you launched.",
  },
  {
    q: "Do you work with e-commerce sites?",
    a: "Yes. We build high-performance e-commerce stores using modern platforms like Shopify Plus, headless Commerce.js, or custom React solutions. We focus on conversion optimization and fast checkout experiences.",
  },
];

const footerLinkGroups = [
  [
    { href: "/services", label: "Services" },
    { href: "/web-design-liverpool", label: "Web Design Liverpool" },
    { href: "/web-design-wirral", label: "Web Design Wirral" },
    { href: "/web-design-chester", label: "Web Design Chester" },
    { href: "/web-design-warrington", label: "Web Design Warrington" },
  ],
  [
    { href: "/services/ecommerce", label: "Ecommerce" },
    { href: "/services/local-seo", label: "Local SEO" },
    { href: "/services/wordpress-web-design", label: "WordPress Design" },
    { href: "/digital-transformation", label: "Digital Transformation" },
    { href: "/agile-coaching", label: "Agile Coaching" },
  ],
  [
    { href: "/contract-product-owner", label: "Product Owner" },
    { href: "/project-rescue", label: "Rescue" },
    { href: "/performance-scanner", label: "Speed Scanner" },
    { href: "/blog", label: "Blog" },
    { href: "/case-studies", label: "Cases" },
  ],
  [
    { href: "/about", label: "About" },
    { href: "/contact", label: "Contact" },
    { href: "/privacy-policy", label: "Privacy" },
    { href: "/cookie-policy", label: "Cookies" },
    { href: "/gdpr-policy", label: "GDPR" },
  ],
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.noIndex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={meta.image ?? DEFAULT_OG_IMAGE} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image ?? DEFAULT_OG_IMAGE} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-950 text-white antialiased selection:bg-cyan-400/30 selection:text-white">

    <!-- ============================================================ -->
    <!-- HEADER — White bg, gradient CTA, matches main branch         -->
    <!-- ============================================================ -->
    <header class="sticky top-0 z-50 w-full border-b border-gray-100 bg-white">
      <div class="mx-auto flex max-w-7xl items-center px-4 h-16 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2 text-xl font-black tracking-tight text-gray-950 hover:opacity-80 transition flex-shrink-0 mr-8">
          Kaizen
        </a>

        <nav class="hidden lg:flex items-center gap-6 flex-1 text-sm text-gray-600">
          {navLinks.map((link) => (
            <a href={link.href} class="transition hover:text-gray-900">{link.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-3 ml-auto">
          <a
            href="/performance-scanner"
            class="hidden md:flex items-center gap-2 px-4 py-2 text-sm font-medium text-cyan-600 hover:text-cyan-700 hover:bg-cyan-50 rounded-lg transition"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Free Speed Test
          </a>
          <a
            href="/contact"
            class="hidden sm:flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-600 hover:to-teal-600 shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/30 transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            Start Your Project
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          <details class="relative lg:hidden">
            <summary class="p-2 text-gray-600 hover:text-gray-900 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-64 rounded-xl border border-gray-200 bg-white p-4 shadow-xl z-50">
              <nav class="flex flex-col gap-1">
                {navLinks.map((link) => (
                  <a href={link.href} class="px-3 py-2.5 text-sm text-gray-700 hover:text-cyan-600 hover:bg-cyan-50 rounded-lg transition">{link.label}</a>
                ))}
                <a href="/contact" class="mt-2 px-3 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-cyan-500 to-teal-500 rounded-lg text-center">Start Your Project</a>
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main>

      <!-- ============================================================ -->
      <!-- 1. HERO — Mesh gradient bg, gauge on right                   -->
      <!-- ============================================================ -->
      <section class="relative isolate min-h-[100vh] flex items-start lg:items-center py-20 overflow-hidden">
        <div class="hero-mesh-bg absolute inset-0 pointer-events-none">
          <div class="hero-mesh-blob hero-mesh-blob--violet"></div>
          <div class="hero-mesh-blob hero-mesh-blob--teal"></div>
          <div class="hero-mesh-blob hero-mesh-blob--gold"></div>
        </div>
        <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.04]" aria-hidden="true">
          <defs>
            <pattern id="grid-pattern" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M 32 0 L 0 0 0 32" fill="none" stroke="white" stroke-width="1" />
            </pattern>
          </defs>
          <rect x="0" y="0" width="100%" height="100%" fill="url(#grid-pattern)" />
        </svg>
        <div class="hero-spotlight"></div>
        <div class="absolute bottom-0 left-0 w-full h-40 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none z-[2]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_15%,rgba(6,182,212,0.22),transparent_52%),radial-gradient(circle_at_90%_70%,rgba(16,185,129,0.18),transparent_54%)] pointer-events-none"></div>

        <div class="container mx-auto px-4 relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">
            <div>
              <p class="text-xs font-mono tracking-[0.25em] text-cyan-400 mb-6 uppercase">Wirral Web Design</p>
              <h1 class="text-5xl md:text-6xl lg:text-7xl font-black mb-8 leading-tight text-white">
                Sites That Actually Make You Money
              </h1>
              <p class="text-lg md:text-xl text-white/85 leading-relaxed mb-10 max-w-xl">
                Slow sites lose customers. We build fast, lean websites that turn visitors into paying leads. Enterprise-grade. No corporate nonsense.
              </p>
              <div class="flex flex-wrap gap-4">
                <a
                  href="/contact"
                  class="px-8 py-4 rounded-lg bg-white text-black font-bold text-lg inline-flex items-center justify-center gap-2 transition-all duration-200 hover:scale-105 hover:shadow-[0_0_20px_rgba(255,255,255,0.5)] active:scale-95"
                >
                  Start Your Project
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a
                  href="#pricing"
                  class="px-8 py-4 rounded-lg border-2 border-white/30 text-white font-bold text-lg inline-flex items-center justify-center gap-2 transition-all duration-200 hover:scale-105 hover:border-cyan-400 hover:text-cyan-400 hover:shadow-[0_0_20px_rgba(6,182,212,0.3)] active:scale-95"
                >
                  See Our Pricing
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </a>
              </div>
              <p class="mt-8 text-sm text-white/50">
                Trusted by Wirral trades, small shops, e-commerce brands, and SaaS teams.
              </p>
            </div>

            <div class="hidden lg:block">
              <div class="relative mx-auto max-w-[220px]">
                <svg viewBox="0 0 200 200" class="w-full h-full" aria-hidden="true">
                  <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="10" />
                  <circle
                    cx="100"
                    cy="100"
                    r="80"
                    fill="none"
                    stroke="#22c55e"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-dasharray="502.65"
                    stroke-dashoffset="20.11"
                    transform="rotate(-90 100 100)"
                  />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                  <span class="text-5xl md:text-6xl font-black text-green-400 tabular-nums">96</span>
                  <span class="text-sm text-white/70 font-medium mt-1">Performance</span>
                </div>
              </div>
              <p class="text-center mt-6 text-xs text-white/50 font-mono tracking-wider">Our Zero Bloat Score</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 2. SOCIAL MEDIA WARNING — "The Uncomfortable Truth"          -->
      <!-- ============================================================ -->
      <section class="relative z-10 bg-slate-800 text-white py-20 md:py-28 border-t border-b border-white/10">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto">
            <p class="text-xs font-mono tracking-[0.25em] text-amber-400 uppercase mb-6">The Uncomfortable Truth</p>
            <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">
              Don't Build Your Business on Rented Land
            </h2>
            <div class="space-y-6 text-lg text-white/85 leading-relaxed">
              <p>
                If your only online presence is Facebook or Instagram, you don't own anything. Algorithms change overnight. Accounts get locked without warning. Reach gets throttled unless you pay.
              </p>
              <p class="text-xl font-semibold text-white">
                A website is the only bit of the internet that's actually yours.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 3. PERFORMANCE AUDIT — SpeedScanner (only React component)   -->
      <!-- ============================================================ -->
      <section id="live-performance-scanner" class="py-20 md:py-28 bg-gradient-to-b from-slate-950 to-slate-900 text-white relative overflow-hidden">
        <div class="container mx-auto px-4 text-center">
          <p class="text-xs font-mono tracking-[0.25em] text-cyan-400 uppercase mb-4">Free Site Audit</p>
          <h2 class="text-4xl md:text-5xl font-bold mb-6">How Does Google See Your Site?</h2>
          <p class="text-lg text-white/80 max-w-2xl mx-auto">
            Enter your URL. Get a real-time audit of load speed, Core Web Vitals, and what's costing you rankings.
          </p>
        </div>
        <div class="container mx-auto px-4 mt-12">
          <div class="rounded-3xl border border-white/12 bg-slate-900/55 p-4 md:p-8">
            <SpeedScanner client:visible />
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 4. PROOF — "Here's How We Score" (light bg)                  -->
      <!-- ============================================================ -->
      <section class="py-20 md:py-32 bg-slate-50 relative overflow-hidden">
        <div class="container mx-auto px-4 text-center">
          <p class="text-xs font-mono tracking-[0.25em] text-cyan-500 uppercase mb-4">Proof, Not Promises</p>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-950">Here's How We Score.</h2>
        </div>

        <div class="container mx-auto px-4 mt-14">
          <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[auto_1fr] gap-12 items-center">
            <div class="flex flex-col items-center">
              <div class="relative w-48 h-48">
                <svg viewBox="0 0 200 200" class="w-full h-full" aria-hidden="true">
                  <circle cx="100" cy="100" r="80" fill="none" stroke="#e5e7eb" stroke-width="10" />
                  <circle
                    cx="100"
                    cy="100"
                    r="80"
                    fill="none"
                    stroke="#22c55e"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-dasharray="502.65"
                    stroke-dashoffset="20.11"
                    transform="rotate(-90 100 100)"
                  />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                  <span class="text-5xl font-black text-green-600 tabular-nums">96<span class="text-2xl">%</span></span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4">
              <div class="rounded-2xl bg-white/50 backdrop-blur-lg border border-slate-200/50 p-6 text-center">
                <p class="text-xs text-gray-500 font-mono uppercase tracking-widest mb-2">LCP</p>
                <p class="text-2xl font-bold text-gray-950">0.8s</p>
              </div>
              <div class="rounded-2xl bg-white/50 backdrop-blur-lg border border-slate-200/50 p-6 text-center">
                <p class="text-xs text-gray-500 font-mono uppercase tracking-widest mb-2">TBT</p>
                <p class="text-2xl font-bold text-gray-950">0ms</p>
              </div>
              <div class="rounded-2xl bg-white/50 backdrop-blur-lg border border-slate-200/50 p-6 text-center">
                <p class="text-xs text-gray-500 font-mono uppercase tracking-widest mb-2">CLS</p>
                <p class="text-2xl font-bold text-gray-950">0.01</p>
              </div>
            </div>
          </div>

          <div class="max-w-3xl mx-auto mt-12 text-center">
            <p class="text-gray-600 text-lg leading-relaxed">
              Core Web Vitals are how Google measures whether your site is any good. Load speed, responsiveness, visual stability — if these are poor, Google pushes you down the results. We hit 96% on our own site. We build yours to the same standard.
            </p>
            <a
              href="https://gtmetrix.com/reports/kaizenweb.co.uk/e2VJJsxv/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-cyan-500/50 text-cyan-600 font-bold transition-all duration-300 hover:scale-105 hover:border-cyan-500 hover:bg-cyan-50"
            >
              View Full Report
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 5. CREDIBILITY — "Big-Tech Discipline. Wirral Postcode."     -->
      <!-- ============================================================ -->
      <section class="py-20 md:py-28 bg-slate-950 text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_10%_0,rgba(56,189,248,0.20),transparent_55%),radial-gradient(circle_at_100%_90%,rgba(34,197,94,0.16),transparent_60%)] pointer-events-none"></div>
        <div class="container mx-auto px-4 relative z-10">
          <div class="max-w-4xl">
            <p class="text-xs font-mono tracking-[0.25em] text-cyan-300 uppercase mb-4">Why Us</p>
            <h2 class="text-4xl md:text-5xl font-black leading-tight mb-8">
              Big-Tech Discipline. Wirral Postcode.
            </h2>
            <p class="text-lg text-white/80 leading-relaxed mb-10 max-w-3xl">
              We spent years building systems for global companies. Now we use that same rigour for local businesses. You get senior-level ownership from day one — no juniors learning on your project, no vanishing act after the deposit clears.
            </p>

            <ul class="space-y-4 mb-10">
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-cyan-300 flex-shrink-0"></span>
                <span class="text-white/85">Performance budgets agreed before we write a line of code</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-cyan-300 flex-shrink-0"></span>
                <span class="text-white/85">Staging, QA, and safe rollbacks on every project</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-cyan-300 flex-shrink-0"></span>
                <span class="text-white/85">One senior dev owns your build start to finish</span>
              </li>
            </ul>

            <div class="flex flex-wrap gap-4">
              <a
                href="/case-studies/helen-moore-hairdressing"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-white/15 bg-white/5 text-white font-semibold hover:bg-white/10 transition"
              >
                See proof in a case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </a>
              <a
                href="#live-performance-scanner"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-r from-green-400 to-emerald-500 text-gray-950 font-bold hover:scale-105 hover:shadow-[0_0_20px_rgba(34,197,94,0.5)] transition-all"
              >
                Get a Performance Audit
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 6. SERVICE SHOWCASE — Two cards: Web Design + Project Rescue  -->
      <!-- ============================================================ -->
      <section class="py-20 md:py-28 bg-slate-950 text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_0_0,rgba(45,212,191,0.18),transparent_55%),radial-gradient(circle_at_100%_100%,rgba(56,189,248,0.18),transparent_55%)] pointer-events-none"></div>
        <div class="container mx-auto px-4 relative z-10">
          <p class="text-xs font-mono tracking-[0.25em] text-cyan-300 uppercase mb-4">What We Do</p>
          <h2 class="text-4xl md:text-5xl font-black mb-12">Two ways we help</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 items-stretch">
            <!-- Web Design Card -->
