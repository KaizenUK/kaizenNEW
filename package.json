{
  "name": "fusion-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run clean:caches && node scripts/dev.mjs",
    "dev:clean": "pnpm run dev",
    "build": "pnpm run build:site && pnpm run build:studio && pnpm run build:stage:studio",
    "build:site": "rimraf dist .astro && cross-env NODE_OPTIONS='--max-old-space-size=6144' astro build && node scripts/generate-nginx-redirects.mjs",
    "build:studio": "pnpm --dir apps/studio build",
    "build:stage:studio": "node scripts/stage-studio-build.mjs",
    "build:snap:high-five": "astro build",
    "build:snap:all": "astro build",
    "start": "astro preview",
    "test": "vitest --run --config vitest.config.ts",
    "test:builder:browser": "playwright test --config playwright.builder.config.ts",
    "clean:caches": "node -e \"const fs=require('node:fs'); for (const p of ['.vite','node_modules/.vite','.astro']) { try { fs.rmSync(p,{ recursive: true, force: true }); } catch {} }\"",
    "format.fix": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "trace:summary": "node scripts/trace-summary.mjs",
    "sync:seo:sanity": "node scripts/sync-seo-to-sanity.mjs",
    "supabase:editor:secrets": "bash scripts/supabase/set-editor-secrets.sh",
    "supabase:editor:deploy": "bash scripts/supabase/deploy-editor-functions.sh",
    "supabase:editor:smoke": "bash scripts/supabase/smoke-editor-api.sh"
  },
