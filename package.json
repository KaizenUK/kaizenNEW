    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.13.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tsparticles/engine": "^3.9.1",
    "clean": "^4.0.2",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "gsap": "^3.14.2",
    "jspdf": "^4.2.0",
    "prismjs": "^1.30.0",
    "react-devtools": "^7.0.1",
    "react-ga4": "^2.1.0",
