# Server-only file: install outside the checkout as /etc/kaizen/client-worker.env.
# Replace every placeholder. Never commit the real credential.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BUILDER_RELEASE_SERVICE_ROLE_KEY=REPLACE_PRIVATELY
BUILDER_CLIENT_WORKER_ID=clients-vps-1
BUILDER_CLIENT_DESTINATIONS_FILE=/etc/kaizen/client-destinations.json
# Use a dedicated child directory if /var/lib/kaizen-client-worker is the user's home.
BUILDER_CLIENT_WORK_DIRECTORY=/var/lib/kaizen-client-worker/jobs
# Retained client releases. New retirement is off by default; an attempt that
# was already started is still finished after this is set back to 0.
BUILDER_RELEASE_RETENTION_ENABLED=0
BUILDER_RELEASE_KEEP_COUNT=5
BUILDER_RELEASE_MIN_AGE_DAYS=30
BUILDER_RELEASE_VISITOR_GRACE_DAYS=7
# Minutes between full retention inspections, after queued publications.
BUILDER_RELEASE_MAINTENANCE_INTERVAL_MINUTES=60
# Shared disk admission for services writing to the same filesystem. Leave
# empty for per-service monitoring only. When set, every service on that
# filesystem must use the same directory: owned by a shared group (for example
# kaizen-storage), mode 2770, with each unit granted SupplementaryGroups.
KAIZEN_STORAGE_ADMISSION_DIRECTORY=
# Largest open-ended reservation one build or command may hold (4 GiB).
KAIZEN_STORAGE_RESERVATION_MAX_BYTES=4294967296
