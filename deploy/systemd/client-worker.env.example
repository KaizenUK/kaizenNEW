# Server-only file: install outside the checkout as /etc/kaizen/client-worker.env.
# Replace every placeholder. Never commit the real credential.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BUILDER_RELEASE_SERVICE_ROLE_KEY=REPLACE_PRIVATELY
BUILDER_CLIENT_WORKER_ID=clients-vps-1
BUILDER_CLIENT_DESTINATIONS_FILE=/etc/kaizen/client-destinations.json
# Use a dedicated child directory if /var/lib/kaizen-client-worker is the user's home.
BUILDER_CLIENT_WORK_DIRECTORY=/var/lib/kaizen-client-worker/jobs
