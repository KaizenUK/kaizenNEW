# Private release-worker settings. Install separate reviewed files outside the
# checkout as /etc/kaizen/production.env and /etc/kaizen/staging.env.
# Root owns the files; only the deployment service account may read them.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BUILDER_RELEASE_SERVICE_ROLE_KEY=REPLACE_PRIVATELY
# Fixed database project receiving usage; never take this from website content.
BUILDER_RELEASE_PROJECT_ID=kaizen
# Activate together with the native deployment service and complete root inventory.
# Each destination has a distinct worker/state directory and a stable service unit.
# BUILDER_NATIVE_WORKER_ID=kaizen-production-release
# BUILDER_NATIVE_CONFIGURATION=sha256_of_the_complete_operator_native_inventory
# BUILDER_NATIVE_STATE_DIRECTORY=/var/lib/kaizen-native/production
# BUILDER_NATIVE_PACKAGE_MANAGER=/opt/kaizen-runtime/pnpm-10.32.1/bin/pnpm.cjs
# Combined retained checkout and worker-state allowance, including installed
# dependencies, package store, candidate Git history, caches and recovery files.
# Checks are operational bounds for trusted native commands; package code may
# grow between samples. Separate release-store retention is configured at rollout.
# BUILDER_NATIVE_STORAGE_MAX_BYTES=8589934592
# BUILDER_NATIVE_MIN_FREE_BYTES=2147483648
# BUILDER_NATIVE_DISK_CHECK_MS=2000
# Prune the worker-owned pnpm cache above this trigger, or before a storage
# refusal. Referenced packages stay usable; the combined storage allowance
# still applies after pruning. Unknown/unowned cache files remain counted.
# BUILDER_NATIVE_CACHE_PRUNE_BYTES=2147483648
# Separate retained release-store bounds. Staging and asset installation share
# the activation lock; existing/partial/unknown files remain counted. Rollback
# using already installed assets remains possible without new bulk storage.
# BUILDER_RELEASE_STORAGE_MAX_BYTES=8589934592
# BUILDER_RELEASE_IMMUTABLE_MAX_BYTES=4294967296
# BUILDER_RELEASE_MIN_FREE_BYTES=2147483648
# Enable with the complete native inventory and migration 019 at rollout.
# New retirements stay off by default; an existing owned attempt still recovers.
# BUILDER_RELEASE_RETENTION_ENABLED=0
# Retention eligibility. Keep the newest
# releases plus serving/recovery/queued targets. File changes and activation use
# restart the minimum-age window; visitor grace also protects recent transitions.
# BUILDER_RELEASE_KEEP_COUNT=5
# BUILDER_RELEASE_MIN_AGE_DAYS=30
# BUILDER_RELEASE_VISITOR_GRACE_DAYS=7
# Maintenance uses the same fixed service identity and build.lock as deployment:
# sudo /usr/local/sbin/kaizen-public-deploy --branch main --mode maintain
# It repairs existing checkout/retirement work without a new commit or build.
# Enable only for the original site's managed publication queue. Staging and
# ordinary repository releases still require the service key and project above.
VITE_BUILDER_CLOUD=0
# The workflow provides KAIZEN_DEPLOY_BRANCH (main or stage), release ID, commit,
# store and hostname. Preserve each destination's existing private build settings.
# Shared disk admission for services writing to the same filesystem. Leave
# empty for per-service monitoring only. When set, every service on that
# filesystem must use the same directory: owned by a shared group (for example
# kaizen-storage), mode 2770, with each unit granted SupplementaryGroups.
KAIZEN_STORAGE_ADMISSION_DIRECTORY=
# Largest open-ended reservation one build or command may hold (4 GiB).
KAIZEN_STORAGE_RESERVATION_MAX_BYTES=4294967296
