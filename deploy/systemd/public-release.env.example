# Private release-worker settings. Install separate reviewed files outside the
# checkout as /etc/kaizen/production.env and /etc/kaizen/staging.env.
# Root owns the files; only the deployment service account may read them.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BUILDER_RELEASE_SERVICE_ROLE_KEY=REPLACE_PRIVATELY
# Fixed database project receiving usage; never take this from website content.
BUILDER_RELEASE_PROJECT_ID=kaizen
# Enable only for the original site's managed publication queue. Staging and
# ordinary repository releases still require the service key and project above.
VITE_BUILDER_CLOUD=0
# The workflow provides KAIZEN_DEPLOY_BRANCH (main or stage), release ID, commit,
# store and hostname. Preserve each destination's existing private build settings.
