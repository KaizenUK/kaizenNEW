# Server-only configuration for /etc/kaizen-helper/helper.env (root:kaizen-helper, 0640).
# Project deploy keys are separate files. Hosted builds receive public settings only.
BUILDER_HOSTED_PROJECTS_FILE=/etc/kaizen-helper/projects.json
BUILDER_HOSTED_WORK_DIRECTORY=/var/lib/kaizen-helper/work
BUILDER_HOSTED_CREDENTIALS_DIRECTORY=/etc/kaizen-helper/credentials
BUILDER_HOSTED_SUPABASE_URL=https://your-project.supabase.co
BUILDER_HOSTED_SUPABASE_ANON_KEY=your-public-anon-key
BUILDER_HOSTED_PORT=4334
BUILDER_HOSTED_EDITOR_ORIGIN=https://builder.example
ALLOWED_STUDIO_ORIGINS=https://builder.example
BUILDER_HOSTED_PROJECT_MAX_BYTES=8589934592
BUILDER_HOSTED_MIN_FREE_BYTES=2147483648
BUILDER_HOSTED_DISK_CHECK_MS=2000
