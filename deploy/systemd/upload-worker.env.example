# Install the real file root-owned 0600 at /etc/kaizen/upload-worker.env.
# These values belong only to the upload service process.
BUILDER_UPLOAD_SUPABASE_URL=https://your-project.supabase.co
BUILDER_UPLOAD_ANON_KEY=replace-with-project-public-key
BUILDER_UPLOAD_SERVICE_KEY=replace-with-server-service-key
BUILDER_UPLOAD_WORKER_ID=kaizen-uploads
BUILDER_UPLOAD_DIRECTORY=/var/lib/kaizen-uploads/spool
BUILDER_UPLOAD_PORT=4336
BUILDER_UPLOAD_MAX_BYTES=2147483648
BUILDER_UPLOAD_MAX_FILES=1024
BUILDER_UPLOAD_MIN_FREE_BYTES=2147483648
ALLOWED_STUDIO_ORIGINS=https://kaizenweb.co.uk,https://www.kaizenweb.co.uk
