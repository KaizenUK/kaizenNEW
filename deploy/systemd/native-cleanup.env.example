# Install root-owned 0600 at /etc/kaizen/native-cleanup.env.
# Keep the timer disabled until the complete inventory and all producers match.
BUILDER_NATIVE_CLEANUP_SUPABASE_URL=https://your-project.supabase.co
BUILDER_NATIVE_CLEANUP_SERVICE_KEY=replace-with-server-service-key
BUILDER_NATIVE_CLEANUP_INVENTORY=/etc/kaizen/native-cleanup.json
BUILDER_NATIVE_CLEANUP_DIRECTORY=/var/lib/kaizen-native-cleanup/spool
BUILDER_NATIVE_CLEANUP_MAX_BYTES=67108864
BUILDER_NATIVE_CLEANUP_MAX_FILES=1024
BUILDER_NATIVE_CLEANUP_MIN_FREE_BYTES=2147483648
