# Public Sanity values (used by Astro pages and embedded Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production

# Base URL used by SEO tools (local default is http://localhost:4321)
PUBLIC_SITE_URL=https://kaizenweb.co.uk

# Server-only token used by @sanity/client for authenticated fetches when needed
SANITY_API_TOKEN=your_sanity_token

# Server-only GitHub dispatch credentials (used by /api/deploy for Studio publish+deploy)
GITHUB_DEPLOY_TOKEN=your_github_pat_with_repo_scope
GITHUB_DEPLOY_REPO=YOUR_ORG/KaizenNEW
GITHUB_DEPLOY_EVENT_TYPE=sanity-update
