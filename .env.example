# Public Sanity values (used by Astro pages and embedded Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production

# Base URL used by SEO tools (local default is http://localhost:4321)
PUBLIC_SITE_URL=https://kaizenweb.co.uk

# Server-only token used by @sanity/client for authenticated fetches when needed
SANITY_API_TOKEN=your_sanity_token

# Server-only GitHub dispatch credentials (used by /api/deploy for Studio publish+deploy)
GITHUB_DEPLOY_TOKEN=your_github_pat_with_repo_scope
GITHUB_DEPLOY_REPO=YOUR_ORG/KaizenNEW
GITHUB_DEPLOY_EVENT_TYPE=sanity-update
GITHUB_DEPLOY_TARGET=stage

# Google service account credentials for Studio SEO dashboard (/api/seo/stats)
GCP_PROJECT_ID=your_gcp_project_id
GCP_CLIENT_EMAIL=your_service_account_email
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional multi-site SEO configuration for Search Console + GA4
# JSON array format:
# [
#   {"id":"kaizenweb","label":"Kaizen Web","gscSiteUrl":"https://kaizenweb.co.uk/","ga4PropertyId":"123456789"},
#   {"id":"ascollections","label":"AS Collections","gscSiteUrl":"https://ascollections.co.uk/","ga4PropertyId":"234567890"},
#   {"id":"midlandoilgroup","label":"Midland Oil Group","gscSiteUrl":"https://midlandoilgroup.co.uk/","ga4PropertyId":"345678901"}
# ]
SEO_SITES_JSON=[]

# Single-site fallback if SEO_SITES_JSON is not used
GSC_SITE_URL=https://kaizenweb.co.uk/
GA4_PROPERTY_ID=
