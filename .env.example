# Public site origins
PUBLIC_SITE_URL=https://kaizenweb.co.uk
PUBLIC_STUDIO_URL=https://studio.kaizenweb.co.uk

# Sanity content (Astro + edge functions)
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_token

# Browser Supabase client (contact form + scanner writes)
VITE_SUPABASE_URL=https://kbqraygsegcclzhsmpvz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Studio + preview/deploy backend integration
# Default Supabase Functions origin (no custom api.* domain required)
VITE_EDITOR_API_ORIGIN=https://kbqraygsegcclzhsmpvz.functions.supabase.co
VITE_PUBLIC_SITE_ORIGIN=https://kaizenweb.co.uk
VITE_STUDIO_ORIGIN=https://studio.kaizenweb.co.uk
VITE_EDITOR_COOKIE_DOMAIN=.kaizenweb.co.uk
ALLOWED_STUDIO_ORIGINS=https://studio.kaizenweb.co.uk

# GitHub repository dispatch (used by supabase/functions/deploy)
GITHUB_DEPLOY_TOKEN=your_github_pat_with_repo_scope
GITHUB_DEPLOY_REPO=YOUR_ORG/KaizenNEW
GITHUB_DEPLOY_EVENT_TYPE=sanity-update
GITHUB_DEPLOY_TARGET=main
