# Public site origins
PUBLIC_SITE_URL=https://kaizenweb.co.uk
PUBLIC_STUDIO_URL=https://kaizenweb.co.uk/studio

# Sanity content (Astro + edge functions)
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_token

# Browser Supabase client (contact form + scanner writes)
VITE_SUPABASE_URL=https://kbqraygsegcclzhsmpvz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Studio + preview/deploy backend integration
# Use a first-party origin so editor auth cookies can be sent.
VITE_EDITOR_API_ORIGIN=https://kaizenweb.co.uk/editor-api
VITE_PUBLIC_SITE_ORIGIN=https://kaizenweb.co.uk
VITE_STUDIO_ORIGIN=https://kaizenweb.co.uk
VITE_EDITOR_COOKIE_DOMAIN=.kaizenweb.co.uk
ALLOWED_STUDIO_ORIGINS=https://kaizenweb.co.uk,http://localhost:3333
# Server-only allowlists: supply to the helper process / Supabase functions.
# Configured values replace the defaults.
# Public-site/Studio URL settings do not grant browser access.
BUILDER_COMPANION_ORIGINS=https://kaizenweb.co.uk
BUILDER_CONTACT_ORIGINS=https://kaizenweb.co.uk,https://www.kaizenweb.co.uk

# GitHub repository dispatch (used by supabase/functions/deploy)
GITHUB_DEPLOY_TOKEN=your_github_pat_with_repo_scope
GITHUB_DEPLOY_REPO=YOUR_ORG/KaizenNEW
GITHUB_DEPLOY_EVENT_TYPE=sanity-update
GITHUB_DEPLOY_TARGET=main

# Visual builder (enable after applying the builder migration)
# VITE_BUILDER_CLOUD=1
# Optional public contact receiver override; defaults to VITE_SUPABASE_URL/functions/v1/builder-contact.
# VITE_BUILDER_FORM_ENDPOINT=https://your-project.supabase.co/functions/v1/builder-contact
# BUILDER_LOCAL_BUILD=1  # Explicitly include local published pages in a test build only
# Verified publishing: apply migration 202609100008 with the updated edge function and VPS worker.
# Set BUILDER_RELEASE_COORDINATOR=1 in Supabase function secrets after the release-store setup.
# Set the following only in the VPS checkout's private .env (never prefix it with VITE_):
# BUILDER_RELEASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key
# Production and staging need separate Supabase builder workspaces and release stores.
# Private saved previews require migration 202609100009_builder_previews.sql.
# They use existing editor authentication; preview URLs do not grant anonymous access.
